---
import "../styles/global.css";
import SessionAccess from "../components/SessionAccess.astro";

interface Props {
  title: string;
  description?: string;
  fromLanding?: boolean;
}

const {
  title,
  description = "StudentHUB — Consulta de materias, horarios, docentes y aulas en la Universidad de Colima.",
  fromLanding: fromLandingProp,
} = Astro.props;

const isFromLanding = fromLandingProp ?? (Astro.url.searchParams.get("from") === "landing");
const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";

function isActive(path: string): boolean {
  if (path === "/studenthub") return pathname === "/" || pathname === "/studenthub";
  if (path === "/") return false;
  return pathname === path || pathname.startsWith(`${path}/`);
}

const student = Astro.locals.student;
const cookieGroup = Astro.cookies.get("pica_selected_group")?.value;
const activeGroupSlug = Astro.url.searchParams.get("group") || cookieGroup || student?.class_group_slug;
const groupQuery = activeGroupSlug ? `?${new URLSearchParams({ group: activeGroupSlug })}` : "";
const source = isFromLanding ? "landing" : "studenthub";
const academicLinks = [
  { path: "/studenthub", href: "/studenthub", label: "Horario" },
  { path: "/materias", href: `/materias${groupQuery}`, label: "Materias" },
  { path: "/profesores", href: `/profesores?from=${source}`, label: "Profesores" },
  { path: "/mapa", href: `/mapa?from=${source}`, label: "Mapa" },
  { path: "/fechas", href: `/fechas${groupQuery}`, label: "Fechas de evaluación" },
  { path: "/aplicaciones", href: "/aplicaciones", label: "Aplicaciones" },
];
const homeLink = { path: "/", href: "/", label: "Inicio" };
const desktopLinks = isFromLanding
  ? [
      { ...academicLinks[0], label: "StudentHUB" },
      ...academicLinks.filter(({ path }) => ["/profesores", "/mapa", "/aplicaciones"].includes(path)),
    ]
  : [homeLink, ...academicLinks];
const moreIsActive = academicLinks.slice(4).some(({ path }) => isActive(path));
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | {isFromLanding ? "FIMEBot" : "StudentHUB"}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={`${title} | ${isFromLanding ? "FIMEBot" : "StudentHUB"}`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href="/vectors/logos/prisma/sara_app_icon_prisma_claro.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&family=Manrope:wght@500;600;700;800;900&family=JetBrains+Mono:wght@400;600;700&display=swap" />
  </head>

  <body>
    <a class="skip-link" href="#main-content">Saltar al contenido</a>
    <!-- Banda refractiva del prisma SARA & UCOL -->
    <div class="institutional-stripe" aria-hidden="true"></div>

    <header class="site-header" id="site-header">
      <div class="header-inner">
        <a
          href={isFromLanding ? "/" : "/studenthub"}
          class="wordmark"
          aria-label={isFromLanding ? "FIMEBot — Inicio" : "StudentHUB — Inicio"}
        >
          <div class="wordmark__brand-group">
            <img src="/vectors/logos/prisma/sara_isotipo_prisma_claro.svg" alt="" class="wordmark__logo" width="32" height="22" aria-hidden="true" />
            <div class="wordmark__text">
              <span class="wordmark__overline">Universidad de Colima · FIME</span>
              <span class="wordmark__title">
                {isFromLanding ? <>FIME<em>Bot</em></> : <>Student<em>HUB</em></>}
              </span>
            </div>
          </div>
          <span class="wordmark__badge">Ecosistema SARA</span>
        </a>

        <nav class="desktop-navigation" aria-label="Navegación principal">
          <ul class="nav-list" role="list">
            {desktopLinks.map((item) => (
              <li>
                <a
                  href={item.href}
                  class:list={["nav-link", { active: isActive(item.path) }]}
                  aria-current={isActive(item.path) ? "page" : undefined}
                >
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>

        {isFromLanding ? (
          <a href="/#fimebot-chat" class="btn-header-chat">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" aria-hidden="true">
              <path d="M4 12C4 7.58 7.58 4 12 4C16.42 4 20 7.58 20 12C20 16.42 16.42 20 12 20H5.5C4.67 20 4 19.33 4 18.5V12Z" fill="currentColor" fill-opacity="0.16" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round"/>
              <path d="M12 8L13.1 10.9L16 12L13.1 13.1L12 16L10.9 13.1L8 12L10.9 10.9L12 8Z" fill="#FF7659" stroke="#FF7659" stroke-width="1.1" stroke-linejoin="round"/>
            </svg>
            FimeBot
          </a>
        ) : (
          <a href="/studenthub?select_group=true" class="btn-change-group-header">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M7 16V4m0 0L3 8m4-4l4 4m6 4v12m0 0l4-4m-4 4l-4-4"/>
            </svg>
            Cambiar Grupo
          </a>
        )}
      </div>
      <SessionAccess />
    </header>

    <main id="main-content" tabindex="-1">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-inner">
        <div class="footer-brand">
          <img src="/vectors/logos/prisma/sara_isotipo_prisma_claro.svg" alt="" width="22" height="15" aria-hidden="true" />
          <span>FIME · Universidad de Colima</span>
        </div>
        <span>Ecosistema Digital Académico SARA v0.5.0 · StudentHUB</span>
      </div>
    </footer>

    <!-- Navegación móvil con Glass OS Dock -->
    <nav class="mobile-nav" aria-label="Navegación móvil">
      {academicLinks.slice(0, 4).map((item) => (
        <a
          href={item.href}
          class:list={["mobile-nav__item", { "mobile-nav__item--active": isActive(item.path) }]}
          aria-current={isActive(item.path) ? "page" : undefined}
        >
          <span class="mobile-nav__dot" aria-hidden="true"></span>
          <span class="mobile-nav__label">{item.label}</span>
        </a>
      ))}
      <button
        type="button"
        id="btn-more"
        class:list={["mobile-nav__item", { "mobile-nav__item--active": moreIsActive }]}
        aria-label="Más opciones de navegación"
        aria-haspopup="dialog"
        aria-controls="mobile-drawer"
        aria-expanded="false"
      >
        <span class="mobile-nav__dot" aria-hidden="true"></span>
        <span class="mobile-nav__label">Más</span>
      </button>
    </nav>

    <!-- Drawer Móvil Glass OS -->
    <dialog id="mobile-drawer" aria-labelledby="drawer-title">
      <div class="drawer-heading">
        <div style="display: flex; align-items: center; gap: 8px;">
          <img src="/vectors/logos/prisma/sara_isotipo_prisma_claro.svg" alt="" width="20" height="14" aria-hidden="true" />
          <h2 id="drawer-title">Menú académico FIME</h2>
        </div>
        <button type="button" id="btn-close-drawer" aria-label="Cerrar menú">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>
      <nav class="drawer-navigation" aria-label="Todas las secciones">
        {[homeLink, ...academicLinks].map((item) => (
          <a href={item.href} aria-current={isActive(item.path) ? "page" : undefined}>
            {item.label}
          </a>
        ))}
        <a href="/studenthub?select_group=true" style="color: var(--sara-sapphire-600); font-weight: 700;">
          Cambiar grupo
        </a>
      </nav>
    </dialog>
    <noscript>
      <nav class="no-script-navigation" aria-label="Más secciones">
        <a href="/">Inicio</a>
        <a href={`/fechas${groupQuery}`}>Fechas de evaluación</a>
        <a href="/aplicaciones">Aplicaciones</a>
        <a href="/studenthub?select_group=true">Cambiar grupo</a>
      </nav>
      <style>#btn-more { display: none; }</style>
    </noscript>

    <script>
      function setupMobileNav() {
        const btnMore = document.querySelector<HTMLButtonElement>("#btn-more");
        const drawer = document.querySelector<HTMLDialogElement>("#mobile-drawer");
        const btnClose = document.querySelector<HTMLButtonElement>("#btn-close-drawer");
        if (!btnMore || !drawer || !btnClose || drawer.dataset.initialized) return;
        drawer.dataset.initialized = "true";

        const controller = new AbortController();
        const options = { signal: controller.signal };
        const desktopViewport = window.matchMedia("(min-width: 1200px)");
        let previousOverflow = "";
        let returnFocus: HTMLElement | null = null;

        function closeDrawer() {
          if (drawer?.open) drawer.close();
        }

        btnMore.addEventListener("click", () => {
          if (drawer.open) return;
          returnFocus = document.activeElement instanceof HTMLElement ? document.activeElement : btnMore;
          previousOverflow = document.body.style.overflow;
          drawer.showModal();
          document.body.style.overflow = "hidden";
          btnMore.setAttribute("aria-expanded", "true");
          btnClose.focus();
        }, options);

        btnClose.addEventListener("click", closeDrawer, options);
        drawer.addEventListener("close", () => {
          btnMore.setAttribute("aria-expanded", "false");
          document.body.style.overflow = previousOverflow;
          if (returnFocus?.isConnected && !desktopViewport.matches) returnFocus.focus();
        }, options);
        drawer.addEventListener("click", (event) => {
          if (event.target !== drawer) return;
          const bounds = drawer.getBoundingClientRect();
          if (event.clientX < bounds.left || event.clientX > bounds.right ||
              event.clientY < bounds.top || event.clientY > bounds.bottom) closeDrawer();
        }, options);
        desktopViewport.addEventListener("change", (event) => {
          if (event.matches) closeDrawer();
        }, options);
        document.addEventListener("astro:before-swap", () => {
          if (drawer.open) {
            document.body.style.overflow = previousOverflow;
            drawer.close();
          }
          controller.abort();
        }, { once: true, signal: controller.signal });
      }

      setupMobileNav();
      document.addEventListener("astro:page-load", setupMobileNav);
    </script>
  </body>
</html>

<style>
  .institutional-stripe {
    height: 4px;
    background: linear-gradient(90deg, #1A367A 0%, #159AB3 35%, #0E6B47 65%, #E65642 100%);
  }
  .site-header {
    position: sticky;
    top: 0;
    z-index: 30;
    background: var(--sara-glass-dock, rgba(255, 255, 255, 0.82));
    backdrop-filter: blur(25px) saturate(160%);
    -webkit-backdrop-filter: blur(25px) saturate(160%);
    border-bottom: 1px solid var(--sara-border-glass, rgba(26, 54, 122, 0.1));
    box-shadow: inset 0 -1px 1px 0 var(--sara-rim-specular), var(--sara-shadow-glass-sm);
  }
  .header-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 24px;
    min-height: 64px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }
  .wordmark {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    flex-shrink: 0;
    min-height: 44px;
  }
  .wordmark__brand-group {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .wordmark__logo {
    display: block;
    width: 32px;
    height: 22px;
    object-fit: contain;
    flex-shrink: 0;
  }
  .wordmark__text {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .wordmark__overline {
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--sara-text-secondary, #475569);
    line-height: 1.1;
  }
  .wordmark__title {
    font-family: var(--sara-font-display, "Manrope", sans-serif);
    font-size: 1.25rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--sara-text-primary, #141824);
    line-height: 1;
  }
  .wordmark__title em {
    font-style: normal;
    background: linear-gradient(135deg, var(--sara-cyan-600, #159AB3), var(--sara-sapphire-600, #224FA8));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .wordmark__badge {
    display: inline-flex;
    align-items: center;
    font-family: var(--sara-font-mono, monospace);
    font-size: 0.5625rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 3px 7px;
    border-radius: var(--sara-radius-pill, 9999px);
    background: var(--sara-sapphire-100, rgba(224, 235, 255, 0.7));
    border: 1px solid var(--sara-border-glass, rgba(26, 54, 122, 0.1));
    color: var(--sara-sapphire-700, #1A367A);
    white-space: nowrap;
  }
  .desktop-navigation {
    flex: 1;
    margin-left: 12px;
  }
  .nav-list {
    display: flex;
    align-items: center;
    gap: 18px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .btn-header-chat, .btn-change-group-header {
    min-height: 44px;
    padding: 0 16px;
    border-radius: var(--sara-radius-md, 12px);
    text-decoration: none;
    font-size: 0.75rem;
    font-weight: 700;
    font-family: var(--font-sans);
    letter-spacing: 0.04em;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    white-space: nowrap;
    transition: all 150ms ease;
  }
  .btn-header-chat {
    background: linear-gradient(135deg, var(--sara-sapphire-700, #1A367A), var(--sara-sapphire-600, #224FA8));
    color: #FFFFFF;
    border: 1px solid var(--sara-border-glass, rgba(255, 255, 255, 0.2));
    box-shadow: inset 0 1px 1px 0 var(--sara-rim-specular), var(--sara-shadow-glass-sm);
  }
  .btn-header-chat:hover {
    background: linear-gradient(135deg, var(--sara-sapphire-600, #224FA8), var(--sara-cyan-600, #159AB3));
    transform: translateY(-1px);
    box-shadow: inset 0 1px 1px 0 var(--sara-rim-specular), var(--sara-shadow-glass-md);
  }
  .btn-change-group-header {
    background: var(--sara-glass-strong, rgba(255, 255, 255, 0.88));
    backdrop-filter: blur(16px);
    color: var(--sara-sapphire-700, #1A367A);
    border: 1px solid var(--sara-border-glass, rgba(26, 54, 122, 0.12));
    box-shadow: inset 0 1px 1px 0 var(--sara-rim-specular), var(--sara-shadow-glass-sm);
  }
  .btn-change-group-header:hover {
    background: var(--color-surface, #FFFFFF);
    color: var(--sara-cyan-600, #159AB3);
    border-color: var(--sara-cyan-500, #1CB3CF);
    transform: translateY(-1px);
  }
  #main-content {
    max-width: 1280px;
    margin: 0 auto;
    padding: 40px 24px 80px;
    min-height: calc(100vh - 120px);
  }
  .site-footer {
    border-top: 1px solid var(--sara-border-glass, rgba(26, 54, 122, 0.1));
    background: var(--sara-glass-dock, rgba(255, 255, 255, 0.82));
    backdrop-filter: blur(20px);
    box-shadow: inset 0 1px 1px 0 var(--sara-rim-specular);
    padding: 20px 24px;
  }
  .footer-inner {
    max-width: 1280px;
    margin: 0 auto;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 8px 24px;
    font-size: 0.6875rem;
    color: var(--sara-text-secondary, #475569);
  }
  .footer-brand {
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--sara-text-primary, #141824);
  }
  .mobile-nav {
    display: none;
  }
  .mobile-nav__item {
    flex: 1 1 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    min-height: 52px;
    text-decoration: none;
    color: var(--sara-text-secondary, #475569);
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px 2px;
    transition: color var(--duration);
  }
  .mobile-nav__item--active {
    color: var(--sara-sapphire-600, #224FA8);
  }
  .mobile-nav__item:hover {
    color: var(--sara-cyan-600, #159AB3);
  }
  .mobile-nav__dot {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: currentColor;
    opacity: 0.3;
  }
  .mobile-nav__item--active .mobile-nav__dot {
    opacity: 1;
    background: var(--sara-cyan-500, #1CB3CF);
    box-shadow: 0 0 8px var(--sara-cyan-400);
  }
  .mobile-nav__label {
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    line-height: 1.3;
  }
  #mobile-drawer {
    position: fixed;
    inset: auto 0 0;
    width: 100%;
    max-width: none;
    max-height: 85dvh;
    margin: 0;
    padding: 20px 24px max(24px, env(safe-area-inset-bottom));
    overflow-y: auto;
    overscroll-behavior: contain;
    border: 0;
    border-top: 1px solid var(--sara-border-glass, rgba(26, 54, 122, 0.12));
    border-radius: 20px 20px 0 0;
    background: var(--sara-glass-strong, rgba(255, 255, 255, 0.95));
    backdrop-filter: blur(25px);
    -webkit-backdrop-filter: blur(25px);
    box-shadow: inset 0 1px 1px 0 var(--sara-rim-specular), var(--sara-shadow-glass-lg);
    color: var(--color-ink);
  }
  #mobile-drawer::backdrop {
    background: rgba(10, 19, 41, 0.5);
    backdrop-filter: blur(4px);
  }
  .drawer-heading {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    margin-bottom: 12px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--sara-border-subtle);
  }
  .drawer-heading h2 {
    font-family: var(--font-display);
    font-size: 0.8125rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--sara-sapphire-950, #0A1329);
  }
  #btn-close-drawer {
    display: grid;
    place-items: center;
    min-height: 44px;
    min-width: 44px;
    background: var(--sara-sapphire-50);
    border: 1px solid var(--sara-border-glass);
    border-radius: var(--sara-radius-pill);
    color: var(--sara-text-secondary);
    cursor: pointer;
    transition: all 150ms ease;
  }
  #btn-close-drawer:hover {
    background: var(--color-surface);
    color: var(--sara-sapphire-700);
  }
  .drawer-navigation {
    display: flex;
    flex-direction: column;
  }
  .drawer-navigation a {
    display: flex;
    align-items: center;
    padding: 12px 0;
    min-height: 48px;
    font-size: 1rem;
    font-weight: 600;
    border-bottom: 1px solid var(--sara-border-subtle);
    color: var(--sara-text-primary);
    transition: color 150ms ease;
  }
  .drawer-navigation a:hover {
    color: var(--sara-cyan-600);
  }
  .drawer-navigation a[aria-current="page"] {
    color: var(--sara-sapphire-600);
    font-weight: 800;
  }
  .no-script-navigation {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    padding: 24px;
  }
  .no-script-navigation a {
    text-decoration: underline;
  }
  @media (max-width: 1199px) {
    body {
      padding-bottom: calc(68px + env(safe-area-inset-bottom));
    }
    .header-inner {
      display: none;
    }
    .mobile-nav {
      display: flex;
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      background: var(--sara-glass-dock, rgba(255, 255, 255, 0.85));
      backdrop-filter: blur(25px) saturate(160%);
      -webkit-backdrop-filter: blur(25px) saturate(160%);
      border-top: 1px solid var(--sara-border-glass, rgba(26, 54, 122, 0.1));
      box-shadow: inset 0 1px 1px 0 var(--sara-rim-specular), var(--sara-shadow-glass-sm);
      align-items: center;
      justify-content: space-evenly;
      z-index: 40;
      padding: 4px 4px calc(4px + env(safe-area-inset-bottom));
    }
  }
  @media (max-width: 767px) {
    #main-content {
      padding: 24px 16px 48px;
    }
  }
</style>
