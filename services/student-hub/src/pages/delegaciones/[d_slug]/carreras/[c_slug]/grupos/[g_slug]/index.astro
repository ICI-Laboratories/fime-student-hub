---
import InstitutionalLayout from '../../../../../../../layouts/InstitutionalLayout.astro';
import { cargarDelegacionPorSlug, cargarCarreraPorSlug, cargarGrupoConProfesores } from '../../../../../../../lib/cargarDatos.js';

const { d_slug, c_slug, g_slug } = Astro.params;
const delegation = cargarDelegacionPorSlug(d_slug);
const career = cargarCarreraPorSlug(c_slug);
const group = await cargarGrupoConProfesores(g_slug);

if (!delegation || !career || !group) {
  return Astro.redirect('/404');
}

const professors = group.professors || [];
---

<InstitutionalLayout 
  title={`Claustro de Docentes - ${group.name}`} 
  description={`Lista de profesores asignados al grupo ${group.name} de la carrera ${career?.name}.`}
>
  <div class="max-w-4xl mx-auto space-y-6">
    <!-- Migas de Pan (Breadcrumbs) -->
    <div class="text-xs font-mono text-ink-3 flex items-center gap-1.5">
      <a href="/" class="hover:text-primary transition-colors">Inicio</a>
      <span>/</span>
      <a href="/buscar-grupo" class="hover:text-primary transition-colors">Delegaciones</a>
      <span>/</span>
      <a href={`/delegaciones/${delegation?.slug}`} class="hover:text-primary transition-colors">{delegation?.name}</a>
      <span>/</span>
      <a href={`/delegaciones/${delegation?.slug}/carreras/${career?.slug}`} class="hover:text-primary transition-colors">{career?.name}</a>
      <span>/</span>
      <span class="font-bold text-primary">{group.name}</span>
    </div>

    <!-- Encabezado -->
    <div class="space-y-2">
      <span class="font-mono text-xs uppercase tracking-widest font-bold text-primary">Claustro del Grupo</span>
      <h1 class="font-sans text-3xl font-extrabold tracking-tight text-ink">Profesores del {group.name}</h1>
      <p class="font-sans text-sm text-ink-2 max-w-2xl leading-relaxed">
        Lista de profesores adscritos al grupo y las asignaturas específicas que imparten en el período {group.academic_period || 'vigente'}.
      </p>
    </div>

    <hr class="rule rule--thick" />

    <!-- Listado de Profesores -->
    <div class="space-y-4">
      <h2 class="font-mono text-xs uppercase tracking-wider font-bold text-ink-3 mb-4">Profesores Investigadores Asignados</h2>
      
      {professors.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {professors.map(prof => (
            <div class="glass-card border-l-4 border-l-primary p-5 rounded-xl flex flex-col justify-between hover:border-primary/50 transition-all duration-180">
              <div class="space-y-3">
                <div>
                  <h3 class="font-sans text-lg font-bold text-ink leading-tight">
                    <a href={`/profesores/${prof.slug}`} class="text-ink hover:text-primary no-underline transition-colors">
                      {prof.fullName}
                    </a>
                  </h3>
                  <span class="text-[10px] font-mono text-ink-3 block mt-0.5">{prof.email}</span>
                </div>

                <div class="bg-white/60 p-3 border border-rule/60 rounded-lg">
                  <span class="font-mono text-[8px] uppercase tracking-wider font-bold text-primary block mb-1">Materia Impartida</span>
                  <span class="text-xs font-medium text-ink">{prof.subject_taught || 'Asignación general'}</span>
                </div>
              </div>

              <div class="mt-4 pt-3 border-t border-rule/60 flex justify-end">
                <a href={`/profesores/${prof.slug}`} class="inline-flex items-center gap-1.5 text-xs font-semibold text-primary hover:text-sapphire-300">
                  <span>Ver perfil académico completo</span>
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                </a>
              </div>
            </div>
          ))}
        </div>
      ) : (
        <div class="border border-rule/60 border-dashed rounded-xl p-8 text-center bg-white/50">
          <p class="text-xs italic text-ink-3 font-sans">
            No se registran profesores asignados a este grupo actualmente.
          </p>
        </div>
      )}
    </div>
  </div>
</InstitutionalLayout>
