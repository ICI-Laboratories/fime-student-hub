---
import InstitutionalLayout from "../../../layouts/InstitutionalLayout.astro";
import {
  cargarDelegacionPorSlug,
  cargarFacultadesDeDelegacion,
} from "../../../lib/cargarDatos.js";

const { d_slug } = Astro.params;
const delegation = cargarDelegacionPorSlug(d_slug);

if (!delegation) {
  return Astro.redirect("/404");
}

const facultades = cargarFacultadesDeDelegacion(delegation.id);
---

<InstitutionalLayout
  title={`Delegación ${delegation.name} — Facultades`}
  description={`Facultades y dependencias académicas adscritas a la delegación ${delegation.name} de la Universidad de Colima.`}
>
  <div class="max-w-4xl mx-auto space-y-6">
    <!-- Migas de Pan (Breadcrumbs) -->
    <div
      class="text-xs font-mono text-ink-3 flex items-center gap-1.5 flex-wrap"
    >
      <a href="/" class="hover:text-primary transition-colors">Inicio</a>
      <span>/</span>
      <a href="/buscar-grupo" class="hover:text-primary transition-colors"
        >Delegaciones</a
      >
      <span>/</span>
      <span class="font-bold text-primary">{delegation.name}</span>
    </div>

    <!-- Encabezado -->
    <div class="space-y-2">
      <span
        class="font-mono text-xs uppercase tracking-widest font-bold text-primary"
        >Delegación Universitaria</span
      >
      <h1
        class="font-sans text-3xl font-extrabold tracking-tight text-ink"
      >
        {delegation.name}
      </h1>
      <p
        class="font-sans text-sm text-ink-2 max-w-2xl leading-relaxed"
      >
        Selecciona una facultad o dependencia académica adscrita a esta
        delegación para explorar sus programas educativos y grupos docentes.
      </p>
    </div>

    <hr class="rule rule--thick" />

    <!-- Listado de Facultades -->
    <div class="space-y-4">
      <h2
        class="font-mono text-xs uppercase tracking-wider font-bold text-ink-3 mb-4 flex items-center gap-1.5"
      >
        Facultades y Dependencias
      </h2>

      {
        facultades.length > 0 ? (
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            {facultades.map((fac) => (
              <a
                href={`/delegaciones/${d_slug}/facultades/${fac.slug}`}
                class="glass-card p-5 rounded-xl hover:border-primary/50 transition-all duration-180 flex flex-col justify-between group no-underline"
              >
                <div>
                  <span class="font-mono text-[9px] uppercase tracking-wider font-bold text-ink-3 block mb-1">
                    Facultad / Dependencia
                  </span>
                  <span class="font-sans text-base font-bold text-ink group-hover:text-primary transition-colors">
                    {fac.name}
                  </span>
                  <span class="text-[10px] text-ink-3 font-mono block mt-2">
                    {(fac.career_ids || []).length} programa
                    {(fac.career_ids || []).length !== 1 ? "s" : ""} educativo
                    {(fac.career_ids || []).length !== 1 ? "s" : ""}
                  </span>
                </div>
                <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-primary group-hover:text-sapphire-300 mt-4">
                  <span>Ver programas académicos</span>
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                </span>
              </a>
            ))}
          </div>
        ) : (
          <p class="text-xs italic text-ink-3 font-sans py-4">
            No se registran facultades en esta delegación en este momento.
          </p>
        )
      }
    </div>
  </div>
</InstitutionalLayout>
