)}

  <script>
    import { navigate } from "astro:transitions/client";

    type GroupRecord = {
      id: number | string;
      career_id: number | string;
      semester?: number | string | null;
      name: string;
      slug: string;
      shift?: string | null;
      classroom?: string | null;
    };

    function resolveSemester(group: GroupRecord): number {
      const explicit = Number(group.semester);
      if (Number.isFinite(explicit) && explicit > 0) return explicit;
      const parsed = Number.parseInt(String(group.name ?? ""), 10);
      return Number.isFinite(parsed) && parsed > 0 ? parsed : 1;
    }

    function setupWizard() {
      const wizardRoot = document.getElementById("studenthub-wizard");
      if (!wizardRoot || wizardRoot.dataset.initialized) return;
      wizardRoot.dataset.initialized = "true";

      const dataScript = document.getElementById("studenthub-groups-data");
      let allGroups: GroupRecord[] = [];
      try {
        allGroups = JSON.parse(dataScript?.textContent || "[]");
      } catch {
        allGroups = [];
      }

      const steps = [...wizardRoot.querySelectorAll<HTMLElement>(".wizard-step")];
      const stepperButtons = [...wizardRoot.querySelectorAll<HTMLButtonElement>("[data-step-nav]")];
      const semestersGrid = document.getElementById("semesters-grid");
      const groupsGrid = document.getElementById("groups-grid");
      const careerLabel = document.getElementById("selected-career-label");
      const groupLabel = document.getElementById("selected-career-sem-label");
      let careerTrigger: HTMLElement | null = null;
      let semesterTrigger: HTMLElement | null = null;
      let unlockedRank = 0;

      const stepOrder = ["step-career", "step-semester", "step-group"];

      function showStep(id: string, focusTarget?: HTMLElement | null) {
        const activeIndex = stepOrder.indexOf(id);
        if (activeIndex > unlockedRank) unlockedRank = activeIndex;

        steps.forEach((step) => {
          step.hidden = step.id !== id;
        });

        stepperButtons.forEach((btn, idx) => {
          const targetStep = btn.dataset.stepNav;
          const isCurrent = targetStep === id;
          const isCompleted = idx < activeIndex;
          btn.classList.toggle("is-current", isCurrent);
          btn.classList.toggle("is-done", isCompleted);
          btn.disabled = idx > unlockedRank;
          if (isCurrent) btn.setAttribute("aria-current", "step");
          else btn.removeAttribute("aria-current");
        });

        const target = focusTarget || wizardRoot.querySelector<HTMLElement>(`#${id} h1`);
        target?.focus({ preventScroll: true });
      }

      function showEmpty(container: HTMLElement | null, message: string) {
        if (!container) return;
        const note = document.createElement("p");
        note.className = "wizard-empty-msg";
        note.textContent = message;
        container.append(note);
      }

      function goToGroupSchedule(group: GroupRecord, button: HTMLButtonElement) {
        button.disabled = true;
        button.classList.add("is-loading");
        const cta = button.querySelector(".selection-card__cta");
        if (cta) cta.textContent = "Cargando horario…";

        const secure = location.protocol === "https:" ? "; Secure" : "";
        document.cookie = `pica_selected_group=${encodeURIComponent(group.slug)}; Path=/; Max-Age=31536000; SameSite=Lax${secure}`;
        try {
          localStorage.setItem("pica_selected_group", group.slug);
        } catch {
          // Ignorar si almacenamiento local está restringido
        }

        const destination = new URL("/studenthub", location.origin);
        destination.searchParams.set("group", group.slug);

        navigate(destination.href).catch(() => {
          window.location.assign(destination.href);
        });
      }

      wizardRoot.querySelectorAll<HTMLButtonElement>(".career-btn").forEach((button) => {
        button.addEventListener("click", () => {
          careerTrigger = button;
          unlockedRank = 1;
          const careerId = Number(button.dataset.id);
          const careerName = button.dataset.name || "";
          const careerGroups = allGroups.filter((group) => Number(group.career_id) === careerId);
          const semesters = [...new Set(careerGroups.map(resolveSemester))].sort((a, b) => a - b);

          if (careerLabel) careerLabel.textContent = careerName;
          semestersGrid?.replaceChildren();

          semesters.forEach((semester) => {
            const semGroups = careerGroups
              .filter((group) => resolveSemester(group) === semester)
              .sort((a, b) => String(a.name).localeCompare(String(b.name), "es", { numeric: true }));

            const semesterButton = document.createElement("button");
            semesterButton.type = "button";
            semesterButton.className = "sem-btn selection-card-btn selection-card-btn--compact";

            const metaRow = document.createElement("span");
            metaRow.className = "selection-card__meta";
            const countBadge = document.createElement("span");
            countBadge.className = "selection-card__count";
            countBadge.textContent = `${semGroups.length} ${semGroups.length === 1 ? "grupo" : "grupos"}`;
            metaRow.append(countBadge);

            const titleSpan = document.createElement("span");
            titleSpan.className = "selection-card__title";
            titleSpan.textContent = `${semester}° Semestre`;

            const ctaSpan = document.createElement("span");
            ctaSpan.className = "selection-card__cta";
            ctaSpan.textContent = "Ver grupos →";

            semesterButton.append(metaRow, titleSpan, ctaSpan);

            semesterButton.addEventListener("click", () => {
              semesterTrigger = semesterButton;
              unlockedRank = 2;
              if (groupLabel) groupLabel.textContent = `${careerName} · ${semester}° Semestre`;
              groupsGrid?.replaceChildren();

              semGroups.forEach((group) => {
                const groupButton = document.createElement("button");
                groupButton.type = "button";
                groupButton.className = "grp-btn selection-card-btn selection-card-btn--compact";

                const gMeta = document.createElement("span");
                gMeta.className = "selection-card__meta";
                const shiftTag = document.createElement("span");
                shiftTag.className = "selection-card__code";
                shiftTag.textContent = group.shift ? `Turno ${group.shift}` : "Escolarizado";
                gMeta.append(shiftTag);
                if (group.classroom) {
                  const roomTag = document.createElement("span");
                  roomTag.className = "selection-card__count";
                  roomTag.textContent = group.classroom;
                  gMeta.append(roomTag);
                }

                const gTitle = document.createElement("span");
                gTitle.className = "selection-card__title";
                gTitle.textContent = `Grupo ${group.name}`;

                const gCta = document.createElement("span");
                gCta.className = "selection-card__cta";
                gCta.textContent = "Abrir horario →";

                groupButton.append(gMeta, gTitle, gCta);
                groupButton.addEventListener("click", () => goToGroupSchedule(group, groupButton));
                groupsGrid?.append(groupButton);
              });

              if (!semGroups.length) {
                showEmpty(groupsGrid, "Todavía no hay grupos disponibles para este semestre. Puedes elegir otro semestre.");
              }
              showStep("step-group");
            });

            semestersGrid?.append(semesterButton);
          });

          if (!semesters.length) {
            showEmpty(semestersGrid, "Todavía no hay horarios disponibles para esta carrera. Puedes elegir otra carrera.");
          }
          showStep("step-semester");
        });
      });

      stepperButtons.forEach((btn) => {
        btn.addEventListener("click", () => {
          const targetStep = btn.dataset.stepNav;
          if (!targetStep || btn.disabled) return;
          if (targetStep === "step-career") showStep("step-career", careerTrigger);
          else if (targetStep === "step-semester") showStep("step-semester", semesterTrigger);
          else if (targetStep === "step-group") showStep("step-group");
        });
      });

      document.getElementById("btn-back-to-career")?.addEventListener("click", () => {
        showStep("step-career", careerTrigger);
      });
      document.getElementById("btn-back-to-semester")?.addEventListener("click", () => {
        showStep("step-semester", semesterTrigger);
      });
    }

    function setupScheduleModal() {
      const modal = document.getElementById("class-modal") as HTMLDialogElement | null;
      if (!modal || modal.dataset.initialized) return;
      modal.dataset.initialized = "true";

      const lifecycle = new AbortController();
      const opts = { signal: lifecycle.signal };

      const btnClose = document.getElementById("btn-close-modal");
      let modalTrigger: HTMLElement | null = null;
      let previousOverflow = "";

      const mSubject = document.getElementById("modal-subject-name");
      const mProfLink = document.getElementById("modal-professor-link") as HTMLAnchorElement | null;
      const mDesc = document.getElementById("modal-subject-desc");
      const mClassroom = document.getElementById("modal-classroom");
      const mLabType = document.getElementById("modal-lab-type");
      const mEmail = document.getElementById("modal-prof-email");
      const mPhone = document.getElementById("modal-prof-phone");
      const mOffice = document.getElementById("modal-prof-office");
      const mHours = document.getElementById("modal-prof-hours");
      const mImg = document.getElementById("modal-prof-img") as HTMLImageElement | null;
      const mImgPl = document.getElementById("modal-prof-img-placeholder");
      const mSyllabus = document.getElementById("modal-syllabus-btn") as HTMLAnchorElement | null;
      const mExams = document.getElementById("modal-exams-container");
      const mMapLink = document.getElementById("modal-map-link") as HTMLAnchorElement | null;

      document.querySelectorAll<HTMLButtonElement>(".class-card-btn").forEach((btn) => {
        btn.addEventListener("click", () => {
          const subject = btn.getAttribute("data-subject") || "";
          const professor = btn.getAttribute("data-professor") || "";
          const profEmail = btn.getAttribute("data-professor-email") || "";
          const profSlug = btn.getAttribute("data-professor-slug") || "";
          const profPhone = btn.getAttribute("data-professor-phone") || "";
          const profOffice = btn.getAttribute("data-professor-office") || "";
          const profHours = btn.getAttribute("data-professor-hours") || "";
          const profImage = btn.getAttribute("data-professor-image") || "";
          const classroom = btn.getAttribute("data-classroom") || "";
          const isLab = btn.getAttribute("data-is-lab") === "Sí";
          const sylSlug = btn.getAttribute("data-syllabus-slug") || "";
          const desc = btn.getAttribute("data-description") || "Sin descripción disponible.";
          let exams: Array<{ exam_date?: string; exam_name?: string; exam_time?: string }> = [];
          try {
            exams = JSON.parse(btn.getAttribute("data-exams") || "[]");
          } catch {
            exams = [];
          }

          if (mSubject) mSubject.textContent = subject;
          if (mProfLink) {
            mProfLink.textContent = professor || "Docente por asignar";
            if (profSlug) mProfLink.href = `/profesores/${encodeURIComponent(profSlug)}`;
            else mProfLink.removeAttribute("href");
          }
          if (mDesc) mDesc.textContent = desc;
          if (mClassroom) mClassroom.textContent = classroom;
          if (mLabType) mLabType.textContent = isLab ? "Laboratorio" : "Aula teórica";
          if (mEmail) mEmail.textContent = profEmail || "—";
          if (mPhone) mPhone.textContent = profPhone || "—";
          if (mOffice) mOffice.textContent = profOffice || "—";
          if (mHours) mHours.textContent = profHours || "—";
          if (mMapLink) {
            mMapLink.href = `/mapa?highlight=${encodeURIComponent(classroom)}`;
            mMapLink.style.display = classroom ? "inline-block" : "none";
          }

          if (mImg && mImgPl) {
            if (profImage) {
              mImg.src = profImage;
              mImg.alt = `Fotografía de ${professor}`;
              mImg.style.display = "block";
              mImgPl.style.display = "none";
            } else {
              mImg.style.display = "none";
              mImgPl.style.display = "flex";
            }
          }

          if (mSyllabus) {
            if (sylSlug && sylSlug !== "#") {
              mSyllabus.href = `/materias/${encodeURIComponent(sylSlug)}`;
              mSyllabus.style.display = "flex";
            } else {
              mSyllabus.style.display = "none";
            }
          }

          if (mExams) {
            mExams.replaceChildren();
            if (Array.isArray(exams) && exams.length > 0) {
              exams.forEach((exam) => {
                const date = new Date(exam.exam_date || "");
                const dateLabel = Number.isNaN(date.getTime())
                  ? "Fecha por confirmar"
                  : date.toLocaleDateString("es-MX", { day: "numeric", month: "long", year: "numeric" });
                const row = document.createElement("div");
                row.style.cssText = "display:flex; gap:12px; flex-wrap:wrap; justify-content:space-between; padding:8px 0; border-bottom:1px solid var(--color-rule);";
                const name = document.createElement("span");
                name.style.cssText = "font-size:0.75rem; font-weight:700; text-transform:uppercase; color:var(--color-ink);";
                name.textContent = exam.exam_name || "Evaluación";
                const details = document.createElement("span");
                details.style.cssText = "font-size:0.75rem; font-family:var(--font-mono); color:var(--color-ink-3);";
                details.textContent = `${dateLabel}${exam.exam_time ? ` · ${exam.exam_time.substring(0, 5)}` : ""}`;
                row.append(name, details);
                mExams.append(row);
              });
            } else {
              const empty = document.createElement("p");
              empty.style.cssText = "font-size:0.75rem; color:var(--color-ink-3); padding-top:4px;";
              empty.textContent = "Sin exámenes programados.";
              mExams.append(empty);
            }
          }

          if (!modal.open) {
            modalTrigger = btn;
            previousOverflow = document.body.style.overflow;
            modal.showModal();
            document.body.style.overflow = "hidden";
          }
        }, opts);
      });

      function closeModal() {
        if (!modal?.open) return;
        modal.close();
        document.body.style.overflow = previousOverflow;
        modalTrigger?.focus({ preventScroll: true });
      }

      btnClose?.addEventListener("click", () => closeModal(), opts);
      modal.addEventListener("cancel", (event) => {
        event.preventDefault();
        closeModal();
      }, opts);
      modal.addEventListener("click", (event) => {
        if (event.target !== modal) return;
        const bounds = modal.getBoundingClientRect();
        if (
          event.clientX < bounds.left ||
          event.clientX > bounds.right ||
          event.clientY < bounds.top ||
          event.clientY > bounds.bottom
        ) {
          closeModal();
        }
      }, opts);

      document.addEventListener("astro:before-swap", () => {
        if (modal.open) {
          document.body.style.overflow = previousOverflow;
          modal.close();
        }
        lifecycle.abort();
      }, { once: true, signal: lifecycle.signal });
    }

    function initStudentHubPage() {
      setupWizard();
      setupScheduleModal();
    }

    initStudentHubPage();
    document.addEventListener("astro:page-load", initStudentHubPage);
  </script>
</InstitutionalLayout>

