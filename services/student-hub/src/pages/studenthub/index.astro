---
import InstitutionalLayout from "../../layouts/InstitutionalLayout.astro";
import { cargarCarreras, cargarTodosLosGrupos, cargarGrupoConProfesores, cargarHorarioDeGrupo, cargarExamenesDeGrupo, cargarSyllabusDeCarrera } from "../../lib/cargarDatos.js";

const student = Astro.locals.student;
const allCareers = await cargarCarreras();
const fimeCareerIds = [349, 371, 418, 99];
const careerMetaById: Record<number, { code: string; plan: string }> = {
  349: { code: "ICI", plan: "Plan 349" },
  418: { code: "IMEC", plan: "Plan 418" },
  99: { code: "ISET", plan: "Plan 99" },
  371: { code: "IME", plan: "Plan 371" },
};
const careers = allCareers.filter(c => fimeCareerIds.includes(Number(c.id)));
const allGroups = await cargarTodosLosGrupos();
const serializedGroups = JSON.stringify(allGroups ?? []).replace(/</g, "\\u003c");

const forceSelect = Astro.url.searchParams.has("select_group");
const activeGroupSlug = forceSelect ? null : (Astro.url.searchParams.get("group") || Astro.cookies.get("pica_selected_group")?.value || student?.class_group_slug);
let activeGroup = null;
let schedules = [];
let examDates = [];
let syllabusList = [];

if (activeGroupSlug) {
  activeGroup = await cargarGrupoConProfesores(activeGroupSlug);
  if (activeGroup) {
    schedules = await cargarHorarioDeGrupo(activeGroup.id);
    examDates = await cargarExamenesDeGrupo(activeGroup.id);
    syllabusList = await cargarSyllabusDeCarrera(activeGroup.career_id);

    if (schedules && schedules.length > 0) {
      schedules = schedules.map(s => {
        const dayClassroom = activeGroup.classroom || (activeGroup.classrooms_by_day ? activeGroup.classrooms_by_day[s.day_of_week] : null);
        let effectiveRoom = null;

        if (dayClassroom) {
          if (dayClassroom.includes('/')) {
            const parts = dayClassroom.split('/').map(p => p.trim());
            const preRecess = parts[0] || null;
            const postRecess = parts[1] || null;
            effectiveRoom = (s.start_time < "15:00:00") ? preRecess : postRecess;
          } else {
            effectiveRoom = dayClassroom;
          }
        }

        let room = s.classroom_name;
        if (effectiveRoom) {
          if (!room || room === "Aulas" || room === "Por asignar") {
            room = effectiveRoom;
          } else if (room === "Cómputo y Talleres") {
            room = effectiveRoom;
          }
        }

        return {
          ...s,
          classroom_name: room
        };
      });
    }
  }
}

const timeSlots = [
  { start: "07:00:00", end: "07:50:00", label: "07:00–07:50" },
  { start: "07:50:00", end: "08:40:00", label: "07:50–08:40" },
  { isRecess: true, start: "08:40:00", end: "09:10:00", label: "08:40–09:10", title: "Receso" },
  { start: "09:10:00", end: "10:00:00", label: "09:10–10:00" },
  { start: "10:00:00", end: "10:50:00", label: "10:00–10:50" },
  { start: "10:50:00", end: "11:40:00", label: "10:50–11:40" },
  { start: "11:40:00", end: "12:30:00", label: "11:40–12:30" },
  { start: "12:30:00", end: "13:20:00", label: "12:30–13:20" },
  { start: "13:20:00", end: "14:10:00", label: "13:20–14:10" },
  { start: "14:10:00", end: "15:00:00", label: "14:10–15:00" },
  { isRecess: true, start: "15:00:00", end: "15:30:00", label: "15:00–15:30", title: "Receso" },
  { start: "15:30:00", end: "16:20:00", label: "15:30–16:20" },
  { start: "16:20:00", end: "17:10:00", label: "16:20–17:10" },
  { start: "17:10:00", end: "18:00:00", label: "17:10–18:00" },
  { start: "18:00:00", end: "18:50:00", label: "18:00–18:50" },
  { start: "18:50:00", end: "19:40:00", label: "18:50–19:40" },
];

let minStartTime = "23:59:59";
let maxEndTime = "00:00:00";
if (schedules && schedules.length > 0) {
  schedules.forEach(s => {
    if (s.start_time < minStartTime) {
      minStartTime = s.start_time;
    }
    if (s.end_time > maxEndTime) {
      maxEndTime = s.end_time;
    }
  });
} else {
  minStartTime = "07:00:00";
  maxEndTime = "14:10:00";
}

const visibleTimeSlots = timeSlots.filter(slot => {
  return slot.start >= minStartTime && slot.start < maxEndTime;
});

const daysOfWeek = ["Lunes", "Martes", "Miércoles", "Jueves", "Viernes"];

function findScheduleItems(day: string, timeStart: string, timeEnd: string) {
  return schedules.filter(s => {
    if (s.day_of_week !== day) return false;
    return s.start_time < timeEnd && s.end_time > timeStart;
  });
}

const gridCells = [];
visibleTimeSlots.forEach((slot, slotIdx) => {
  gridCells[slotIdx] = [];
  daysOfWeek.forEach((day, dayIdx) => {
    gridCells[slotIdx][dayIdx] = { render: true, rowspan: 1, items: [] };
  });
});

function mergeOverlappingItems(items) {
  const bySubject = {};
  items.forEach(item => {
    const key = item.subject_name;
    if (!bySubject[key]) {
      bySubject[key] = { ...item };
    } else {
      const existing = bySubject[key];
      if (item.professor_name && (!existing.professor_name || !existing.professor_name.includes(item.professor_name))) {
        existing.professor_name = existing.professor_name ? existing.professor_name + " / " + item.professor_name : item.professor_name;
      }
      if (item.classroom_name && (!existing.classroom_name || !existing.classroom_name.includes(item.classroom_name))) {
        existing.classroom_name = existing.classroom_name ? existing.classroom_name + " / " + item.classroom_name : item.classroom_name;
      }
      existing.is_hti = existing.is_hti || item.is_hti;
      existing.is_lab = existing.is_lab || item.is_lab;
    }
  });
  return Object.values(bySubject);
}

daysOfWeek.forEach((day, dayIdx) => {
  for (let slotIdx = 0; slotIdx < visibleTimeSlots.length; slotIdx++) {
    const slot = visibleTimeSlots[slotIdx];
    if (slot.isRecess) continue;
    if (!gridCells[slotIdx][dayIdx].render) continue;

    const rawItems = findScheduleItems(day, slot.start, slot.end);
    const mergedItems = mergeOverlappingItems(rawItems);
    gridCells[slotIdx][dayIdx].items = mergedItems;

    if (mergedItems.length > 0) {
      let currentSpan = 1;
      let nextSlotIdx = slotIdx + 1;
      
      while (nextSlotIdx < visibleTimeSlots.length) {
        const nextSlot = visibleTimeSlots[nextSlotIdx];
        if (nextSlot.isRecess) break;
        
        const nextRawItems = findScheduleItems(day, nextSlot.start, nextSlot.end);
        const nextMerged = mergeOverlappingItems(nextRawItems);
        
        if (mergedItems.length === nextMerged.length && mergedItems.length > 0) {
          let allMatch = true;
          for (let i = 0; i < mergedItems.length; i++) {
            if (mergedItems[i].subject_name !== nextMerged[i].subject_name || mergedItems[i].professor_name !== nextMerged[i].professor_name || nextMerged[i].is_hti) {
              allMatch = false;
              break;
            }
          }
          if (allMatch) {
            currentSpan++;
            gridCells[nextSlotIdx][dayIdx].render = false;
            mergedItems.forEach((item, idx) => {
                item.end_time = nextMerged[idx].end_time;
            });
            nextSlotIdx++;
          } else {
            break;
          }
        } else {
          break;
        }
      }
      gridCells[slotIdx][dayIdx].rowspan = currentSpan;
    }
  }
});

function getSyllabusSlug(subjectName: string): string {
  const s = syllabusList.find(s =>
    s.subject_name?.toLowerCase().trim() === subjectName?.toLowerCase().trim()
  );
  return s?.slug || "#";
}

function getSyllabusDesc(subjectName: string): string {
  const s = syllabusList.find(s =>
    s.subject_name?.toLowerCase().trim() === subjectName?.toLowerCase().trim()
  );
  return s?.program_description || "Sin descripción disponible.";
}

function getDailySchedule(day: string) {
  const dayItems = schedules
    .filter(s => s.day_of_week === day)
    .sort((a, b) => a.start_time.localeCompare(b.start_time))
    .map(item => ({
      ...item,
      isHti: item.is_hti || item.subject_name?.toUpperCase().includes('HTI')
    }));

  const byTimeAndSubject = {};
  dayItems.forEach(item => {
    const key = `${item.start_time}-${item.end_time}-${item.subject_name}`;
    if (!byTimeAndSubject[key]) {
      byTimeAndSubject[key] = { ...item };
    } else {
      const existing = byTimeAndSubject[key];
      if (item.professor_name && (!existing.professor_name || !existing.professor_name.includes(item.professor_name))) {
        existing.professor_name = existing.professor_name ? existing.professor_name + " / " + item.professor_name : item.professor_name;
      }
      if (item.classroom_name && (!existing.classroom_name || !existing.classroom_name.includes(item.classroom_name))) {
        existing.classroom_name = existing.classroom_name ? existing.classroom_name + " / " + item.classroom_name : item.classroom_name;
      }
    }
  });
  return Object.values(byTimeAndSubject).sort((a, b) => a.start_time.localeCompare(b.start_time));
}
---

<InstitutionalLayout title={!activeGroup ? "Selección de Grupo" : "Horario del Estudiante"}>
{!activeGroup ? (
  <div id="studenthub-wizard" class="wizard-shell">
    <!-- Barra de progreso interactiva -->
    <nav class="wizard-stepper" aria-label="Pasos para elegir horario">
      <button type="button" class="wizard-stepper__item is-current" data-step-nav="step-career">
        <span class="wizard-stepper__num">1</span>
        <span>Carrera</span>
      </button>
      <span class="wizard-stepper__sep" aria-hidden="true"></span>
      <button type="button" class="wizard-stepper__item" data-step-nav="step-semester" disabled>
        <span class="wizard-stepper__num">2</span>
        <span>Semestre</span>
      </button>
      <span class="wizard-stepper__sep" aria-hidden="true"></span>
      <button type="button" class="wizard-stepper__item" data-step-nav="step-group" disabled>
        <span class="wizard-stepper__num">3</span>
        <span>Grupo</span>
      </button>
    </nav>

    <!-- Paso 1: Selecciona tu Carrera -->
    <section id="step-career" class="wizard-step" aria-labelledby="career-heading">
      <span id="career-progress" class="overline overline--primary">Paso 1 de 3 · Horarios Escolarizados</span>
      <h1 id="career-heading" tabindex="-1" aria-describedby="career-progress" class="wizard-heading">
        Selecciona tu Carrera
      </h1>
      <p class="wizard-lead">
        Elige tu programa académico en FIME para consultar el horario semanal, aulas y fechas de evaluación de tu grupo.
      </p>

      {careers.length === 0 && (
        <p class="wizard-empty-msg">
          No hay carreras disponibles en este momento. <a href="/studenthub?select_group=true" class="link">Volver a cargar</a>
        </p>
      )}
      <div class="selection-grid selection-grid--careers">
        {careers.map(career => {
          const cid = Number(career.id);
          const meta = careerMetaById[cid] ?? { code: "FIME", plan: `Plan ${cid}` };
          const groupCount = (allGroups ?? []).filter(g => Number(g.career_id) === cid).length;
          return (
            <button
              class="career-btn selection-card-btn selection-card-btn--career"
              type="button"
              data-id={cid}
              data-name={career.name}
            >
              <span class="selection-card__meta">
                <span class="selection-card__code">{meta.code} · {meta.plan}</span>
                <span class="selection-card__count">{groupCount} {groupCount === 1 ? "grupo" : "grupos"}</span>
              </span>
              <span class="selection-card__title">{career.name}</span>
              <span class="selection-card__cta">
                Elegir semestre
                <svg viewBox="0 0 20 20" width="16" height="16" fill="currentColor" aria-hidden="true">
                  <path fill-rule="evenodd" d="M12.293 5.293a1 1 0 011.414 0l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-2.293-2.293a1 1 0 010-1.414z" clip-rule="evenodd" />
                </svg>
              </span>
            </button>
          );
        })}
      </div>

      <p class="wizard-online-note">
        <strong>Nota:</strong> El programa de <em>Ingeniería de Datos e Inteligencia Artificial (IDIA · Plan 465)</em> se cursa en modalidad en línea a través de las plataformas virtuales de la universidad.
      </p>
    </section>

    <!-- Paso 2: Selecciona tu Semestre -->
    <section id="step-semester" class="wizard-step" aria-labelledby="semester-heading" hidden>
      <span id="semester-progress" class="overline overline--primary">Paso 2 de 3</span>
      <h1 id="semester-heading" tabindex="-1" aria-describedby="semester-progress selected-career-label" class="wizard-heading">
        Selecciona tu Semestre
      </h1>
      <p id="selected-career-label" class="wizard-context-label"></p>

      <div id="semesters-grid" class="selection-grid selection-grid--compact" style="margin-bottom: 32px;"></div>

      <button
        id="btn-back-to-career"
        type="button"
        aria-label="Volver a elegir carrera"
        class="btn btn--ghost"
      >
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
        Cambiar carrera
      </button>
    </section>

    <!-- Paso 3: Selecciona tu Grupo -->
    <section id="step-group" class="wizard-step" aria-labelledby="group-heading" hidden>
      <span id="group-progress" class="overline overline--primary">Paso 3 de 3</span>
      <h1 id="group-heading" tabindex="-1" aria-describedby="group-progress selected-career-sem-label" class="wizard-heading">
        Selecciona tu Grupo
      </h1>
      <p id="selected-career-sem-label" class="wizard-context-label"></p>

      <div id="groups-grid" class="selection-grid selection-grid--compact" style="margin-bottom: 32px;"></div>

      <button
        id="btn-back-to-semester"
        type="button"
        aria-label="Volver a elegir semestre"
        class="btn btn--ghost"
      >
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
        Cambiar semestre
      </button>
    </section>

    <script type="application/json" id="studenthub-groups-data" set:html={serializedGroups} />
    <noscript><p>Activa JavaScript para elegir tu grupo y consultar el horario. El directorio de profesores y las materias siguen disponibles desde el menú.</p></noscript>
  </div>
) : (
  <>

  <div class="page-header" style="display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: 20px;">
    <div class="page-header__title">
      <span class="overline overline--primary">Panel Principal &mdash; Horario</span>
      <h1 class="page-title" style="margin-bottom: 8px;">
        Horario del<br />Estudiante
      </h1>
      {activeGroup && (
        <p class="page-subtitle">
          {activeGroup.name} &mdash; {activeGroup.careerName} &mdash; Turno {activeGroup.shift}
          {activeGroup.tutor_name && (
            <> &mdash; Tutor: {activeGroup.tutor_name}</>
          )}
          <a href="/studenthub?select_group=true" class="link" style="margin-left: 12px; font-weight: 700; color: var(--sara-sapphire-600); display: inline-flex; align-items: center; gap: 4px;">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 16V4m0 0L3 8m4-4l4 4m6 4v12m0 0l4-4m-4 4l-4-4"/></svg>
            Cambiar Grupo
          </a>
        </p>
      )}
    </div>
    

  </div>




  <hr class="rule" style="margin-bottom: 40px;" />

  <!-- ═══════════════════════════════════════════════════
       CONTENIDO PRINCIPAL
       Grid asimétrico: horario (amplio) + sidebar (estrecho)
       ═══════════════════════════════════════════════════ -->
  <div class="content-grid">

    <!-- ─────────────────────────────────────
         SIDEBAR INFORMATIVO
         Sin tarjetas, sin bordes contenedores.
         Secciones separadas por regla + whitespace.
         ───────────────────────────────────── -->
    <aside class="sidebar" aria-label="Información del grupo">

      <!-- Información del grupo -->
      {activeGroup && (
        <div class="sidebar-section">
          <span class="overline">Tu grupo</span>
          <div class="sidebar-data">
            <div class="data-row">
              <span class="field-label">Grupo</span>
              <span class="field-value">{activeGroup.name}</span>
            </div>
            <div class="data-row">
              <span class="field-label">Carrera</span>
              <span class="field-value">{activeGroup.careerName}</span>
            </div>
            <div class="data-row">
              <span class="field-label">Turno</span>
              <span class="field-value">{activeGroup.shift}</span>
            </div>
            {activeGroup.semester && (
              <div class="data-row">
                <span class="field-label">Semestre</span>
                <span class="field-value">{activeGroup.semester}°</span>
              </div>
            )}
            {activeGroup.classroom && (
              <div class="data-row">
                <span class="field-label">Aula</span>
                <span class="field-value" style="font-family: var(--font-mono); font-weight: 700;">{activeGroup.classroom}</span>
              </div>
            )}
            {!activeGroup.classroom && activeGroup.classrooms_by_day && (() => {
              const diasOrden = ['Lunes', 'Martes', 'Miércoles', 'Jueves', 'Viernes'];
              const cbd = activeGroup.classrooms_by_day;
              const entradasOrdenadas = diasOrden.filter(d => cbd[d]).map(d => [d, cbd[d]]);
              return (
                <div class="data-row" style="align-items: flex-start;">
                  <span class="field-label" style="padding-top: 2px;">Aulas</span>
                  <div style="display: flex; flex-direction: column; gap: 2px;">
                    {entradasOrdenadas.map(([dia, aula]) => (
                      <span style="font-size: 0.75rem;">
                        <span style="color: var(--color-ink-3); font-family: var(--font-mono); font-size: 0.65rem;">{dia.substring(0,2).toUpperCase()}</span>
                        {' '}
                        <span style="font-family: var(--font-mono); font-weight: 700; color: var(--color-ink);">{aula}</span>
                      </span>
                    ))}
                  </div>
                </div>
              );
            })()}
          </div>
        </div>
      )}

      <!-- Tutor del grupo -->
      {activeGroup?.tutor_name && (
        <>
          <hr class="rule" />
          <div class="sidebar-section">
            <span class="overline">Tutor</span>
            <div class="sidebar-data">
              <div class="data-row">
                <span class="field-label">Docente</span>
                <a href={`/profesores/${activeGroup.tutor_slug}`} class="field-value link">
                  {activeGroup.tutor_name}
                </a>
              </div>
              {activeGroup.tutor_email && (
                <div class="data-row">
                  <span class="field-label">Email</span>
                  <a href={`mailto:${activeGroup.tutor_email}`} class="field-value link" style="font-size: 0.75rem; font-weight: 500;">
                    {activeGroup.tutor_email}
                  </a>
                </div>
              )}
              {activeGroup.tutor_office && (
                <div class="data-row">
                  <span class="field-label">Cubículo</span>
                  <span class="field-value">{activeGroup.tutor_office}</span>
                </div>
              )}
            </div>
          </div>
        </>
      )}



    </aside>

    <!-- ─────────────────────────────────────
         COLUMNA PRINCIPAL: TABLA DE HORARIO
         Swiss table: solo reglas horizontales.
         Sin bordes de celda. Sin fondos alternados.
         La tipografía diferencia, no el color.
         ───────────────────────────────────── -->
    <section aria-label="Horario semanal" class="schedule-section">
      <div class="section-head">
        <span class="overline">Horario semanal</span>
      </div>

      <!-- ── VISTA TABLA (Desktop) ── -->
      <div class="schedule-desktop" role="region" aria-label="Tabla de horario, desplazable horizontalmente" tabindex="0">
        <table class="schedule-table" aria-label={`Horario semanal del grupo ${activeGroup.name}`}>
          <thead>
            <tr>
              <th scope="col" class="schedule-table__time-header">Hora</th>
              {daysOfWeek.map(day => (
                <th scope="col" class="schedule-table__day-header">{day}</th>
              ))}
            </tr>
          </thead>
          <tbody>
            {visibleTimeSlots.map((slot, slotIdx) => {
              if (slot.isRecess) {
                return (
                  <tr class="schedule-table__row recess-row" style="background: rgba(var(--color-primary-rgb), 0.04); font-weight: bold; border-top: 1px solid var(--color-rule-strong); border-bottom: 1px solid var(--color-rule-strong);">
                    <th scope="row" class="schedule-table__time-cell" style="height: 38px; padding: 8px 16px 8px 0; vertical-align: middle;">
                      <span class="time-label" style="padding-top: 0;">{slot.label}</span>
                    </th>
                    <td colspan="5" class="schedule-table__cell recess-cell" style="height: 38px; text-align: center; color: var(--color-primary); letter-spacing: 0.15em; text-transform: uppercase; font-size: 0.72rem; padding: 0; font-family: var(--font-sans); font-weight: 800; background: var(--color-surface-2); vertical-align: middle;">
                      Receso
                    </td>
                  </tr>
                );
              }

              return (
                <tr class="schedule-table__row">
                  <th scope="row" class="schedule-table__time-cell">
                    <span class="time-label">{slot.label}</span>
                  </th>
                  {daysOfWeek.map((day, dayIdx) => {
                    const cell = gridCells[slotIdx][dayIdx];
                    if (!cell.render) return null;

                    return (
                      <td class="schedule-table__cell" rowspan={cell.rowspan} style={cell.rowspan > 1 ? "vertical-align: middle;" : ""}>
                         <div style={`display: flex; flex-direction: column; gap: 4px; height: 100%; ${cell.rowspan > 1 ? 'justify-content: center;' : ''}`}>
                          {cell.items.map(item => {
                          const syllabusSlug = item ? getSyllabusSlug(item.subject_name) : "#";
                          const syllabusDesc = item ? getSyllabusDesc(item.subject_name) : "";
                          const isHtiEntry = item.is_hti || (item.subject_name && item.subject_name.toUpperCase().includes('HTI'));
                          return (
                            <button
                              class={`class-entry class-card-btn ${isHtiEntry ? 'independent-work' : ''}`}
                              style={cell.rowspan > 1 ? "min-height: 95px; display: flex; flex-direction: column; justify-content: center;" : ""}
                              type="button"
                        aria-haspopup="dialog"
                        aria-controls="class-modal"
                        aria-label={`Ver detalle de ${item.subject_name}${isHtiEntry ? ' (Horas de Trabajo Independiente)' : ''}, ${day}, ${item.start_time.substring(0, 5)} a ${item.end_time.substring(0, 5)}${item.professor_name ? `, ${item.professor_name}` : ''}${item.classroom_name ? `, aula ${item.classroom_name}` : ''}`}
                              data-subject={item.subject_name}
                              data-professor={item.professor_name}
                              data-professor-email={item.professor_email}
                              data-professor-slug={item.professor_slug}
                              data-professor-phone={item.professor_phone || ""}
                              data-professor-office={item.professor_office || ""}
                              data-professor-hours={item.professor_office_hours || ""}
                              data-professor-image={item.professor_image || ""}
                              data-classroom={item.classroom_name || ""}
                              data-is-lab={item.is_lab ? "Sí" : "No"}
                              data-syllabus-slug={syllabusSlug}
                              data-description={syllabusDesc}
                              data-exams={JSON.stringify(examDates.filter(e => e.subject_name === item.subject_name))}
                            >
                              <span class="class-entry__subject">{item.subject_name}</span>
                              <span class="class-entry__time" style="font-size: 0.65rem; opacity: 0.8; display: block; font-family: monospace;">{item.start_time.substring(0, 5)} - {item.end_time.substring(0, 5)}</span>
                              {item.professor_name && (
                                <span class="class-entry__professor">{item.professor_name}</span>
                              )}
                              {item.classroom_name && (
                                <span class="class-entry__room">
                                  {item.classroom_name}
                                  {item.is_lab && <span class="class-entry__lab-tag">LAB</span>}
                                </span>
                              )}
                              {isHtiEntry && (
                                <span class="class-entry__hti-tag">HTI</span>
                              )}
                            </button>
                          );
                        })}
                        </div>
                      </td>
                    );
                  })}
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>

      <!-- ── VISTA LISTA (Móvil) ── -->
      <div class="schedule-mobile" aria-label="Horario semanal por día">
        {daysOfWeek.map(day => {
          const rawDayItems = getDailySchedule(day);
          
          if (rawDayItems.length > 0) {
            let dayStart = "23:59:59";
            let dayEnd = "00:00:00";
            rawDayItems.forEach(i => {
              if (dayStart > i.start_time) dayStart = i.start_time;
              if (i.end_time > dayEnd) dayEnd = i.end_time;
            });

            timeSlots.filter(s => s.isRecess).forEach(r => {
              if (r.start >= dayStart && dayEnd >= r.end) {
                rawDayItems.push({
                  isRecessCard: true,
                  start_time: r.start,
                  end_time: r.end,
                  subject_name: r.title || "Receso"
                });
              }
            });
            rawDayItems.sort((a, b) => a.start_time.localeCompare(b.start_time));
          }

          const dayItems = [];
          for (let i = 0; rawDayItems.length > i; i++) {
            const currentItem = { ...rawDayItems[i], span: 1 };
            while (
              rawDayItems.length > i + 1 &&
              rawDayItems[i + 1].subject_name === currentItem.subject_name &&
              rawDayItems[i + 1].professor_name === currentItem.professor_name &&
              rawDayItems[i + 1].start_time === currentItem.end_time
            ) {
              currentItem.end_time = rawDayItems[i + 1].end_time;
              currentItem.span++;
              i++;
            }
            dayItems.push(currentItem);
          }
          const classCount = dayItems.filter(item => !item.isRecessCard).length;
          return (
            <div class="mobile-day">
              <div class="mobile-day__header">
                <h2 class="mobile-day__name">{day}</h2>
                <span class="mobile-day__count">{`${classCount} ${classCount === 1 ? 'clase' : 'clases'}`}</span>
              </div>
              {dayItems.length === 0 ? (
                <div class="mobile-day__empty">
                  <span>Sin clases programadas</span>
                </div>
              ) : (
                <div class="mobile-day__list">
                  {dayItems.map(item => {
                    if (item.isRecessCard) {
                      return (
                        <div
                          class="mobile-class"
                          style="min-height: 48px; background: var(--color-muted); justify-content: center; align-items: center; border-left: 3px solid var(--color-primary); border-bottom: 1px solid var(--color-rule-strong); cursor: default;"
                        >
                          <span style="font-family: var(--font-mono); font-size: 0.75rem; font-weight: 800; color: var(--color-primary); text-transform: uppercase; letter-spacing: 0.1em;">
                            {item.start_time.substring(0, 5)} – {item.end_time.substring(0, 5)} &nbsp;&nbsp; Receso
                          </span>
                        </div>
                      );
                    }

                    const syllabusSlug = getSyllabusSlug(item.subject_name);
                    const syllabusDesc = getSyllabusDesc(item.subject_name);
                    const isHtiEntry = item.isHti || item.subject_name?.toUpperCase().includes('HTI');
                    return (
                      <button
                        class={`mobile-class class-card-btn ${isHtiEntry ? 'independent-work' : ''}`}
                        style={`min-height: ${item.span * 72}px; padding-top: ${item.span * 12}px; padding-bottom: ${item.span * 12}px;`}
                        type="button"
                        aria-haspopup="dialog"
                        aria-controls="class-modal"
                        aria-label={`Ver detalle de ${item.subject_name}${isHtiEntry ? ' (Horas de Trabajo Independiente)' : ''}, ${day}, ${item.start_time.substring(0, 5)} a ${item.end_time.substring(0, 5)}${item.professor_name ? `, ${item.professor_name}` : ''}${item.classroom_name ? `, aula ${item.classroom_name}` : ''}`}
                        data-subject={item.subject_name}
                        data-professor={item.professor_name}
                        data-professor-email={item.professor_email}
                        data-professor-slug={item.professor_slug}
                        data-professor-phone={item.professor_phone || ""}
                        data-professor-office={item.professor_office || ""}
                        data-professor-hours={item.professor_office_hours || ""}
                        data-professor-image={item.professor_image || ""}
                        data-classroom={item.classroom_name || ""}
                        data-is-lab={item.is_lab ? "Sí" : "No"}
                        data-syllabus-slug={syllabusSlug}
                        data-description={syllabusDesc}
                        data-exams={JSON.stringify(examDates.filter(e => e.subject_name === item.subject_name))}
                      >
                        <span class="mobile-class__time">{item.start_time.substring(0, 5)} – {item.end_time.substring(0, 5)}</span>
                        <div class="mobile-class__info">
                          <span class="mobile-class__subject">{item.subject_name}</span>
                          {item.professor_name && (
                            <span class="mobile-class__professor">{item.professor_name}</span>
                          )}
                          <span class="mobile-class__meta">
                            {item.classroom_name || ''}
                            {item.is_lab && <span class="class-entry__lab-tag">LAB</span>}
                            {isHtiEntry && <span class="class-entry__hti-tag">HTI</span>}
                          </span>
                        </div>
                      </button>
                    );
                  })}
                </div>
              )}
            </div>
          );
        })}
      </div>
    </section>
  </div>

  <!-- ═══════════════════════════════════════════════════
       MODAL DE CLASE
       Swiss: sin decoración. Solo información organizada
       con tipografía y espaciado. Una línea de división.
       ═══════════════════════════════════════════════════ -->
