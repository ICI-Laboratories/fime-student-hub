    "
  >
    <div
      id="modal-panel"
      style="
        background: var(--color-surface);
        width: 100%;
        max-width: 680px;
        max-height: 90vh;
        overflow-y: auto;
        position: relative;
      "
    >
      <!-- Banda refractiva del prisma en el modal -->
