---
import InstitutionalLayout from "../layouts/InstitutionalLayout.astro";
import CampusCarousel from "../components/CampusCarousel.astro";
import FimeBotChat from "../components/FimeBotChat.astro";
import QuickAccessGrid from "../components/QuickAccessGrid.astro";

// Compatibilidad hacia atrás: redirigir consultas de grupos directas a /studenthub
if (Astro.url.searchParams.has("select_group") || Astro.url.searchParams.has("group")) {
  return Astro.redirect(`/studenthub${Astro.url.search}`);
}

const academicPrograms = [
  { name: "Ingeniería en Computación Inteligente", code: "ICI", icon: "💻" },
  { name: "Ingeniería Mecatrónica", code: "IMEC", icon: "🤖" },
  { name: "Ingeniería Mecánica Electricista", code: "IME", icon: "⚡" },
  { name: "Ingeniería en Tecnologías e Internet", code: "ITI", icon: "🌐" },
];
---

<InstitutionalLayout
  title="Facultad de Ingeniería Mecánica y Eléctrica"
  description="Portal institucional FIME — Universidad de Colima. Conoce nuestras ingenierías, consulta horarios en StudentHUB, ubica aulas en el campus Coquimatlán y orienta tus dudas con FimeBot."
  fromLanding={true}
>
  <div class="landing-page">
    <!-- Hero Principal -->
    <header class="landing-hero">
      <div class="hero-badge">
        <span class="badge-dot"></span>
        <span>FACULTAD DE INGENIERÍA MECÁNICA Y ELÉCTRICA</span>
      </div>
      <h1 class="hero-title">Conoce la FIME y encuentra tu camino</h1>
      <p class="hero-description">
        Explora las carreras de ingeniería, consulta horarios de clase y espacios en el campus Coquimatlán, y orienta tus dudas con FimeBot sobre admisión, trámites y servicios de la Universidad de Colima.
      </p>

      <!-- Botones de Acción Rápida (Óptimos para Móvil y Desktop) -->
      <nav class="hero-actions" aria-label="Acciones prioritarias">
        <a href="/studenthub" class="action-btn action-btn--primary">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
            <line x1="16" y1="2" x2="16" y2="6"></line>
            <line x1="8" y1="2" x2="8" y2="6"></line>
            <line x1="3" y1="10" x2="21" y2="10"></line>
          </svg>
          <span>Ver Horarios de Clase</span>
        </a>
        <a href="#fimebot-chat" class="action-btn action-btn--secondary" id="hero-chat-trigger">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
          </svg>
          <span>Preguntar a FimeBot</span>
        </a>
        <a href="/mapa?from=landing" class="action-btn action-btn--ghost">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polygon points="1 6 1 22 8 18 16 22 23 18 23 2 16 6 8 2 1 6"></polygon>
            <line x1="8" y1="2" x2="8" y2="18"></line>
            <line x1="16" y1="6" x2="16" y2="22"></line>
          </svg>
          <span>Mapa Campus</span>
        </a>
      </nav>
    </header>

    <!-- Split Principal: Galería de Campus + FimeBot Chat -->
    <section class="main-split-section" aria-label="Exploración interactiva de la facultad">
      <div class="split-column split-column--carousel">
        <CampusCarousel />
      </div>

      <div class="split-column split-column--chat">
        <FimeBotChat />
      </div>
    </section>

    <!-- Accesos Rápidos a StudentHUB -->
    <QuickAccessGrid />

    <!-- Oferta Académica FIME -->
    <section class="programs-section" aria-labelledby="programs-title">
      <div class="programs-header">
        <div class="programs-badge">
          <span class="programs-badge-dot"></span>
          <span>PROGRAMAS DE LICENCIATURA</span>
        </div>
        <h2 id="programs-title" class="programs-title">Ingenierías de la FIME</h2>
        <p class="programs-lead">Formamos profesionales de excelencia técnica con visión humanista e innovadora en el campus Coquimatlán.</p>
      </div>

      <div class="programs-grid">
        {academicPrograms.map((program) => (
          <div class="program-card">
            <span class="program-icon" aria-hidden="true">{program.icon}</span>
            <div class="program-info">
              <span class="program-code">{program.code}</span>
              <h3 class="program-name">{program.name}</h3>
            </div>
            <a
              href={`https://www.ucol.mx/oferta-educativa/licenciatura`}
              target="_blank"
              rel="noopener noreferrer"
              class="program-link"
              aria-label={`Ver plan de estudios de ${program.name}`}
            >
              Plan de estudios
              <svg viewBox="0 0 20 20" width="14" height="14" fill="currentColor" aria-hidden="true">
                <path fill-rule="evenodd" d="M5.22 14.78a.75.75 0 001.06 0l7.22-7.22v5.69a.75.75 0 001.5 0v-7.5a.75.75 0 00-.75-.75h-7.5a.75.75 0 000 1.5h5.69l-7.22 7.22a.75.75 0 000 1.06z" clip-rule="evenodd" />
              </svg>
            </a>
          </div>
        ))}
      </div>
    </section>

    <!-- Tarjeta de Ubicación e Información de Contacto -->
    <section class="campus-contact-card" aria-label="Información de la sede universitaria">
      <div class="contact-info">
        <div class="contact-brand">
          <img src="/vectors/logos/fime_escudo_ucol.svg" alt="Escudo Universidad de Colima" width="28" height="28" />
          <div>
            <h3 class="contact-heading">Campus Coquimatlán · Universidad de Colima</h3>
            <p class="contact-sub">Km. 9 Carretera Colima - Coquimatlán, C.P. 28400. Coquimatlán, Colima, México.</p>
          </div>
        </div>
      </div>
      <div class="contact-actions">
        <a href="tel:+523123161066" class="contact-btn">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
          </svg>
          (312) 316-1066
        </a>
        <a href="https://www.ucol.mx" target="_blank" rel="noopener noreferrer" class="contact-btn contact-btn--subtle">
          Portal UCOL
          <svg viewBox="0 0 20 20" width="14" height="14" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M5.22 14.78a.75.75 0 001.06 0l7.22-7.22v5.69a.75.75 0 001.5 0v-7.5a.75.75 0 00-.75-.75h-7.5a.75.75 0 000 1.5h5.69l-7.22 7.22a.75.75 0 000 1.06z" clip-rule="evenodd" />
          </svg>
        </a>
      </div>
    </section>
  </div>
</InstitutionalLayout>

<script>
  // Enlace suave hacia el asistente en móvil o desktop
  const chatTrigger = document.getElementById("hero-chat-trigger");
  if (chatTrigger) {
    chatTrigger.addEventListener("click", (e) => {
      const openBtn = document.getElementById("open-chat-card-btn");
      if (openBtn && window.getComputedStyle(openBtn).display !== "none") {
        openBtn.click();
      }
      const target = document.getElementById("fimebot-chat");
      if (target) {
        target.scrollIntoView({ behavior: "smooth", block: "start" });
        const textarea = document.getElementById("fimebot-textarea") as HTMLTextAreaElement | null;
        if (textarea) {
          setTimeout(() => textarea.focus(), 300);
        }
      }
    });
  }
</script>

<style>
  .landing-page {
    display: flex;
    flex-direction: column;
    gap: 2.25rem;
    width: 100%;
  }

  /* Hero */
  .landing-hero {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 0.5rem 0 1rem;
    max-width: 820px;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono, "JetBrains Mono", monospace);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    font-weight: 700;
    color: var(--sara-sapphire-600, #1A367A);
    text-transform: uppercase;
  }

  .badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--sara-coral-500, #E65642);
    box-shadow: 0 0 0 2px rgba(230, 86, 66, 0.2);
  }

  .hero-title {
    font-family: var(--font-display, "Manrope", sans-serif);
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    font-weight: 900;
    line-height: 1.15;
    letter-spacing: -0.03em;
    color: var(--sara-sapphire-950, #0E1A38);
    margin: 0;
  }

  .hero-description {
    font-size: clamp(0.9375rem, 1.8vw, 1.125rem);
    color: var(--sara-text-secondary, #475569);
    line-height: 1.55;
    margin: 0;
  }

  /* Action buttons */
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-top: 0.5rem;
    width: 100%;
  }

  .action-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 44px;
    padding: 0 1.25rem;
    border-radius: var(--radius-lg, 0.75rem);
    font-family: var(--font-display, "Manrope", sans-serif);
    font-size: 0.875rem;
    font-weight: 700;
    text-decoration: none;
    transition: transform 0.15s ease, box-shadow 0.15s ease, background-color 0.15s ease;
    white-space: nowrap;
  }

  .action-btn--primary {
    background: linear-gradient(135deg, var(--sara-sapphire-700, #1A367A), var(--sara-sapphire-600, #224FA8));
    color: #FFFFFF;
    box-shadow: 0 4px 14px -2px rgba(26, 54, 122, 0.35);
  }

  .action-btn--primary:hover {
    transform: translateY(-1px);
    box-shadow: 0 6px 20px -2px rgba(26, 54, 122, 0.45);
  }

  .action-btn--secondary {
    background: rgba(255, 255, 255, 0.9);
    color: var(--sara-coral-600, #B83523);
    border: 1px solid rgba(230, 86, 66, 0.3);
    box-shadow: 0 2px 8px -2px rgba(230, 86, 66, 0.15);
  }

  .action-btn--secondary:hover {
    background: #FFFFFF;
    transform: translateY(-1px);
    border-color: var(--sara-coral-500, #E65642);
  }

  .action-btn--ghost {
    background: rgba(255, 255, 255, 0.75);
    color: var(--sara-sapphire-700, #1A367A);
    border: 1px solid rgba(226, 232, 240, 0.8);
  }

  .action-btn--ghost:hover {
    background: #FFFFFF;
    transform: translateY(-1px);
  }

  /* Main split section */
  .main-split-section {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: 1.75rem;
    align-items: stretch;
    width: 100%;
  }

  .split-column {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  /* Programs section */
  .programs-section {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    width: 100%;
  }

  .programs-header {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .programs-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono, "JetBrains Mono", monospace);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    font-weight: 700;
    color: var(--sara-jade-600, #0E6B47);
    text-transform: uppercase;
  }

  .programs-badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--sara-jade-500, #0E6B47);
    box-shadow: 0 0 0 2px rgba(14, 107, 71, 0.2);
  }

  .programs-title {
    font-family: var(--font-display, "Manrope", sans-serif);
    font-size: clamp(1.25rem, 2.5vw, 1.625rem);
    font-weight: 800;
    color: var(--sara-sapphire-950, #0E1A38);
    letter-spacing: -0.02em;
    line-height: 1.25;
    margin: 0;
  }

  .programs-lead {
    font-size: 0.9375rem;
    color: var(--sara-text-secondary, #475569);
    margin: 0;
    max-width: 64ch;
    line-height: 1.5;
  }

  .programs-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1rem;
  }

  .program-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 1.25rem;
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(226, 232, 240, 0.8);
    border-radius: var(--radius-lg, 0.75rem);
    gap: 1rem;
    transition: transform 0.15s ease, border-color 0.15s ease;
  }

  .program-card:hover {
    transform: translateY(-2px);
    border-color: rgba(26, 54, 122, 0.25);
  }

  .program-icon {
    font-size: 1.75rem;
    line-height: 1;
  }

  .program-info {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .program-code {
    font-family: var(--font-mono, "JetBrains Mono", monospace);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--sara-sapphire-600, #1A367A);
  }

  .program-name {
    font-family: var(--font-display, "Manrope", sans-serif);
    font-size: 1rem;
    font-weight: 700;
    color: var(--sara-sapphire-950, #0E1A38);
    margin: 0;
    line-height: 1.35;
  }

  .program-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--sara-cyan-700, #0E7B91);
    text-decoration: none;
    padding-top: 0.5rem;
    border-top: 1px solid rgba(226, 232, 240, 0.6);
  }

  .program-link:hover {
    color: var(--sara-cyan-800, #085A6B);
    text-decoration: underline;
  }

  /* Contact footer card */
  .campus-contact-card {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    padding: 1.25rem 1.5rem;
    background: rgba(255, 255, 255, 0.8);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(226, 232, 240, 0.85);
    border-radius: var(--radius-xl, 1rem);
    margin-top: 0.5rem;
  }

  .contact-brand {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .contact-heading {
    font-family: var(--font-display, "Manrope", sans-serif);
    font-size: 0.9375rem;
    font-weight: 800;
    color: var(--sara-sapphire-950, #0E1A38);
    margin: 0;
  }

  .contact-sub {
    font-size: 0.8125rem;
    color: var(--sara-text-secondary, #475569);
    margin: 0.25rem 0 0;
  }

  .contact-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .contact-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.5rem 1rem;
    border-radius: var(--radius-md, 0.5rem);
    font-size: 0.8125rem;
    font-weight: 600;
    text-decoration: none;
    color: var(--sara-sapphire-700, #1A367A);
    background: rgba(26, 54, 122, 0.06);
    border: 1px solid rgba(26, 54, 122, 0.1);
    transition: background-color 0.15s ease;
  }

  .contact-btn:hover {
    background: rgba(26, 54, 122, 0.12);
  }

  .contact-btn--subtle {
    color: var(--sara-text-secondary, #475569);
    background: transparent;
    border-color: rgba(226, 232, 240, 0.8);
  }

  .contact-btn--subtle:hover {
    background: rgba(255, 255, 255, 0.9);
  }

  /* Responsive / Mobile Calm */
  @media (max-width: 960px) {
    .landing-page {
      gap: 1.75rem;
    }

    .main-split-section {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }

    .hero-actions {
      flex-direction: column;
      align-items: stretch;
    }

    .action-btn {
      width: 100%;
    }

    .campus-contact-card {
      flex-direction: column;
      align-items: flex-start;
      padding: 1rem;
    }

    .contact-actions {
      width: 100%;
    }

    .contact-btn {
      flex: 1;
      justify-content: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .action-btn,
    .program-card,
    .contact-btn {
      transition: none;
    }
    .action-btn:hover,
    .program-card:hover {
      transform: none;
    }
  }
</style>
