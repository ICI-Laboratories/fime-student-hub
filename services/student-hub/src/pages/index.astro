---
import InstitutionalLayout from "../layouts/InstitutionalLayout.astro";
import CampusTransformContainer from "../components/CampusTransformContainer.astro";
import QuickAccessGrid from "../components/QuickAccessGrid.astro";

// Compatibilidad hacia atrás: redirigir consultas de grupos directas a /studenthub
if (Astro.url.searchParams.has("select_group") || Astro.url.searchParams.has("group")) {
  return Astro.redirect(`/studenthub${Astro.url.search}`);
}

interface AcademicProgram {
  name: string;
  code: string;
  plan: string;
  url: string;
  modality?: string;
  isOnline?: boolean;
  svg: string;
}

const undergraduatePrograms: AcademicProgram[] = [
  {
    name: "Ingeniería de Datos e Inteligencia Artificial",
    code: "IDIA",
    plan: "Plan 465",
    url: "https://portal.ucol.mx/fime/c-465.htm",
    modality: "En línea",
    isOnline: true,
    svg: `<path d="M12 2a4 4 0 0 1 4 4c0 1.95-1.4 3.58-3.25 3.93v2.14a4 4 0 0 1 2.25 1.43l3.5-1.75a4 4 0 1 1 .9 1.79l-3.5 1.75a4 4 0 0 1-7.8 0l-3.5-1.75a4 4 0 1 1 .9-1.79l3.5 1.75a4 4 0 0 1 2.25-1.43V9.93C7.4 9.58 6 7.95 6 6a4 4 0 0 1 4-4h2z" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>`,
  },
  {
    name: "Ingeniería en Computación Inteligente",
    code: "ICI",
    plan: "Plan 349",
    url: "https://portal.ucol.mx/fime/c-349.htm",
    modality: "Escolarizada",
    svg: `<path d="M16 18l6-6-6-6M8 6l-6 6 6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>`,
  },
  {
    name: "Ingeniería en Mecatrónica",
    code: "IMEC",
    plan: "Plan 418",
    url: "https://portal.ucol.mx/fime/c-418.htm",
    modality: "Escolarizada",
    svg: `<rect x="4" y="4" width="16" height="16" rx="2" stroke="currentColor" stroke-width="2"/><circle cx="9" cy="9" r="1.5" fill="currentColor"/><circle cx="15" cy="15" r="1.5" fill="currentColor"/><path d="M15 9h-2v6h2" stroke="currentColor" stroke-width="1.5"/>`,
  },
  {
    name: "Ingeniería en Sistemas Electrónicos y Telecomunicaciones",
    code: "ISET",
    plan: "Plan 99",
    url: "https://portal.ucol.mx/fime/c-99.htm",
    modality: "Escolarizada",
    svg: `<path d="M4.93 19.07a10 10 0 0 1 0-14.14M7.76 16.24a6 6 0 0 1 0-8.48M12 12h.01M16.24 7.76a6 6 0 0 1 0 8.48M19.07 4.93a10 10 0 0 1 0 14.14" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>`,
  },
  {
    name: "Ingeniero Mecánico Electricista",
    code: "IME",
    plan: "Plan 371",
    url: "https://portal.ucol.mx/fime/c-371.htm",
    modality: "Escolarizada",
    svg: `<polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>`,
  },
];

const graduatePrograms: AcademicProgram[] = [
  {
    name: "Maestría en Ingeniería Aplicada",
    code: "MIA",
    plan: "Plan 352",
    url: "https://portal.ucol.mx/fime/c-352.htm",
    modality: "Posgrado",
    svg: `<circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="2"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z" stroke="currentColor" stroke-width="1.75"/>`,
  },
  {
    name: "Maestría en Ingeniería de Procesos",
    code: "MIP",
    plan: "Plan 408",
    url: "https://portal.ucol.mx/fime/c-408.htm",
    modality: "Posgrado",
    svg: `<path d="M10 2v7.31a2 2 0 0 1-.37 1.17l-5.26 7.89A2 2 0 0 0 6 21h12a2 2 0 0 0 1.63-2.63l-5.26-7.89A2 2 0 0 1 14 9.31V2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><line x1="8" y1="2" x2="16" y2="2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><line x1="6.5" y1="16" x2="17.5" y2="16" stroke="currentColor" stroke-width="1.5"/>`,
  },
];
---

<InstitutionalLayout
  title="Inicio"
  description="StudentHub FIME — Plataforma estudiantil para consultar horarios de clase, ubicar aulas en el campus Coquimatlán, conocer docentes y resolver dudas con FimeBot."
  fromLanding={true}
>
  <div class="landing-page">
    <!-- Hero Principal -->
    <header class="landing-hero">
      <div class="hero-badge">
        <span class="badge-dot"></span>
        <span>STUDENTHUB · COMUNIDAD ESTUDIANTIL FIME</span>
      </div>
      <h1 class="hero-title">Tu guía académica para la FIME</h1>
      <p class="hero-description">
        Consulta horarios de clase por grupo, ubica aulas y laboratorios en el mapa del campus Coquimatlán, explora el directorio docente y orienta tus dudas con FimeBot.
      </p>

      <!-- Botones de Acción Rápida (Óptimos para Móvil y Desktop) -->
      <nav class="hero-actions" aria-label="Acciones prioritarias">
        <a href="/studenthub" class="action-btn action-btn--primary">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
            <line x1="16" y1="2" x2="16" y2="6"></line>
            <line x1="8" y1="2" x2="8" y2="6"></line>
            <line x1="3" y1="10" x2="21" y2="10"></line>
          </svg>
          <span>Ver Horarios de Clase</span>
        </a>
        <button type="button" class="action-btn action-btn--secondary" id="hero-chat-trigger" aria-label="Abrir asistente virtual FimeBot">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
          </svg>
          <span>Preguntar a FimeBot</span>
        </button>
        <a href="/mapa?from=landing" class="action-btn action-btn--ghost">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polygon points="1 6 1 22 8 18 16 22 23 18 23 2 16 6 8 2 1 6"></polygon>
            <line x1="8" y1="2" x2="8" y2="18"></line>
            <line x1="16" y1="6" x2="16" y2="22"></line>
          </svg>
          <span>Mapa Campus</span>
        </a>
      </nav>
    </header>

    <!-- Contenedor Transformable: Carrusel 16:9 + FimeBot Chat Animado -->
    <CampusTransformContainer />

    <!-- Accesos Rápidos de StudentHub -->
    <QuickAccessGrid />

    <!-- Oferta Académica FIME: Licenciaturas y Posgrados -->
    <section class="programs-section" aria-labelledby="programs-title">
      <div class="programs-header">
        <div class="programs-badge">
          <span class="programs-badge-dot"></span>
          <span>PROGRAMAS ACADÉMICOS EN FIME</span>
        </div>
        <h2 id="programs-title" class="programs-title">Ingenierías de la FIME</h2>
        <p class="programs-lead">Programas de licenciatura e ingeniería impartidos en la facultad en modalidades escolarizada y en línea.</p>
      </div>

      <div class="programs-grid">
        {undergraduatePrograms.map((program) => (
          <div class="program-card">
            <div class="program-card-top">
              <div class="program-icon-box" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" set:html={program.svg} />
              </div>
              <div class="program-badges-group">
                <span class="program-code">{program.code}</span>
                {program.isOnline ? (
                  <span class="program-tag program-tag--online">En línea</span>
                ) : (
                  <span class="program-tag">{program.plan}</span>
                )}
              </div>
            </div>
            <div class="program-info">
              <h3 class="program-name">{program.name}</h3>
            </div>
            <a
              href={program.url}
              target="_blank"
              rel="noopener noreferrer"
              class="program-link"
              aria-label={`Ver plan de estudios de ${program.name} en ucol.mx (enlace externo)`}
            >
              Ver plan en ucol.mx
              <svg viewBox="0 0 20 20" width="14" height="14" fill="currentColor" aria-hidden="true">
                <path fill-rule="evenodd" d="M5.22 14.78a.75.75 0 001.06 0l7.22-7.22v5.69a.75.75 0 001.5 0v-7.5a.75.75 0 00-.75-.75h-7.5a.75.75 0 000 1.5h5.69l-7.22 7.22a.75.75 0 000 1.06z" clip-rule="evenodd" />
              </svg>
            </a>
          </div>
        ))}
      </div>

      <!-- Posgrados de la FIME -->
      <div class="graduate-subgroup">
        <div class="programs-header programs-header--sub">
          <div class="programs-badge programs-badge--posgrado">
            <span class="programs-badge-dot programs-badge-dot--posgrado"></span>
            <span>ESTUDIOS AVANZADOS</span>
          </div>
          <h3 class="programs-subtitle">Posgrados y Maestrías</h3>
          <p class="programs-lead">Formación de alta especialización e investigación aplicada a la tecnología y procesos industriales.</p>
        </div>

        <div class="programs-grid programs-grid--graduate">
          {graduatePrograms.map((program) => (
            <div class="program-card program-card--graduate">
              <div class="program-card-top">
                <div class="program-icon-box program-icon-box--graduate" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="22" height="22" fill="none" set:html={program.svg} />
                </div>
                <div class="program-badges-group">
                  <span class="program-code program-code--graduate">{program.code}</span>
                  <span class="program-tag program-tag--graduate">{program.plan}</span>
                </div>
              </div>
              <div class="program-info">
                <h4 class="program-name">{program.name}</h4>
              </div>
              <a
                href={program.url}
                target="_blank"
                rel="noopener noreferrer"
                class="program-link program-link--graduate"
                aria-label={`Ver convocatoria y plan de estudios de ${program.name} en ucol.mx (enlace externo)`}
              >
                Ver ficha en ucol.mx
                <svg viewBox="0 0 20 20" width="14" height="14" fill="currentColor" aria-hidden="true">
                  <path fill-rule="evenodd" d="M5.22 14.78a.75.75 0 001.06 0l7.22-7.22v5.69a.75.75 0 001.5 0v-7.5a.75.75 0 00-.75-.75h-7.5a.75.75 0 000 1.5h5.69l-7.22 7.22a.75.75 0 000 1.06z" clip-rule="evenodd" />
                </svg>
              </a>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Tarjeta de Ubicación e Información de Contacto -->
    <section class="campus-contact-card" aria-label="Información de la sede universitaria">
      <div class="contact-info">
        <div class="contact-brand">
          <img src="/vectors/logos/fime_escudo_ucol.svg" alt="Escudo Universidad de Colima" width="28" height="28" />
          <div>
            <h3 class="contact-heading">Campus Coquimatlán · Universidad de Colima</h3>
            <p class="contact-sub">Km. 9 Carretera Colima - Coquimatlán, C.P. 28400. Coquimatlán, Colima, México.</p>
          </div>
        </div>
      </div>
      <div class="contact-actions">
        <a href="tel:+523123161066" class="contact-btn">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
          </svg>
          (312) 316-1066
        </a>
        <a href="https://www.ucol.mx" target="_blank" rel="noopener noreferrer" class="contact-btn contact-btn--subtle">
          Portal UCOL
          <svg viewBox="0 0 20 20" width="14" height="14" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M5.22 14.78a.75.75 0 001.06 0l7.22-7.22v5.69a.75.75 0 001.5 0v-7.5a.75.75 0 00-.75-.75h-7.5a.75.75 0 000 1.5h5.69l-7.22 7.22a.75.75 0 000 1.06z" clip-rule="evenodd" />
          </svg>
        </a>
      </div>
    </section>
  </div>
</InstitutionalLayout>

<style>
  .landing-page {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    width: 100%;
  }

  /* Hero */
  .landing-hero {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 0.5rem 0 0.5rem;
    max-width: 820px;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono, "JetBrains Mono", monospace);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    font-weight: 700;
    color: var(--sara-sapphire-600, #1A367A);
    text-transform: uppercase;
  }

  .badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--sara-coral-500, #E65642);
    box-shadow: 0 0 0 2px rgba(230, 86, 66, 0.2);
  }

  .hero-title {
    font-family: var(--font-display, "Manrope", sans-serif);
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    font-weight: 900;
    line-height: 1.15;
    letter-spacing: -0.03em;
    color: var(--sara-sapphire-950, #0E1A38);
    margin: 0;
  }

  .hero-description {
    font-size: clamp(0.9375rem, 1.8vw, 1.125rem);
    color: var(--sara-text-secondary, #475569);
    line-height: 1.55;
    margin: 0;
  }

  /* Action buttons */
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-top: 0.5rem;
    width: 100%;
  }

  .action-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 44px;
    padding: 0 1.25rem;
    border-radius: var(--radius-lg, 0.75rem);
    font-family: var(--font-display, "Manrope", sans-serif);
    font-size: 0.875rem;
    font-weight: 700;
    text-decoration: none;
    border: none;
    cursor: pointer;
    transition: transform 0.15s ease, box-shadow 0.15s ease, background-color 0.15s ease;
    white-space: nowrap;
  }

  .action-btn--primary {
    background: linear-gradient(135deg, var(--sara-sapphire-700, #1A367A), var(--sara-sapphire-600, #224FA8));
    color: #FFFFFF;
    box-shadow: 0 4px 14px -2px rgba(26, 54, 122, 0.35);
  }

  .action-btn--primary:hover {
    transform: translateY(-1px);
    box-shadow: 0 6px 20px -2px rgba(26, 54, 122, 0.45);
  }

  .action-btn--secondary {
    background: rgba(255, 255, 255, 0.9);
    color: var(--sara-coral-600, #B83523);
    border: 1px solid rgba(230, 86, 66, 0.3);
    box-shadow: 0 2px 8px -2px rgba(230, 86, 66, 0.15);
  }

  .action-btn--secondary:hover {
    background: #FFFFFF;
    transform: translateY(-1px);
    border-color: var(--sara-coral-500, #E65642);
  }

  .action-btn--ghost {
    background: rgba(255, 255, 255, 0.75);
    color: var(--sara-sapphire-700, #1A367A);
    border: 1px solid rgba(226, 232, 240, 0.8);
  }

  .action-btn--ghost:hover {
    background: #FFFFFF;
    transform: translateY(-1px);
  }

  /* Programs section */
  .programs-section {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    width: 100%;
  }

  .programs-header {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .programs-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono, "JetBrains Mono", monospace);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    font-weight: 700;
    color: var(--sara-jade-600, #0E6B47);
    text-transform: uppercase;
  }

  .programs-badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--sara-jade-500, #0E6B47);
    box-shadow: 0 0 0 2px rgba(14, 107, 71, 0.2);
  }

  .programs-title {
    font-family: var(--font-display, "Manrope", sans-serif);
    font-size: clamp(1.25rem, 2.5vw, 1.625rem);
    font-weight: 800;
    color: var(--sara-sapphire-950, #0E1A38);
    letter-spacing: -0.02em;
    line-height: 1.25;
    margin: 0;
  }

  .programs-lead {
    font-size: 0.9375rem;
    color: var(--sara-text-secondary, #475569);
    margin: 0;
    max-width: 64ch;
    line-height: 1.5;
  }

  .programs-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1rem;
  }

  .program-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 1.25rem;
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(226, 232, 240, 0.8);
    border-radius: var(--radius-lg, 0.75rem);
    gap: 1rem;
    transition: transform 0.15s ease, border-color 0.15s ease;
  }

  .program-card:hover {
    transform: translateY(-2px);
    border-color: rgba(26, 54, 122, 0.25);
  }

  .program-icon-box {
    width: 42px;
    height: 42px;
    border-radius: var(--radius-md, 0.5rem);
    background: rgba(26, 54, 122, 0.08);
    color: var(--sara-sapphire-600, #1A367A);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.2s ease, background 0.2s ease;
  }

  .program-card:hover .program-icon-box {
    transform: scale(1.08);
    background: rgba(21, 154, 179, 0.12);
    color: var(--sara-cyan-700, #0E7B91);
  }

  .program-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .program-badges-group {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .program-tag {
    font-family: var(--font-mono, "JetBrains Mono", monospace);
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    padding: 2px 7px;
    border-radius: var(--sara-radius-pill, 9999px);
    background: rgba(26, 54, 122, 0.08);
    color: var(--sara-sapphire-700, #1A367A);
    text-transform: uppercase;
  }

  .program-tag--online {
    background: rgba(21, 154, 179, 0.14);
    color: var(--sara-cyan-800, #0B6477);
    border: 1px solid rgba(21, 154, 179, 0.3);
  }

  .program-tag--graduate {
    background: rgba(14, 107, 71, 0.12);
    color: var(--sara-jade-700, #0A5236);
    border: 1px solid rgba(14, 107, 71, 0.25);
  }

  .graduate-subgroup {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin-top: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px dashed rgba(26, 54, 122, 0.16);
  }

  .programs-header--sub {
    margin-bottom: 0.25rem;
  }

  .programs-badge--posgrado {
    color: var(--sara-jade-700, #0A5236);
  }

  .programs-badge-dot--posgrado {
    background-color: var(--sara-jade-600, #0E6B47);
  }

  .programs-subtitle {
    font-family: var(--font-display, "Manrope", sans-serif);
    font-size: clamp(1.125rem, 2vw, 1.375rem);
    font-weight: 800;
    color: var(--sara-sapphire-950, #0E1A38);
    letter-spacing: -0.02em;
    margin: 0;
  }

  .program-card--graduate {
    border-left: 3px solid var(--sara-jade-600, #0E6B47);
  }

  .program-icon-box--graduate {
    background: rgba(14, 107, 71, 0.08);
    color: var(--sara-jade-700, #0A5236);
  }

  .program-card--graduate:hover .program-icon-box--graduate {
    background: rgba(14, 107, 71, 0.16);
