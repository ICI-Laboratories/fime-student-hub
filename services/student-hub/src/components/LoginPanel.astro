---
import "../styles/global.css";
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Iniciar Sesión | StudentHUB</title>
  </head>
  <body
    style="display: flex; min-height: 100vh; background-color: var(--color-bg); margin: 0; font-family: var(--font-sans);"
  >
    <!-- Lado Izquierdo: Formulario -->
    <div
      style="flex: 1; display: flex; flex-direction: column; justify-content: center; padding: 40px; max-width: 500px; margin: 0 auto;"
    >
      <div style="margin-bottom: 40px;">
        <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 20px;">
          <img src="/vectors/sara_isotipo_prisma_oscuro.svg" alt="SARA Prisma" style="height: 38px; width: auto;" />
          <div style="display: flex; flex-direction: column;">
            <span style="font-size: 0.6875rem; font-family: var(--font-mono); text-transform: uppercase; font-weight: 800; color: var(--sara-sapphire-500); letter-spacing: 0.08em;">Ecosistema SARA</span>
            <span style="font-size: 0.75rem; font-weight: 600; color: var(--color-ink-2);">Universidad de Colima</span>
          </div>
        </div>
        <h1
          style="font-size: 2.75rem; font-weight: 900; letter-spacing: -0.04em; color: var(--color-ink); line-height: 1;"
        >
          StudentHUB
        </h1>
        <p
          style="font-size: 0.875rem; color: var(--color-ink-2); margin-top: 14px; line-height: 1.5;"
        >
          Acceso institucional al portal académico de FIME y servicios del ecosistema digital.
        </p>
      </div>

      <form
        id="login-form"
        autocomplete="off"
        style="display: flex; flex-direction: column; gap: 24px;"
      >
        <div
          id="error-message"
          aria-live="polite"
          style="display: none; padding: 12px; background: var(--color-ink); color: var(--color-surface); font-size: 0.8125rem; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; border-radius: 8px;"
        >
          <!-- Mensaje de error -->
        </div>

        <div>
          <label for="enrollment_id" class="field-label"
            >Matrícula Estudiantil</label
          >
          <input
            type="text"
            id="enrollment_id"
            name="student_enrollment_id"
            class="input"
            placeholder="Ej. 20180000"
            required
            autocomplete="username"
            autocapitalize="off"
            spellcheck="false"
            style="width: 100%; box-sizing: border-box; min-height: 44px; border-radius: 12px;"
          />
        </div>

        <div>
          <label for="password" class="field-label">Contraseña</label>
          <div style="position: relative; width: 100%;">
            <input
              type="password"
              id="password"
              name="student_password"
              class="input"
              placeholder="••••••••"
              required
              autocomplete="current-password"
              autocapitalize="off"
              spellcheck="false"
              style="width: 100%; box-sizing: border-box; padding-right: 56px; min-height: 44px; border-radius: 12px;"
            />
            <button
              type="button"
              id="toggle-password"
              aria-label="Mostrar contraseña"
              style="position: absolute; right: 4px; top: 50%; transform: translateY(-50%); background: none; border: none; cursor: pointer; font-size: 0.75rem; font-family: var(--font-mono); font-weight: 700; color: var(--color-ink-2); text-transform: uppercase; letter-spacing: 0.05em; min-width: 44px; min-height: 44px; display: inline-flex; align-items: center; justify-content: center; border-radius: 8px;"
              >Ver</button
            >
          </div>
        </div>

        <button
          type="submit"
          class="btn btn--primary"
          style="margin-top: 8px; padding: 14px 20px; font-size: 0.9375rem; width: 100%; min-height: 48px; border-radius: 12px; background: linear-gradient(135deg, var(--sara-sapphire-500) 0%, var(--sara-cyan-600) 100%); color: #ffffff; border: none;"
        >
          Acceder al Sistema
        </button>
      </form>

      <div
        style="margin-top: 64px; border-top: 1px solid var(--color-rule); padding-top: 24px;"
      >
        <p
          style="font-family: var(--font-mono); font-size: 0.6875rem; color: var(--color-ink-3);"
        >
          &copy; 2026 Universidad de Colima • Facultad de Ingeniería Mecánica y Eléctrica.<br />
          Ecosistema Digital SARA v0.5.0 Prisma Glass OS.
        </p>
      </div>
    </div>

    <!-- Lado Derecho: SARA Glass Caustics & Prisma Hero (Desktop) -->
    <div
      style="flex: 1; background: linear-gradient(135deg, #0A192F 0%, #1A367A 50%, #0E6B47 100%); display: none; position: relative; overflow: hidden;"
      id="login-hero"
    >
      <div
        style="position: absolute; inset: 0; opacity: 0.35; background-image: radial-gradient(circle at 30% 30%, rgba(21, 154, 179, 0.4) 0%, transparent 60%), radial-gradient(circle at 80% 80%, rgba(230, 86, 66, 0.3) 0%, transparent 50%); mix-blend-mode: screen;"
      >
      </div>
      <div style="position: absolute; top: 40px; left: 40px; opacity: 0.85;">
        <img src="/vectors/sara_isotipo_prisma_oscuro.svg" alt="SARA Prisma" style="height: 48px; filter: brightness(1.2);" />
      </div>
      <div
        style="position: absolute; bottom: 48px; right: 48px; text-align: right; color: #ffffff;"
      >
        <span
          style="font-family: var(--font-mono); font-size: 0.8125rem; letter-spacing: 0.12em; color: rgba(255, 255, 255, 0.85); display: block; margin-bottom: 8px;"
          >FACULTAD DE INGENIERÍA MECÁNICA Y ELÉCTRICA</span
        >
        <h2
          style="font-size: 3.5rem; font-weight: 900; letter-spacing: -0.04em; line-height: 0.95; margin: 0; color: #ffffff;"
        >
          SARA <span style="font-weight: 300; opacity: 0.9;">HUB</span>
        </h2>
        <span
          style="font-family: var(--font-mono); font-size: 0.75rem; letter-spacing: 0.14em; color: rgba(21, 154, 179, 0.95); display: block; margin-top: 14px; font-weight: 700;"
          >PRISMA GLASS OS v0.5.0</span
        >
      </div>
    </div>
  </body>
</html>

<style>
  @media (min-width: 1024px) {
    #login-hero {
      display: block !important;
    }
  }

  .field-label {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-ink-2);
    margin-bottom: 8px;
  }

  .input {
    background: var(--color-surface);
    border: 1px solid var(--color-rule-strong);
    padding: 12px 16px;
    font-family: var(--font-sans);
    font-size: 1rem;
    color: var(--color-ink);
    border-radius: 0;
    transition: border-color 150ms;
  }

  .input:focus {
    outline: none;
    border-color: var(--color-ink);
  }

  .btn {
    border: none;
    font-family: var(--font-sans);
    font-weight: 800;
    letter-spacing: -0.02em;
    cursor: pointer;
    transition: opacity 150ms;
    text-align: center;
  }

  .btn--primary {
    background-color: var(--color-ink);
    color: var(--color-surface);
  }

  .btn--primary:hover {
    opacity: 0.85;
  }
</style>

<script>
  // Toggle password visibility
  const togglePassBtn = document.getElementById("toggle-password");
  togglePassBtn?.addEventListener("click", () => {
    const passwordInput = document.getElementById(
      "password",
    ) as HTMLInputElement | null;
    if (passwordInput && togglePassBtn) {
      if (passwordInput.type === "password") {
        passwordInput.type = "text";
        togglePassBtn.textContent = "Ocultar";
        togglePassBtn.setAttribute("aria-label", "Ocultar contraseña");
      } else {
        passwordInput.type = "password";
        togglePassBtn.textContent = "Ver";
        togglePassBtn.setAttribute("aria-label", "Mostrar contraseña");
      }
    }
  });

  document
    .getElementById("login-form")
    ?.addEventListener("submit", async (e) => {
      e.preventDefault();
      const enrollmentInput = document.getElementById(
        "enrollment_id",
      ) as HTMLInputElement | null;
      const passwordInput = document.getElementById(
        "password",
      ) as HTMLInputElement | null;
      const errorMsg = document.getElementById("error-message");

      if (errorMsg) errorMsg.style.display = "none";

      const formData = new FormData();
      formData.set("enrollment_id", enrollmentInput?.value.trim() || "");
      formData.set("password", passwordInput?.value.trim() || "");

      try {
        const res = await fetch("/student-auth/login", {
          method: "POST",
          body: formData,
        });
        const data = await res.json();

        if (res.ok) {
          window.location.href = "/";
        } else {
          if (errorMsg) {
            errorMsg.textContent = data.error || "Error al iniciar sesión";
            errorMsg.style.display = "block";
          }
        }
      } catch (err) {
        if (errorMsg) {
          errorMsg.textContent = "Error de conexión";
          errorMsg.style.display = "block";
        }
      }
    });
</script>
