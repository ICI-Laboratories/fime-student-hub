---
interface Teacher {
  slug: string;
  fullName: string;
  photoUrl?: string;
  title: string;
  department: string;
  quote: string;
  delegation_id?: number;
  faculty_id?: number;
  career_ids?: number[];
}

interface Props {
  profesores: Teacher[];
}

const { profesores = [] } = Astro.props;

function cleanName(name: string) {
  return name.replace(/^(dr\.|dra\.|mtro\.|mtra\.|lic\.|ing\.|arq\.)\s*/i, '');
}
---

<div class="teachers-grid">
  {profesores.map((prof) => {
    const cleanFullName = cleanName(prof.fullName);
    return (
      <div
        class="teacher-card"
        data-delegation={prof.delegation_id}
        data-faculty={prof.faculty_id || ''}
        data-careers={JSON.stringify(prof.career_ids || [])}
      >
        <!-- Avatar -->
        <div class="teacher-card__avatar-wrap">
          <div class="teacher-card__avatar">
            {prof.photoUrl ? (
              <img
                src={prof.photoUrl}
                alt={`Fotografía de ${prof.fullName}`}
                loading="lazy"
                class="teacher-card__img"
                onerror="this.style.display='none'; if(this.nextElementSibling) this.nextElementSibling.style.display='flex';"
              />
            ) : null}
            <div class="teacher-card__initials" style={`display: ${prof.photoUrl ? 'none' : 'flex'};`}>
              {cleanFullName.split(/\s+/).filter(Boolean).map(n => n[0]).slice(0, 2).join('')}
            </div>
          </div>
        </div>

        <!-- Información -->
        <div class="teacher-card__body">
          <div>
            <h2 class="teacher-card__name">
              <a href={`/profesores/${prof.slug}`} class="teacher-card__link">
                {cleanFullName}
              </a>
            </h2>
            <p class="teacher-card__dept">{prof.department}</p>
            {prof.quote && (
              <p class="teacher-card__quote">"{prof.quote}"</p>
            )}
          </div>
          <div>
            <a href={`/profesores/${prof.slug}`} class="teacher-card__action">
              <span>Ver perfil completo</span>
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </a>
          </div>
        </div>
      </div>
    );
  })}
</div>

<style>
  .teachers-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr));
    gap: 16px;
  }
  @media (min-width: 640px) {
    .teachers-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 20px;
    }
  }

  .teacher-card {
    background: var(--sara-glass-strong, rgba(255, 255, 255, 0.88));
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid var(--sara-border-glass, rgba(26, 54, 122, 0.1));
    border-left: 3px solid var(--sara-sapphire-600, #224FA8);
    border-radius: var(--sara-radius-md, 12px);
    box-shadow: inset 0 1px 1px 0 var(--sara-rim-specular), var(--sara-shadow-glass-sm);
    padding: 16px;
    display: flex;
    flex-direction: row;
    gap: 12px;
    min-width: 0;
    max-width: 100%;
    box-sizing: border-box;
    transition: transform 150ms ease, border-color 150ms ease, box-shadow 150ms ease;
  }

  @media (min-width: 360px) {
    .teacher-card {
      padding: 20px;
      gap: 16px;
    }
  }

  .teacher-card:hover {
    transform: translateY(-2px);
    border-color: var(--sara-cyan-500, #1CB3CF);
    border-left-color: var(--sara-cyan-600, #159AB3);
    box-shadow: inset 0 1px 1px 0 var(--sara-rim-specular), var(--sara-shadow-glass-md);
  }

  .teacher-card__avatar-wrap {
    flex-shrink: 0;
  }

  .teacher-card__avatar {
    width: 64px;
    height: 64px;
    background: var(--sara-sapphire-50, #F2F6FF);
    border: 1px solid var(--sara-border-glass, rgba(26, 54, 122, 0.14));
    border-radius: var(--sara-radius-sm, 8px);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    position: relative;
    box-shadow: var(--sara-shadow-glass-sm);
  }

  @media (min-width: 360px) {
    .teacher-card__avatar {
      width: 72px;
      height: 72px;
    }
  }

  .teacher-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .teacher-card__initials {
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    background: var(--sara-sapphire-100, #E0EBFF);
    color: var(--sara-sapphire-700, #1A367A);
    font-weight: 800;
    font-size: 1.25rem;
    font-family: var(--font-display);
    text-transform: uppercase;
  }

  .teacher-card__body {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 10px;
  }

  .teacher-card__name {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 800;
    line-height: 1.2;
    margin-bottom: 4px;
    overflow-wrap: anywhere;
    word-break: normal;
  }

  .teacher-card__link {
    color: var(--sara-sapphire-950, #0A1329);
    text-decoration: none;
    transition: color 150ms ease;
  }

  .teacher-card__link:hover {
    color: var(--sara-cyan-600, #159AB3);
  }

  .teacher-card__dept {
    font-size: 0.75rem;
    color: var(--color-ink-2);
    line-height: 1.35;
    overflow-wrap: anywhere;
    word-break: normal;
  }

  .teacher-card__quote {
    font-size: 0.75rem;
    font-style: italic;
    color: var(--color-ink-3);
    border-left: 2px solid var(--sara-border-glass);
    padding-left: 10px;
    margin-top: 8px;
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .teacher-card__action {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--sara-sapphire-600, #224FA8);
    text-decoration: none;
    transition: color 150ms ease;
    min-height: 44px;
  }

  .teacher-card__action:hover {
    color: var(--sara-cyan-600, #159AB3);
    text-decoration: underline;
  }
</style>
