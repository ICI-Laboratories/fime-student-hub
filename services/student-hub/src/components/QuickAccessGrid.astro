---
// QuickAccessGrid.astro — Accesos rápidos a los servicios de StudentHUB con SARA Glass OS
interface QuickLink {
  title: string;
  badge: string;
  description: string;
  href: string;
  actionText: string;
  theme: "sapphire" | "cyan" | "jade" | "coral";
  iconSvg: string;
}

const quickLinks: QuickLink[] = [
  {
    title: "Horarios de Clase",
    badge: "HORARIO ACADÉMICO",
    description: "Consulta materias, aulas y horarios asignados por grupo y carrera en tiempo real.",
    href: "/studenthub",
    actionText: "Abrir Horario",
    theme: "sapphire",
    iconSvg: `<path d="M19 4H5C3.89543 4 3 4.89543 3 6V20C3 21.1046 3.89543 22 5 22H19C20.1046 22 21 21.1046 21 20V6C21 4.89543 20.1046 4 19 4Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><line x1="16" y1="2" x2="16" y2="6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><line x1="8" y1="2" x2="8" y2="6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><line x1="3" y1="10" x2="21" y2="10" stroke="currentColor" stroke-width="2"/>`,
  },
  {
    title: "Directorio de Profesores",
    badge: "DOCENTES E INVESTIGADORES",
    description: "Conoce la semblanza, publicaciones, cubículos y datos de contacto de la plantilla docente.",
    href: "/profesores?from=landing",
    actionText: "Explorar Docentes",
    theme: "cyan",
    iconSvg: `<path d="M20 21V19C20 17.9391 19.5786 16.9217 18.8284 16.1716C18.0783 15.4214 17.0609 15 16 15H8C6.93913 15 5.92172 15.4214 5.17157 16.1716C4.42143 16.9217 4 17.9391 4 19V21" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><circle cx="12" cy="7" r="4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>`,
  },
  {
    title: "Mapa de Instalaciones",
    badge: "ESPACIOS DEL CAMPUS",
    description: "Ubica con precisión edificios, aulas, talleres y laboratorios en el campus Coquimatlán.",
    href: "/mapa?from=landing",
    actionText: "Ver Campus",
    theme: "jade",
    iconSvg: `<polygon points="1 6 1 22 8 18 16 22 23 18 23 2 16 6 8 2 1 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><line x1="8" y1="2" x2="8" y2="18" stroke="currentColor" stroke-width="2"/><line x1="16" y1="6" x2="16" y2="22" stroke="currentColor" stroke-width="2"/>`,
  },
  {
    title: "Aplicaciones y Recursos",
    badge: "CATÁLOGO DIGITAL",
    description: "Herramientas de software, repositorios y recursos académicos oficiales de la facultad.",
    href: "/aplicaciones",
    actionText: "Ver Catálogo",
    theme: "coral",
    iconSvg: `<rect x="3" y="3" width="7" height="7" rx="1.5" stroke="currentColor" stroke-width="2"/><rect x="14" y="3" width="7" height="7" rx="1.5" stroke="currentColor" stroke-width="2"/><rect x="14" y="14" width="7" height="7" rx="1.5" stroke="currentColor" stroke-width="2"/><rect x="3" y="14" width="7" height="7" rx="1.5" stroke="currentColor" stroke-width="2"/>`,
  },
];
---

<section class="quick-access-section" aria-labelledby="quick-access-title">
  <div class="section-title-group">
    <div class="title-badge">
      <span class="pulse-dot"></span>
      <span class="badge-text">SERVICIOS ACADÉMICOS PÚBLICOS</span>
    </div>
    <h2 id="quick-access-title" class="section-heading">
      Servicios FIME en StudentHUB
    </h2>
    <p class="section-lead">
      Accede directamente a la información académica, docentes y espacios del campus Coquimatlán sin necesidad de iniciar sesión.
    </p>
  </div>

  <div class="quick-access-grid">
    {quickLinks.map((item) => (
      <a href={item.href} class={`quick-card quick-card--${item.theme}`}>
        <div class="quick-card__header">
          <div class={`quick-card__icon quick-card__icon--${item.theme}`} aria-hidden="true">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" set:html={item.iconSvg} />
          </div>
          <span class="quick-card__badge">{item.badge}</span>
        </div>

        <div class="quick-card__body">
          <h3 class="quick-card__title">{item.title}</h3>
          <p class="quick-card__desc">{item.description}</p>
        </div>

        <div class="quick-card__footer">
          <span class="quick-card__action">
            {item.actionText}
            <svg class="action-arrow" viewBox="0 0 20 20" width="16" height="16" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" d="M12.293 5.293a1 1 0 011.414 0l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-2.293-2.293a1 1 0 010-1.414z" clip-rule="evenodd" />
            </svg>
          </span>
        </div>
      </a>
    ))}
  </div>
</section>

<style>
  .quick-access-section {
    margin-top: 2rem;
    margin-bottom: 2rem;
    width: 100%;
  }

  .section-title-group {
    margin-bottom: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .title-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono, "JetBrains Mono", monospace);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    font-weight: 700;
    color: var(--sara-sapphire-600, #1A367A);
    text-transform: uppercase;
  }

  .pulse-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--sara-cyan-500, #159AB3);
    box-shadow: 0 0 0 2px rgba(21, 154, 179, 0.2);
  }

  .section-heading {
    font-family: var(--font-display, "Manrope", sans-serif);
    font-size: clamp(1.25rem, 2.5vw, 1.625rem);
    font-weight: 800;
    color: var(--sara-sapphire-950, #0E1A38);
    letter-spacing: -0.02em;
    line-height: 1.25;
    margin: 0;
  }

  .section-lead {
    font-size: 0.9375rem;
    color: var(--sara-text-secondary, #475569);
    margin: 0;
    max-width: 64ch;
    line-height: 1.5;
  }

  .quick-access-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.25rem;
  }

  /* Card styling with Glass OS */
  .quick-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 1.25rem;
    background: rgba(255, 255, 255, 0.88);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(226, 232, 240, 0.9);
    border-radius: var(--radius-xl, 1rem);
    text-decoration: none;
    color: inherit;
    box-shadow: 0 4px 16px -2px rgba(26, 54, 122, 0.05);
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1),
                box-shadow 0.2s cubic-bezier(0.16, 1, 0.3, 1),
                border-color 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    position: relative;
    overflow: hidden;
  }

  .quick-card::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: transparent;
    transition: background 0.2s ease;
  }

  .quick-card--sapphire::before { background: var(--sara-sapphire-600, #1A367A); }
  .quick-card--cyan::before { background: var(--sara-cyan-500, #159AB3); }
  .quick-card--jade::before { background: var(--sara-jade-500, #0E6B47); }
  .quick-card--coral::before { background: var(--sara-coral-500, #E65642); }

  .quick-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 28px -6px rgba(26, 54, 122, 0.12);
    border-color: rgba(26, 54, 122, 0.25);
  }

  .quick-card:focus-visible {
    outline: 2px solid var(--sara-sapphire-600, #1A367A);
    outline-offset: 2px;
  }

  .quick-card__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .quick-card__icon {
    width: 40px;
    height: 40px;
    border-radius: var(--radius-lg, 0.75rem);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: transform 0.2s ease;
  }

  .quick-card:hover .quick-card__icon {
    transform: scale(1.08);
  }

  .quick-card__icon--sapphire {
    background: rgba(26, 54, 122, 0.08);
    color: var(--sara-sapphire-600, #1A367A);
  }

  .quick-card__icon--cyan {
    background: rgba(21, 154, 179, 0.1);
    color: var(--sara-cyan-600, #0E7B91);
  }

  .quick-card__icon--jade {
    background: rgba(14, 107, 71, 0.1);
    color: var(--sara-jade-600, #0B5236);
  }

  .quick-card__icon--coral {
    background: rgba(230, 86, 66, 0.1);
    color: var(--sara-coral-600, #B83523);
  }

  .quick-card__badge {
    font-family: var(--font-mono, "JetBrains Mono", monospace);
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--sara-text-secondary, #64748B);
    text-transform: uppercase;
    text-align: right;
  }

  .quick-card__body {
    flex: 1;
    margin-bottom: 1rem;
  }

  .quick-card__title {
    font-family: var(--font-display, "Manrope", sans-serif);
    font-size: 1.0625rem;
    font-weight: 700;
    color: var(--sara-sapphire-950, #0E1A38);
    line-height: 1.3;
    margin: 0 0 0.375rem 0;
  }

  .quick-card__desc {
    font-size: 0.84375rem;
    color: var(--sara-text-secondary, #475569);
    line-height: 1.45;
    margin: 0;
  }

  .quick-card__footer {
    padding-top: 0.75rem;
    border-top: 1px solid rgba(226, 232, 240, 0.7);
  }

  .quick-card__action {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-family: var(--font-display, "Manrope", sans-serif);
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--sara-sapphire-700, #142B63);
    transition: gap 0.2s ease, color 0.2s ease;
  }

  .action-arrow {
    transition: transform 0.2s ease;
  }

  .quick-card:hover .quick-card__action {
    color: var(--sara-sapphire-900, #0E1A38);
    gap: 0.5rem;
  }

  .quick-card:hover .action-arrow {
    transform: translateX(3px);
  }

  /* Mobile Optimization */
  @media (max-width: 640px) {
    .quick-access-section {
      margin-top: 1.5rem;
      margin-bottom: 1.5rem;
    }

    .quick-access-grid {
      grid-template-columns: 1fr;
      gap: 0.875rem;
    }

    .quick-card {
      padding: 1rem;
      border-radius: var(--radius-lg, 0.75rem);
    }

    .quick-card__header {
      margin-bottom: 0.625rem;
    }

    .quick-card__icon {
      width: 34px;
      height: 34px;
    }

    .quick-card__title {
      font-size: 1rem;
    }

    .quick-card__desc {
      font-size: 0.8125rem;
    }

    .quick-card__footer {
      padding-top: 0.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .quick-card,
    .quick-card__icon,
    .quick-card__action,
    .action-arrow {
      transition: none;
    }

    .quick-card:hover {
      transform: none;
    }

    .quick-card:hover .action-arrow {
      transform: none;
    }
  }
</style>
