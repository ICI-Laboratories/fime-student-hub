---
interface Props {
  fullName: string;
  title: string;
  department: string;
  institutionalEmail: string;
  admissionYear: number;
  photoUrl?: string;
}

const {
  fullName,
  title,
  department,
  institutionalEmail,
  admissionYear,
  photoUrl
} = Astro.props;

// Calcular años de antigüedad
const currentYear = new Date().getFullYear();
const yearsOfService = currentYear - admissionYear;
---

<div class="identity-card">
  <!-- Foto de perfil -->
  <div class="identity-card__photo-frame">
    {photoUrl ? (
      <img
        src={photoUrl}
        alt={`Fotografía de ${fullName}`}
        loading="lazy"
        width="300"
        height="300"
        class="w-full h-full object-cover"
        onerror="this.style.display='none'; if(this.nextElementSibling) this.nextElementSibling.classList.remove('hidden');"
      />
    ) : null}
    <div class={`w-full h-full ${photoUrl ? 'hidden' : 'flex'} items-center justify-center bg-[#E0EBFF] text-[#1A367A] font-black text-4xl select-none font-mono uppercase`}>
      {(fullName || '').replace(/^(dr\.|dra\.|mtro\.|mtra\.|lic\.|ing\.|arq\.)\s*/i, '').split(/\s+/).filter(Boolean).map(n => n[0]).slice(0, 2).join('')}
    </div>
  </div>

  <!-- Identidad -->
  <div class="text-left mb-6">
    <h1 class="text-xl sm:text-2xl font-black text-ink leading-tight tracking-tight">
      {fullName}
    </h1>
    <span class="overline overline--primary mt-2">
      {title}
    </span>
  </div>

  <hr class="rule" style="margin: 20px 0;" />

  <!-- Detalles -->
  <dl class="space-y-4 text-left">
    {department && (
      <div>
        <dt class="field-label">Adscripción</dt>
        <dd class="field-value">{department}</dd>
      </div>
    )}
    {institutionalEmail && (
      <div>
        <dt class="field-label">Contacto</dt>
        <dd>
          <a href={`mailto:${institutionalEmail}`} class="link field-value font-mono" style="font-size: 0.8125rem;">
            {institutionalEmail}
          </a>
        </dd>
      </div>
    )}
    {admissionYear && (
      <div>
        <dt class="field-label">Año de Ingreso</dt>
        <dd class="field-value font-mono">
          {admissionYear} <span class="font-sans text-xs text-ink-3 font-normal ml-1">({yearsOfService} años de antigüedad)</span>
        </dd>
      </div>
    )}
  </dl>
</div>

<style>
  .identity-card {
    padding: 8px 0;
  }
  .identity-card__photo-frame {
    margin-bottom: 24px;
    width: 100%;
    aspect-ratio: 1 / 1;
    border: 1px solid var(--sara-border-glass, rgba(26, 54, 122, 0.14));
    border-radius: var(--sara-radius-md, 12px);
    overflow: hidden;
    position: relative;
    background: var(--sara-sapphire-50, #F2F6FF);
    box-shadow: inset 0 1px 1px 0 var(--sara-rim-specular), var(--sara-shadow-glass-sm);
    display: flex;
    align-items: center;
    justify-content: center;
  }
</style>
