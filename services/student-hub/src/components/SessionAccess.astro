---
const destination = Astro.url.pathname + Astro.url.search;
const loginUrl = `/session/login?${new URLSearchParams({ return_to: destination })}`;
---
<section class="sara-access" data-sara-session aria-label="Cuenta SARA">
  <div class="sara-access__badge" aria-hidden="true">
    <img src="/vectors/logos/fime_escudo_ucol.svg" alt="" width="14" height="14" />
  </div>
  <p class="sara-access__status" data-sara-status role="status" aria-live="polite">Acceso libre · Cuenta SARA opcional</p>
  <div class="sara-access__actions">
    <a href={loginUrl} data-sara-access-link>Iniciar sesión</a>
    <button type="button" data-sara-logout hidden>Cerrar sesión</button>
    <button type="button" data-sara-retry hidden>Reintentar</button>
  </div>
</section>
<script>
  import { setupSessionAccess } from '../lib/session-access';
  setupSessionAccess();
  document.addEventListener('astro:page-load', setupSessionAccess);
</script>
<style>
  .sara-access {
    max-width: 1280px;
    margin: 0 auto;
    padding: 4px 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px 16px;
    border-top: 1px solid var(--sara-border-subtle, rgba(26, 54, 122, 0.08));
    background: var(--sara-glass-base, rgba(255, 255, 255, 0.6));
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }
  .sara-access__badge {
    display: flex;
    align-items: center;
    opacity: 0.85;
    flex-shrink: 0;
  }
  .sara-access__status {
    margin: 0;
    min-width: 0;
    flex: 1;
    font-size: 0.75rem;
    line-height: 1.4;
    color: var(--sara-text-secondary, #475569);
    overflow-wrap: anywhere;
  }
  .sara-access__actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    flex-wrap: wrap;
    gap: 4px 12px;
    flex-shrink: 0;
  }
  a, button {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    padding: 4px 0;
    background: none;
    border: 0;
    color: var(--sara-sapphire-600, #224FA8);
    font-family: var(--sara-font-ui, "Inter", sans-serif);
    font-size: 0.75rem;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
    transition: color 150ms ease;
  }
  a:hover, button:hover {
    color: var(--sara-cyan-600, #159AB3);
  }
  button:disabled {
    opacity: 0.65;
    cursor: wait;
  }
  a:focus-visible, button:focus-visible {
    outline: 2px solid var(--sara-cyan-500, #1CB3CF);
    outline-offset: 4px;
    border-radius: 4px;
  }
  [hidden] {
    display: none !important;
  }
  @media (max-width: 640px) {
    .sara-access {
      padding: 4px 16px;
      gap: 2px 10px;
    }
    .sara-access__badge {
      display: none;
    }
    .sara-access__status {
      font-size: 0.6875rem;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
  }
</style>
