---
interface Slide {
  image: string;
  alt: string;
  tag: string;
  title: string;
  description: string;
}

const slides: Slide[] = [
  {
    image: "/img/ActividadesRecre2.jpg",
    alt: "Profesores en actividades recreativas",
    tag: "COMUNIDAD DOCENTE",
    title: "Profesores en actividades recreativas",
    description: "Fortaleciendo el trabajo en equipo y creando vínculos que enriquecen el ambiente académico.",
  },
  {
    image: "/img/ActividadesRecre.jpg",
    alt: "Comunidad estudiantil",
    tag: "VIDA ESTUDIANTIL",
    title: "Estudiantes en actividades recreativas",
    description: "Fomentando la integración y el desarrollo personal en un entorno dinámico y colaborativo.",
  },
  {
    image: "/img/AExtra.jpg",
    alt: "Visita industrial",
    tag: "VINCULACIÓN INDUSTRIAL",
    title: "Visita Industrial: Aprendizaje en el Campo",
    description: "Conectando la teoría con la práctica en experiencias de campo que preparan para la industria real.",
  },
  {
    image: "/img/chacuaco.jpg",
    alt: "El Chacuaco FIME",
    tag: "IDENTIDAD FIME",
    title: "El Emblemático Chacuaco: Orgullo Institucional",
    description: "Representando nuestra tradición e identidad, un icono que inspira a nuestra comunidad educativa.",
  },
  {
    image: "/img/cursos.jpg",
    alt: "Cursos y capacitación",
    tag: "FORMACIÓN CONTINUA",
    title: "Cursos y Capacitación para Alumnos",
    description: "Actualización constante en áreas tecnológicas de vanguardia.",
  },
  {
    image: "/img/cursos2.jpg",
    alt: "Laboratorios de hidráulica",
    tag: "LABORATORIOS FIME",
    title: "Hidráulica en Acción: Infraestructura Práctica",
    description: "Espacios de experimentación donde se aplican criterios técnicos a proyectos reales.",
  },
  {
    image: "/img/labBrenda.jpg",
    alt: "Laboratorio de Cómputo",
    tag: "CENTRO DE CÓMPUTO",
    title: "Desarrollo de Software e Inteligencia Artificial",
    description: "Equipamiento moderno para desarrollo de proyectos computacionales avanzados.",
  },
  {
    image: "/img/labIsaac.jpg",
    alt: "Laboratorio de Electrónica",
    tag: "AUTOMATIZACIÓN",
    title: "Laboratorio de Electrónica y Mecatrónica",
    description: "Instalaciones para diseño, prototipado y pruebas de circuitos y sistemas mecánicos.",
  },
];
---

<section class="carousel-section" aria-labelledby="campus-gallery-title" aria-roledescription="carrusel">
  <div class="carousel-header">
    <h2 id="campus-gallery-title" class="carousel-heading">
      <span class="overline overline--primary">GALERÍA DE LA FACULTAD</span>
      Vida y Espacios en la FIME
    </h2>
    <button type="button" class="carousel-playback" id="toggle-carousel" aria-controls="campus-slides" hidden>
      Pausar imágenes
    </button>
  </div>

  <div class="carousel-viewport">
    <div class="carousel" id="campus-slides">
      {slides.map((slide, index) => (
        <div
          class="slide"
          role="group"
          aria-roledescription="diapositiva"
          aria-label={`${index + 1} de ${slides.length}`}
          aria-hidden={index === 0 ? "false" : "true"}
          inert={index === 0 ? undefined : true}
        >
          <img src={slide.image} alt={slide.alt} loading={index === 0 ? "eager" : "lazy"} />
          <div class="slide-scrim">
            <div class="slide-text">
              <span class="slide-tag">{slide.tag}</span>
              <h3>{slide.title}</h3>
              <p>{slide.description}</p>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Controles de navegación de carrusel -->
    <div class="carousel-nav" aria-label="Controles del carrusel">
      <button type="button" class="btn-nav" id="prev-slide" aria-label="Imagen anterior" hidden>
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>

      <div class="carousel-status" aria-live="off" hidden>
        <span class="carousel-count" data-carousel-count>1 de {slides.length}</span>
        <span class="visually-hidden" data-carousel-announcement>Imagen 1 de {slides.length}</span>
      </div>

      <button type="button" class="btn-nav" id="next-slide" aria-label="Siguiente imagen" hidden>
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>
    </div>
  </div>
</section>

<script>
  function initCarousel() {
    const root = document.querySelector(".carousel-section") as HTMLElement;
    if (!root) return;

    const track = root.querySelector(".carousel") as HTMLElement;
    const slides = [...root.querySelectorAll(".slide")] as HTMLElement[];
    const previous = root.querySelector("#prev-slide") as HTMLButtonElement;
    const next = root.querySelector("#next-slide") as HTMLButtonElement;
    const playback = root.querySelector("#toggle-carousel") as HTMLButtonElement;
    const status = root.querySelector(".carousel-status") as HTMLElement;

    if (!track || !slides.length || !previous || !next || !playback || !status) return;

    const motionQuery = window.matchMedia("(prefers-reduced-motion: reduce)");
    let currentIndex = 0;
    let playing = !motionQuery.matches && slides.length > 1;
    let timer: number | null = null;
    let pointerWasPlaying: boolean | undefined;

    function showSlide(index: number) {
      currentIndex = (index + slides.length) % slides.length;
      track.style.transform = `translateX(-${currentIndex * 100}%)`;
      slides.forEach((slide, slideIndex) => {
        const inactive = slideIndex !== currentIndex;
        slide.setAttribute("aria-hidden", String(inactive));
        slide.toggleAttribute("inert", inactive);
        slide.setAttribute("aria-label", `${slideIndex + 1} de ${slides.length}`);
      });
      const countEl = status.querySelector("[data-carousel-count]");
      if (countEl) countEl.textContent = `${currentIndex + 1} de ${slides.length}`;
      const title = slides[currentIndex].querySelector("h3")?.textContent || "";
      const announceEl = status.querySelector("[data-carousel-announcement]");
      if (announceEl) announceEl.textContent = `Imagen ${currentIndex + 1} de ${slides.length}: ${title}`;
    }

    function syncRotation() {
      if (timer !== null) {
        clearInterval(timer);
        timer = null;
      }
      const rotating = playing && !document.hidden;
      playback.textContent = playing ? "Pausar imágenes" : "Reproducir imágenes";
      status.setAttribute("aria-live", rotating ? "off" : "polite");
      if (rotating) {
        timer = window.setInterval(() => showSlide(currentIndex + 1), 5000);
      }
    }

    function pause() {
      playing = false;
      syncRotation();
    }

    previous.addEventListener("click", () => {
      pause();
      showSlide(currentIndex - 1);
    });

    next.addEventListener("click", () => {
      pause();
      showSlide(currentIndex + 1);
    });

    root.addEventListener("focusin", pause);
    playback.addEventListener("pointerdown", () => { pointerWasPlaying = playing; });
    playback.addEventListener("click", (event) => {
      const wasPlaying = event.detail > 0 && pointerWasPlaying !== undefined ? pointerWasPlaying : playing;
      pointerWasPlaying = undefined;
      playing = !wasPlaying && slides.length > 1;
      syncRotation();
    });

    motionQuery.addEventListener("change", pause);
    document.addEventListener("visibilitychange", syncRotation);

    showSlide(0);
    if (slides.length > 1) {
      previous.hidden = false;
      next.hidden = false;
      playback.hidden = false;
      status.hidden = false;
    }
    syncRotation();
  }

  initCarousel();
  document.addEventListener("astro:page-load", initCarousel);
</script>

<style>
  .carousel-section {
    position: relative;
    border-radius: var(--sara-radius-lg, 16px);
    background: var(--sara-glass-strong, rgba(255, 255, 255, 0.9));
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid var(--sara-border-glass, rgba(26, 54, 122, 0.12));
    box-shadow: inset 0 1px 1px 0 var(--sara-rim-specular, rgba(255, 255, 255, 0.8)), var(--sara-shadow-glass-md, 0 8px 32px rgba(10, 19, 41, 0.08));
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .carousel-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16px 20px 12px;
    border-bottom: 1px solid var(--sara-border-subtle, rgba(26, 54, 122, 0.06));
  }

  .carousel-heading {
    font-family: var(--font-display, "Manrope", sans-serif);
    font-size: 1.0625rem;
    font-weight: 800;
    color: var(--sara-sapphire-950, #0A1329);
    margin: 0;
    line-height: 1.25;
  }

  .carousel-playback {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--sara-sapphire-600, #224FA8);
    background: var(--sara-sapphire-50, #F2F6FF);
    border: 1px solid var(--sara-border-glass, rgba(26, 54, 122, 0.1));
    border-radius: var(--sara-radius-pill, 9999px);
    padding: 6px 12px;
    cursor: pointer;
    min-height: 36px;
    transition: all 150ms ease;
  }

  .carousel-playback:hover {
    background: var(--color-surface, #FFFFFF);
    color: var(--sara-cyan-600, #159AB3);
  }

  .carousel-viewport {
    position: relative;
    overflow: hidden;
    width: 100%;
    flex: 1;
    min-height: 320px;
  }

  .carousel {
    display: flex;
    width: 100%;
    height: 100%;
    transition: transform 400ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .slide {
    flex: 0 0 100%;
    position: relative;
    height: 100%;
    min-height: 320px;
    overflow: hidden;
  }

  .slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .slide-scrim {
    position: absolute;
    inset: auto 0 0 0;
    background: linear-gradient(180deg, transparent 0%, rgba(10, 19, 41, 0.45) 30%, rgba(10, 19, 41, 0.9) 100%);
    padding: 32px 20px 20px;
    color: #FFFFFF;
  }

  .slide-text {
    max-width: 600px;
  }

  .slide-tag {
    display: inline-block;
    font-family: var(--font-mono, monospace);
    font-size: 0.625rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    color: var(--sara-cyan-400, #3EDBF0);
    text-transform: uppercase;
    margin-bottom: 4px;
  }

  .slide-text h3 {
    font-family: var(--font-display, "Manrope", sans-serif);
    font-size: 1.125rem;
    font-weight: 800;
    color: #FFFFFF;
    margin: 0 0 6px 0;
    line-height: 1.3;
  }

  .slide-text p {
    font-size: 0.8125rem;
    line-height: 1.45;
    color: rgba(255, 255, 255, 0.88);
    margin: 0;
  }

  .carousel-nav {
    position: absolute;
    top: 14px;
    right: 14px;
    display: flex;
    align-items: center;
    gap: 8px;
    background: rgba(10, 19, 41, 0.65);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: var(--sara-radius-pill, 9999px);
    padding: 4px 8px;
    color: #FFFFFF;
    z-index: 5;
  }

  .btn-nav {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    color: #FFFFFF;
    background: rgba(255, 255, 255, 0.12);
    border: none;
    cursor: pointer;
    transition: background 150ms ease;
  }

  .btn-nav:hover {
    background: rgba(255, 255, 255, 0.28);
  }

  .carousel-status {
    font-family: var(--font-mono, monospace);
    font-size: 0.6875rem;
    font-weight: 700;
    padding: 0 4px;
    color: rgba(255, 255, 255, 0.9);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 768px) {
    .carousel-section {
      border-radius: var(--sara-radius-md, 12px);
    }
    .carousel-viewport {
      min-height: 220px;
      height: 220px;
    }
    .slide {
      min-height: 220px;
    }
    .slide-text h3 {
      font-size: 0.9375rem;
      margin-bottom: 4px;
    }
    .slide-text p {
      font-size: 0.75rem;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .slide-scrim {
      padding: 24px 14px 14px;
    }
  }
</style>
