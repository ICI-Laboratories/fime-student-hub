---
interface Article {
  title: string;
  journal: string;
  year: number;
  impactFactor: number | null;
  doi: string | null;
}

interface Book {
  title: string;
  role: string;
  editorial: string;
  year: number;
}

interface Props {
  articles: Article[];
  books: Book[];
}

const { articles = [], books = [] } = Astro.props;

// Combinar artículos y libros en una sola lista cronológica para la vitrina y búsqueda
const allPubs = [
  ...articles.map(art => ({ ...art, type: 'article' as const })),
  ...books.map(bk => ({ ...bk, type: 'book' as const }))
].sort((a, b) => b.year - a.year);
---

<div class="space-y-6">
  
  <!-- Buscador e Interfaz de Filtros -->
  <div class="space-y-4">
    <label for="pub-search" class="field-label">Buscar publicaciones</label>
    <input 
      type="search"
      id="pub-search" 
      disabled={allPubs.length === 0}
      aria-controls="publications-list"
      placeholder="Buscar por título, revista, editorial o año..." 
      class="w-full h-11 bg-ground border border-rule px-3.5 rounded-xl text-sm font-sans text-ink focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 placeholder:text-ink-3 transition-all"
    />
    <div class="flex flex-wrap items-center gap-2 sm:gap-4">
      <span class="field-label" style="margin-bottom: 0;">Filtrar:</span>
      <button 
        class="filter-btn font-mono text-2xs uppercase tracking-wider font-black text-ink min-h-[44px] px-3 inline-flex items-center border-b-2 border-primary cursor-pointer transition-all"
        data-filter="all"
        aria-pressed="true"
      >
        Todos
      </button>
      <button 
        class="filter-btn font-mono text-2xs uppercase tracking-wider font-bold text-ink-3 min-h-[44px] px-3 inline-flex items-center border-b-2 border-transparent cursor-pointer transition-all hover:text-ink"
        data-filter="article"
        aria-pressed="false"
      >
        Artículos
      </button>
      <button 
        class="filter-btn font-mono text-2xs uppercase tracking-wider font-bold text-ink-3 min-h-[44px] px-3 inline-flex items-center border-b-2 border-transparent cursor-pointer transition-all hover:text-ink"
        data-filter="book"
        aria-pressed="false"
      >
        Libros
      </button>
    </div>
  </div>
  <p id="publication-status" role="status" aria-live="polite" aria-atomic="true" class="text-xs text-ink-3">
    {allPubs.length ? `${allPubs.length} publicaciones registradas.` : 'No hay publicaciones registradas en este directorio.'}
  </p>

  <!-- Contenedor Principal de Publicaciones (Lista bibliográfica suiza) -->
  <div id="publications-list" class="space-y-6">
    {allPubs.map(pub => (
      <div 
        class="pub-item border-b border-rule pb-6 flex flex-col md:flex-row md:items-start gap-4"
        data-title={String(pub.title || '')}
        data-type={pub.type}
        data-journal={String(pub.type === 'article' ? pub.journal || '' : pub.editorial || '')}
        data-year={String(pub.year || '')}
      >
        <!-- Año y Tipo -->
        <div class="w-24 shrink-0 flex items-center md:flex-col md:items-start gap-2">
          <span class="font-mono text-xs font-black text-primary">
            [{pub.year}]
          </span>
          <span class="tag">
            {pub.type === 'article' ? 'Artículo' : 'Libro'}
          </span>
        </div>
        
        <!-- Contenido Ficha -->
        <div class="flex-1 min-w-0">
          <h4 class="text-base font-bold text-ink leading-snug mb-1">
            {pub.type === 'article' ? `“${pub.title}”` : pub.title}
          </h4>
          <p class="text-xs text-ink-2 leading-relaxed">
            {pub.type === 'article' ? (
              <span>{pub.journal ? <>Publicado en <span class="italic font-medium">{pub.journal}</span>.</> : 'Revista no registrada.'}</span>
            ) : (
              <span>{pub.editorial ? <>Libro publicado por <span class="italic font-medium">{pub.editorial}</span>.</> : 'Editorial no registrada.'}{pub.role && <> Rol: {pub.role}.</>}</span>
            )}
          </p>
          
          <div class="mt-2.5 flex items-center gap-4 text-2xs font-mono">
            {pub.type === 'article' && pub.impactFactor && (
              <span class="tag tag--primary">FI {pub.impactFactor}</span>
            )}
            {pub.doi && (
              <a href={pub.doi} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-xs text-primary hover:text-sapphire-300 font-medium transition-colors">
                <span>DOI / Enlace</span>
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
              </a>
            )}
          </div>
        </div>
      </div>
    ))}

    <div 
      id="no-resultados" 
      class="hidden text-center py-12 text-xs italic text-ink-3 bg-muted"
    >
      <p>No se encontraron publicaciones que coincidan con los filtros de búsqueda.</p>
      <button id="publication-clear" type="button" class="btn" style="margin-top: 12px;">Limpiar filtros</button>
    </div>
  </div>

</div>

<!-- Script de filtrado interactivo -->
<script>
  function initFilters() {
    const searchInput = document.getElementById('pub-search') as HTMLInputElement | null;
    const filterBtns = document.querySelectorAll('.filter-btn');
    const publicationsList = document.getElementById('publications-list');
    const noResultados = document.getElementById('no-resultados');
    const status = document.getElementById('publication-status');

    if (!searchInput || !publicationsList || searchInput.dataset.ready) return;
    searchInput.dataset.ready = 'true';

    let activeFilter = 'all';
    const normalize = (value: string) => value.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLocaleLowerCase('es').trim();

    function filterPublications() {
      const terms = normalize(searchInput!.value).split(/\s+/).filter(Boolean);
      const items = publicationsList.querySelectorAll('.pub-item');
      let matchesCount = 0;

      items.forEach((item: any) => {
        const title = item.getAttribute('data-title') || '';
        const journal = item.getAttribute('data-journal') || '';
        const year = item.getAttribute('data-year') || '';
        const type = item.getAttribute('data-type') || '';

        const text = normalize(`${title} ${journal} ${year}`);
        const matchesSearch = terms.every(term => text.includes(term));
        const matchesType = activeFilter === 'all' || type === activeFilter;

        if (matchesSearch && matchesType) {
          item.style.display = 'flex';
          matchesCount++;
        } else {
          item.style.display = 'none';
        }
      });

      // Validar si hubo coincidencias
      if (status && items.length) status.textContent = `${matchesCount} de ${items.length} publicaciones coinciden.`;
      if (matchesCount === 0 && items.length > 0) {
        noResultados?.classList.remove('hidden');
      } else {
        noResultados?.classList.add('hidden');
      }
    }

    searchInput.addEventListener('input', filterPublications);

    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        filterBtns.forEach(b => {
          b.classList.remove('border-primary', 'font-black', 'text-ink');
          b.classList.add('border-transparent', 'font-bold', 'text-ink-3');
          b.setAttribute('aria-pressed', 'false');
        });

        btn.classList.add('border-primary', 'font-black', 'text-ink');
        btn.classList.remove('border-transparent', 'font-bold', 'text-ink-3');
        btn.setAttribute('aria-pressed', 'true');

        activeFilter = btn.getAttribute('data-filter') || 'all';
        filterPublications();
      });
    });
    document.getElementById('publication-clear')?.addEventListener('click', () => {
      searchInput.value = '';
      (document.querySelector('[data-filter="all"]') as HTMLButtonElement)?.click();
      searchInput.focus();
    });
    filterPublications();
  }

  // Ejecutar en carga de página y transiciones Astro
  initFilters();
  document.addEventListener('astro:page-load', initFilters);
</script>
