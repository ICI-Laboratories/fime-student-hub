---
// CampusTransformContainer.astro — Contenedor interactivo transformable con Carrusel 16:9 y FimeBot animado con View Transitions API y Web Components nativos de Astro
interface Slide {
  image: string;
  alt: string;
  tag: string;
  title: string;
  description: string;
}

const slides: Slide[] = [
  {
    image: "/img/ActividadesRecre2.jpg",
    alt: "Profesores en actividades recreativas",
    tag: "COMUNIDAD DOCENTE",
    title: "Profesores en actividades recreativas",
    description: "Fortaleciendo el trabajo en equipo y creando vínculos que enriquecen el ambiente académico.",
  },
  {
    image: "/img/ActividadesRecre.jpg",
    alt: "Comunidad estudiantil",
    tag: "VIDA ESTUDIANTIL",
    title: "Estudiantes en actividades recreativas",
    description: "Fomentando la integración y el desarrollo personal en un entorno dinámico y colaborativo.",
  },
  {
    image: "/img/AExtra.jpg",
    alt: "Visita industrial",
    tag: "VINCULACIÓN INDUSTRIAL",
    title: "Visita Industrial: Aprendizaje en el Campo",
    description: "Conectando la teoría con la práctica en experiencias de campo que preparan para la industria real.",
  },
  {
    image: "/img/chacuaco.jpg",
    alt: "El Chacuaco FIME",
    tag: "IDENTIDAD FIME",
    title: "El Emblemático Chacuaco: Orgullo Institucional",
    description: "Representando nuestra tradición e identidad, un icono que inspira a nuestra comunidad educativa.",
  },
  {
    image: "/img/cursos.jpg",
    alt: "Cursos y capacitación",
    tag: "FORMACIÓN CONTINUA",
    title: "Cursos y Capacitación para Alumnos",
    description: "Actualización constante en áreas tecnológicas de vanguardia.",
  },
  {
    image: "/img/cursos2.jpg",
    alt: "Laboratorios de hidráulica",
    tag: "LABORATORIOS FIME",
    title: "Hidráulica en Acción: Infraestructura Práctica",
    description: "Espacios de experimentación donde se aplican criterios técnicos a proyectos reales.",
  },
  {
    image: "/img/labBrenda.jpg",
    alt: "Laboratorio de Cómputo",
    tag: "CENTRO DE CÓMPUTO",
    title: "Desarrollo de Software e Inteligencia Artificial",
    description: "Equipamiento moderno para desarrollo de proyectos computacionales avanzados.",
  },
  {
    image: "/img/labIsaac.jpg",
    alt: "Laboratorio de Electrónica",
    tag: "AUTOMATIZACIÓN",
    title: "Laboratorio de Electrónica y Mecatrónica",
    description: "Instalaciones para diseño, prototipado y pruebas de circuitos y sistemas mecánicos.",
  },
];
---

<fime-campus-stage class="transform-container show-chat" id="transform-container">
  <!-- Sección del Carrusel (Aspect Ratio 16:9 Adaptativo) -->
  <section class="carousel-section" aria-labelledby="campus-gallery-title" aria-roledescription="carrusel">
    <h2 class="visually-hidden" id="campus-gallery-title">La vida en la FIME</h2>
    <button type="button" class="carousel-playback visually-hidden" id="toggle-carousel" aria-controls="campus-slides">
      Pausar imágenes
    </button>

    <div class="carousel" id="campus-slides">
      {slides.map((slide, index) => (
        <div
          class="slide"
          role="group"
          aria-roledescription="diapositiva"
          aria-label={`${index + 1} de ${slides.length}`}
          aria-hidden={index === 0 ? "false" : "true"}
          inert={index === 0 ? undefined : true}
        >
          <img src={slide.image} alt={slide.alt} loading={index === 0 ? "eager" : "lazy"} />
          <div class="slide-text">
            <span class="slide-overline">{slide.tag}</span>
            <h3>{slide.title}</h3>
            <p>{slide.description}</p>
          </div>
        </div>
      ))}
    </div>

    <!-- Controles Glass del Carrusel -->
    <button type="button" class="carousel-control prev" id="prev-slide" aria-label="Imagen anterior" aria-controls="campus-slides" hidden>
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polyline points="15 18 9 12 15 6"></polyline>
      </svg>
    </button>
    <button type="button" class="carousel-control next" id="next-slide" aria-label="Siguiente imagen" aria-controls="campus-slides" hidden>
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polyline points="9 18 15 12 9 6"></polyline>
      </svg>
    </button>

    <p class="carousel-status" aria-live="off" aria-atomic="true" hidden>
      <span data-carousel-count aria-hidden="true">1 de {slides.length}</span>
      <span class="visually-hidden" data-carousel-announcement></span>
    </p>
  </section>

  <!-- Sección del Chatbot FimeBot (Animado con Glass OS) -->
  <section class="chat-section" id="fimebot-chat" aria-label="Asistente FimeBot" tabindex="-1">
    <div class="chat-header">
      <div class="chat-header-brand">
        <span class="chat-header-avatar" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none">
            <path d="M4 12C4 7.58 7.58 4 12 4C16.42 4 20 7.58 20 12C20 16.42 16.42 20 12 20H5.5C4.67 20 4 19.33 4 18.5V12Z" fill="currentColor" fill-opacity="0.16" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round"/>
            <path d="M12 8L13.1 10.9L16 12L13.1 13.1L12 16L10.9 13.1L8 12L10.9 10.9L12 8Z" fill="#E65642" stroke="#E65642" stroke-width="1.1" stroke-linejoin="round"/>
          </svg>
        </span>
        <div class="chat-header-info">
          <span class="overline-secondary">ASISTENTE ESTUDIANTIL FIME</span>
          <div class="chat-title-group">
            <h2>FimeBot</h2>
            <span class="online-pill">
              <span class="online-dot"></span> En línea
            </span>
          </div>
        </div>
      </div>
      <button type="button" id="close-chat-btn" aria-label="Cerrar ventana de chat">
        <span class="close-chat-label">Cerrar</span>
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <div class="chat-content">
      <ul class="chatbox" role="log" aria-live="polite" aria-relevant="additions text" aria-label="Conversación con FimeBot">
        <li class="chat incoming">
          <span class="chat-avatar" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none">
              <path d="M4 12C4 7.58 7.58 4 12 4C16.42 4 20 7.58 20 12C20 16.42 16.42 20 12 20H5.5C4.67 20 4 19.33 4 18.5V12Z" fill="currentColor" fill-opacity="0.16" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round"/>
              <path d="M12 8L13.1 10.9L16 12L13.1 13.1L12 16L10.9 13.1L8 12L10.9 10.9L12 8Z" fill="#E65642" stroke="#E65642" stroke-width="1.1" stroke-linejoin="round"/>
            </svg>
          </span>
          <div class="chat-bubble">
            <p>¡Hola! Soy <strong>FimeBot</strong>. Te oriento sobre la FIME: carreras, admisión, becas, trámites y espacios del campus Coquimatlán.</p>
            <p>Selecciona un tema rápido o escribe tu pregunta abajo.</p>
          </div>
        </li>
      </ul>
    </div>

    <!-- Preguntas Frecuentes / Chips -->
    <div class="chat-suggestions" aria-label="Consultas frecuentes">
      <button type="button" data-question="¿Qué carreras ofrece la FIME?">Carreras</button>
      <button type="button" data-question="¿Cómo ingreso a la FIME?">Admisión</button>
      <button type="button" data-question="¿Qué becas puedo solicitar?">Becas</button>
      <button type="button" data-question="¿Dónde está la FIME y cómo contacto a la facultad?">Ubicación y contacto</button>
    </div>

    <!-- Entrada de Texto con envío Fitts-compliant -->
    <div class="chat-composer">
      <div class="chat-input">
        <textarea
          placeholder="Escribe tu duda sobre la FIME…"
          aria-label="Mensaje para FimeBot"
          aria-describedby="chat-scope"
          maxlength="1200"
          rows="1"
          id="chat-textarea"
        ></textarea>
        <button type="button" class="btn-send" id="send-btn" aria-label="Enviar mensaje a FimeBot">
          <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="22" y1="2" x2="11" y2="13"></line>
            <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
          </svg>
        </button>
      </div>
      <p class="chat-scope" id="chat-scope">Orientación estudiantil sobre la FIME · Respuestas basadas en documentación de UCOL.</p>
    </div>
  </section>
</fime-campus-stage>

<script>
  // Web Component Nativo de Astro: Encapsulamiento, ciclo de vida limpio y soporte View Transitions
  class FimeCampusStage extends HTMLElement {
    private abortController: AbortController | null = null;
    private timer: number | null = null;
    private currentIndex = 0;
    private isPlaying = false;
    private isSending = false;
    private chatHistory: { role: string; content: string }[] = [];

    connectedCallback() {
      this.init();
    }

    disconnectedCallback() {
      this.cleanup();
    }

    private cleanup() {
      document.body.classList.remove("fimebot-mobile-open");
      if (this.abortController) {
        this.abortController.abort();
        this.abortController = null;
      }
      if (this.timer !== null) {
        clearInterval(this.timer);
        this.timer = null;
      }
    }

    private init() {
      this.cleanup();
      this.abortController = new AbortController();
      const signal = this.abortController.signal;

      // Elementos del Carrusel
      const track = this.querySelector(".carousel") as HTMLElement | null;
      const slides = Array.from(this.querySelectorAll(".slide")) as HTMLElement[];
      const prevBtn = this.querySelector("#prev-slide") as HTMLButtonElement | null;
      const nextBtn = this.querySelector("#next-slide") as HTMLButtonElement | null;
      const playbackBtn = this.querySelector("#toggle-carousel") as HTMLButtonElement | null;
      const statusElem = this.querySelector(".carousel-status") as HTMLElement | null;

      const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      this.isPlaying = !prefersReducedMotion && slides.length > 1;

      // Web Animations API (WAAPI) para el carrusel de imágenes
      const showSlide = (index: number, animate = true) => {
        if (!track || !slides.length) return;
        const oldIndex = this.currentIndex;
        this.currentIndex = (index + slides.length) % slides.length;

        if (animate && !prefersReducedMotion && typeof track.animate === "function") {
          track.animate(
            [
              { transform: `translateX(-${oldIndex * 100}%)` },
              { transform: `translateX(-${this.currentIndex * 100}%)` },
            ],
            {
              duration: 450,
              easing: "cubic-bezier(0.16, 1, 0.3, 1)",
              fill: "forwards",
            }
          );
        } else {
          track.style.transform = `translateX(-${this.currentIndex * 100}%)`;
        }

        slides.forEach((slide, i) => {
          const inactive = i !== this.currentIndex;
          slide.setAttribute("aria-hidden", String(inactive));
          slide.toggleAttribute("inert", inactive);
        });

        if (statusElem) {
          const countSpan = statusElem.querySelector("[data-carousel-count]");
          if (countSpan) countSpan.textContent = `${this.currentIndex + 1} de ${slides.length}`;
        }
      };

      const syncRotation = () => {
        if (this.timer !== null) {
          clearInterval(this.timer);
          this.timer = null;
        }
        if (playbackBtn) {
          playbackBtn.textContent = this.isPlaying ? "Pausar imágenes" : "Reproducir imágenes";
        }
        if (this.isPlaying && !document.hidden) {
          this.timer = window.setInterval(() => showSlide(this.currentIndex + 1), 5000);
        }
      };

      if (slides.length > 1) {
        if (prevBtn) prevBtn.hidden = false;
        if (nextBtn) nextBtn.hidden = false;
        if (playbackBtn) playbackBtn.hidden = false;
        if (statusElem) statusElem.hidden = false;

        prevBtn?.addEventListener("click", () => {
          this.isPlaying = false;
          syncRotation();
          showSlide(this.currentIndex - 1);
        }, { signal });

        nextBtn?.addEventListener("click", () => {
          this.isPlaying = false;
          syncRotation();
          showSlide(this.currentIndex + 1);
        }, { signal });

        playbackBtn?.addEventListener("click", () => {
          this.isPlaying = !this.isPlaying;
          syncRotation();
        }, { signal });

        syncRotation();
      }

      // Elementos del Chatbot
      const closeBtn = this.querySelector("#close-chat-btn") as HTMLButtonElement | null;
      const toggleHeaderBtn = document.getElementById("toggle-chat-btn");
      const heroChatTrigger = document.getElementById("hero-chat-trigger");
      const chatInput = this.querySelector("#chat-textarea") as HTMLTextAreaElement | null;
      const sendBtn = this.querySelector("#send-btn") as HTMLButtonElement | null;
      const chatbox = this.querySelector(".chatbox") as HTMLElement | null;
      const scrollContainer = this.querySelector(".chat-content") as HTMLElement | null;
      const mobileMedia = window.matchMedia("(max-width: 900px)");

      const syncBodyScrollLock = (isOpen: boolean) => {
        document.body.classList.toggle("fimebot-mobile-open", isOpen && mobileMedia.matches);
      };

      const syncHeaderButton = (isOpen: boolean) => {
        if (toggleHeaderBtn) {
          toggleHeaderBtn.setAttribute("aria-expanded", String(isOpen));
          toggleHeaderBtn.setAttribute("aria-label", `${isOpen ? "Cerrar" : "Abrir"} asistente virtual FimeBot`);
        }
      };

      const resizeTextarea = () => {
        if (!chatInput) return;
        chatInput.style.height = "auto";
        chatInput.style.height = `${Math.min(chatInput.scrollHeight, 112)}px`;
      };

      // Transición Nativa en Desktop + Hoja Completa Accesible en Móvil
      const toggleChat = (forceOpen?: boolean) => {
        const willOpen = typeof forceOpen === "boolean" ? forceOpen : !this.classList.contains("show-chat");

        const applyState = () => {
          this.classList.toggle("show-chat", willOpen);
          syncHeaderButton(willOpen);
          syncBodyScrollLock(willOpen);
        };

        if (
          !mobileMedia.matches &&
          typeof document !== "undefined" &&
          "startViewTransition" in document &&
          !prefersReducedMotion
        ) {
          (document as any).startViewTransition(applyState);
        } else {
          applyState();
        }

        if (!willOpen && window.location.hash === "#fimebot-chat") {
          history.replaceState(null, "", window.location.pathname + window.location.search);
        }
      };

      // Inicialización responsiva móvil
      if (mobileMedia.matches) {
        const openByHash = window.location.hash === "#fimebot-chat";
        this.classList.toggle("show-chat", openByHash);
        syncHeaderButton(openByHash);
        syncBodyScrollLock(openByHash);
      } else {
        syncHeaderButton(this.classList.contains("show-chat"));
        syncBodyScrollLock(false);
      }

      mobileMedia.addEventListener("change", () => {
        syncBodyScrollLock(this.classList.contains("show-chat"));
      }, { signal });

      window.addEventListener("hashchange", () => {
        if (window.location.hash === "#fimebot-chat") {
          toggleChat(true);
        }
      }, { signal });

      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && mobileMedia.matches && this.classList.contains("show-chat")) {
          toggleChat(false);
        }
      }, { signal });

      document.addEventListener("astro:before-swap", () => {
        document.body.classList.remove("fimebot-mobile-open");
      }, { once: true, signal });

      closeBtn?.addEventListener("click", () => toggleChat(false), { signal });
      toggleHeaderBtn?.addEventListener("click", () => toggleChat(), { signal });
      heroChatTrigger?.addEventListener("click", (e) => {
        e.preventDefault();
        toggleChat(true);
        if (chatInput) {
          setTimeout(() => chatInput.focus({ preventScroll: true }), 180);
        }
      }, { signal });

      // Escuchar eventos globales desacoplados (fimebot:open, fimebot:close, fimebot:toggle)
      document.addEventListener("fimebot:toggle", () => toggleChat(), { signal });
      document.addEventListener("fimebot:open", () => toggleChat(true), { signal });
      document.addEventListener("fimebot:close", () => toggleChat(false), { signal });

      const scrollChat = () => {
        if (scrollContainer) {
          scrollContainer.scrollTop = scrollContainer.scrollHeight;
        }
      };

      // Renderizar Markdown seguro
      const appendInline = (parent: HTMLElement, text: string) => {
        const pattern = /\[([^\]]+)\]\(([^\s)]+)\)|\*\*([^*]+)\*\*/g;
        let cursor = 0;
        for (const match of text.matchAll(pattern)) {
          parent.append(document.createTextNode(text.slice(cursor, match.index)));
          if (match[3]) {
            const strong = document.createElement("strong");
            strong.textContent = match[3];
            parent.append(strong);
          } else if (match[1] && match[2]) {
            let safe = false;
            try {
              const url = new URL(match[2], window.location.origin);
              safe = (url.origin === window.location.origin && match[2].startsWith("/")) ||
                     (url.protocol === "https:" && (url.hostname === "ucol.mx" || url.hostname.endsWith(".ucol.mx")));
            } catch {
              safe = false;
            }
            if (safe) {
              const link = document.createElement("a");
              link.textContent = match[1];
              link.href = match[2];
              link.target = "_blank";
              link.rel = "noopener noreferrer";
              parent.append(link);
            } else {
              parent.append(document.createTextNode(match[1]));
            }
          }
          cursor = match.index + match[0].length;
        }
        parent.append(document.createTextNode(text.slice(cursor)));
      };

      const renderMarkdown = (element: HTMLElement, text: string) => {
        const fragment = document.createDocumentFragment();
        let list: HTMLUListElement | null = null;
        for (const line of text.split("\n")) {
          const item = line.match(/^\s*(?:[-*]|\d+\.)\s+(.+)$/);
          if (item) {
            if (!list) list = document.createElement("ul");
            const li = document.createElement("li");
            appendInline(li, item[1]);
            list.appendChild(li);
          } else {
            if (list) {
              fragment.appendChild(list);
              list = null;
            }
            if (line.trim()) {
              const p = document.createElement("p");
              appendInline(p, line);
              fragment.appendChild(p);
            }
          }
        }
        if (list) fragment.appendChild(list);
        element.replaceChildren(fragment);
      };

      // Creación de burbujas con indicador pro de 3 puntos
      const createChatLi = (message: string, className: string): HTMLLIElement => {
        const li = document.createElement("li");
        li.className = `chat ${className}`;

        if (className === "incoming") {
          const avatar = document.createElement("span");
          avatar.className = "chat-avatar";
          avatar.setAttribute("aria-hidden", "true");
          avatar.innerHTML = `
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none">
              <path d="M4 12C4 7.58 7.58 4 12 4C16.42 4 20 7.58 20 12C20 16.42 16.42 20 12 20H5.5C4.67 20 4 19.33 4 18.5V12Z" fill="currentColor" fill-opacity="0.16" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round"/>
              <path d="M12 8L13.1 10.9L16 12L13.1 13.1L12 16L10.9 13.1L8 12L10.9 10.9L12 8Z" fill="#E65642" stroke="#E65642" stroke-width="1.1" stroke-linejoin="round"/>
            </svg>
          `;
          li.appendChild(avatar);
        }

        const bubble = document.createElement("div");
        bubble.className = "chat-bubble";
        if (message === "Pensando...") {
          bubble.className = "chat-bubble thinking-bubble";
          bubble.innerHTML = `
            <span class="thinking-text">FimeBot está formulando respuesta</span>
            <span class="thinking-dots" aria-hidden="true">
              <span class="dot"></span>
              <span class="dot"></span>
              <span class="dot"></span>
            </span>
          `;
        } else if (className === "incoming") {
          renderMarkdown(bubble, message);
        } else {
          bubble.textContent = message;
        }
        li.appendChild(bubble);
        return li;
      };

      const handleSend = async (userMessage: string) => {
        if (!userMessage.trim() || this.isSending || !chatbox) return;
        this.isSending = true;
        if (chatInput) {
          chatInput.value = "";
          chatInput.style.height = "auto";
        }
        if (sendBtn) sendBtn.disabled = true;

        chatbox.appendChild(createChatLi(userMessage, "outgoing"));
        this.chatHistory.push({ role: "user", content: userMessage });
        scrollChat();

        const thinkingLi = createChatLi("Pensando...", "incoming");
        chatbox.appendChild(thinkingLi);
        scrollChat();
        const bubble = thinkingLi.querySelector(".chat-bubble") as HTMLElement;

        const controller = new AbortController();
        const timeoutId = setTimeout(() => controller.abort(), 20000);

        try {
          const res = await fetch("/api/chat", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            signal: controller.signal,
            body: JSON.stringify({
              messages: this.chatHistory.slice(-13).map((m) => ({
                role: m.role,
                content: m.content.slice(0, m.role === "user" ? 1200 : 3000),
              })),
              stream: true,
              think: false,
            }),
          });

          if (!res.ok) {
            throw new Error(
              res.status === 429
                ? "Has enviado varias consultas seguidas. Espera un momento y vuelve a intentar."
                : "No pude completar la consulta en este momento. Intenta de nuevo."
            );
          }

          bubble.className = "chat-bubble";
          bubble.textContent = "";

          const contentType = res.headers.get("content-type") || "";
          let botMessage = "";

          if (contentType.includes("text/event-stream") && res.body) {
            const reader = res.body.getReader();
            const decoder = new TextDecoder("utf-8");
            let buffer = "";

            while (true) {
              const { done, value } = await reader.read();
              if (done) break;
              buffer += decoder.decode(value, { stream: true });
              const lines = buffer.split("\n");
              buffer = lines.pop() || "";

              for (const line of lines) {
                const trimmed = line.trim();
                if (!trimmed || !trimmed.startsWith("data:")) continue;
                const dataStr = trimmed.slice(5).trim();
                if (dataStr === "[DONE]") continue;

                try {
                  const parsed = JSON.parse(dataStr);
                  const delta = parsed.choices?.[0]?.delta?.content || "";
                  if (delta) {
                    botMessage += delta;
                    renderMarkdown(bubble, botMessage);
                    scrollChat();
                  }
                } catch {
                  // Fragmento incompleto
                }
              }
            }

            if (!botMessage.trim()) throw new Error("No recibí una respuesta. Intenta de nuevo.");
          } else {
            const data = await res.json();
            botMessage = data?.message?.content || "No hay una respuesta disponible.";
            renderMarkdown(bubble, botMessage);
          }

          this.chatHistory.push({ role: "assistant", content: botMessage });
        } catch (err: any) {
          bubble.className = "chat-bubble error";
          bubble.textContent =
            err.name === "AbortError"
              ? "La consulta tardó demasiado tiempo. Intenta de nuevo."
              : (err.message || "Error al conectar con FimeBot.");
        } finally {
          clearTimeout(timeoutId);
          this.isSending = false;
          if (sendBtn) sendBtn.disabled = false;
          scrollChat();
        }
      };

      sendBtn?.addEventListener("click", () => {
        if (chatInput) handleSend(chatInput.value);
      }, { signal });

      chatInput?.addEventListener("input", resizeTextarea, { signal });

      chatInput?.addEventListener("keydown", (e) => {
        if (e.key === "Enter" && !e.shiftKey) {
          e.preventDefault();
          handleSend(chatInput.value);
        }
      }, { signal });

      this.querySelectorAll(".chat-suggestions button").forEach((btn) => {
        btn.addEventListener("click", () => {
          const question = btn.getAttribute("data-question");
          if (question) handleSend(question);
        }, { signal });
      });
    }
  }

  // Registrar Web Component si no existe
  if (!customElements.get("fime-campus-stage")) {
    customElements.define("fime-campus-stage", FimeCampusStage);
  }
</script>

