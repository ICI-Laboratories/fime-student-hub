---
// CampusTransformContainer.astro — Contenedor interactivo transformable con Carrusel 16:9 y FimeBot animado
interface Slide {
  image: string;
  alt: string;
  tag: string;
  title: string;
  description: string;
}

const slides: Slide[] = [
  {
    image: "/img/ActividadesRecre2.jpg",
    alt: "Profesores en actividades recreativas",
    tag: "COMUNIDAD DOCENTE",
    title: "Profesores en actividades recreativas",
    description: "Fortaleciendo el trabajo en equipo y creando vínculos que enriquecen el ambiente académico.",
  },
  {
    image: "/img/ActividadesRecre.jpg",
    alt: "Comunidad estudiantil",
    tag: "VIDA ESTUDIANTIL",
    title: "Estudiantes en actividades recreativas",
    description: "Fomentando la integración y el desarrollo personal en un entorno dinámico y colaborativo.",
  },
  {
    image: "/img/AExtra.jpg",
    alt: "Visita industrial",
    tag: "VINCULACIÓN INDUSTRIAL",
    title: "Visita Industrial: Aprendizaje en el Campo",
    description: "Conectando la teoría con la práctica en experiencias de campo que preparan para la industria real.",
  },
  {
    image: "/img/chacuaco.jpg",
    alt: "El Chacuaco FIME",
    tag: "IDENTIDAD FIME",
    title: "El Emblemático Chacuaco: Orgullo Institucional",
    description: "Representando nuestra tradición e identidad, un icono que inspira a nuestra comunidad educativa.",
  },
  {
    image: "/img/cursos.jpg",
    alt: "Cursos y capacitación",
    tag: "FORMACIÓN CONTINUA",
    title: "Cursos y Capacitación para Alumnos",
    description: "Actualización constante en áreas tecnológicas de vanguardia.",
  },
  {
    image: "/img/cursos2.jpg",
    alt: "Laboratorios de hidráulica",
    tag: "LABORATORIOS FIME",
    title: "Hidráulica en Acción: Infraestructura Práctica",
    description: "Espacios de experimentación donde se aplican criterios técnicos a proyectos reales.",
  },
  {
    image: "/img/labBrenda.jpg",
    alt: "Laboratorio de Cómputo",
    tag: "CENTRO DE CÓMPUTO",
    title: "Desarrollo de Software e Inteligencia Artificial",
    description: "Equipamiento moderno para desarrollo de proyectos computacionales avanzados.",
  },
  {
    image: "/img/labIsaac.jpg",
    alt: "Laboratorio de Electrónica",
    tag: "AUTOMATIZACIÓN",
    title: "Laboratorio de Electrónica y Mecatrónica",
    description: "Instalaciones para diseño, prototipado y pruebas de circuitos y sistemas mecánicos.",
  },
];
---

<div class="transform-container show-chat" id="transform-container">
  <!-- Sección del Carrusel (Aspect Ratio 16:9 Adaptativo) -->
  <section class="carousel-section" aria-labelledby="campus-gallery-title" aria-roledescription="carrusel">
    <h2 class="visually-hidden" id="campus-gallery-title">La vida en la FIME</h2>
    <button type="button" class="carousel-playback" id="toggle-carousel" aria-controls="campus-slides" hidden>
      Pausar imágenes
    </button>

    <div class="carousel" id="campus-slides">
      {slides.map((slide, index) => (
        <div
          class="slide"
          role="group"
          aria-roledescription="diapositiva"
          aria-label={`${index + 1} de ${slides.length}`}
          aria-hidden={index === 0 ? "false" : "true"}
          inert={index === 0 ? undefined : true}
        >
          <img src={slide.image} alt={slide.alt} loading={index === 0 ? "eager" : "lazy"} />
          <div class="slide-text">
            <span class="slide-overline">{slide.tag}</span>
            <h3>{slide.title}</h3>
            <p>{slide.description}</p>
          </div>
        </div>
      ))}
    </div>

    <!-- Controles Glass del Carrusel -->
    <button type="button" class="carousel-control prev" id="prev-slide" aria-label="Imagen anterior" aria-controls="campus-slides" hidden>
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polyline points="15 18 9 12 15 6"></polyline>
      </svg>
    </button>
    <button type="button" class="carousel-control next" id="next-slide" aria-label="Siguiente imagen" aria-controls="campus-slides" hidden>
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polyline points="9 18 15 12 9 6"></polyline>
      </svg>
    </button>

    <p class="carousel-status" aria-live="off" aria-atomic="true" hidden>
      <span data-carousel-count aria-hidden="true">1 de {slides.length}</span>
      <span class="visually-hidden" data-carousel-announcement></span>
    </p>
  </section>

  <!-- Sección del Chatbot FimeBot (Animado con Glass OS) -->
  <section class="chat-section" id="fimebot-chat" aria-label="Asistente FimeBot" tabindex="-1">
    <div class="chat-header">
      <div class="chat-header-info">
        <span class="overline-secondary">ORIENTACIÓN SOBRE LA FIME</span>
        <div class="chat-title-group">
          <h2>FimeBot</h2>
          <span class="online-pill">
            <span class="online-dot"></span> En línea
          </span>
        </div>
      </div>
      <button type="button" id="close-chat-btn" aria-label="Cerrar ventana de chat">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <div class="chat-content">
      <ul class="chatbox" role="log" aria-live="polite" aria-relevant="additions text" aria-label="Conversación con FimeBot">
        <li class="chat incoming">
          <span class="chat-avatar" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none">
              <path d="M4 12C4 7.58 7.58 4 12 4C16.42 4 20 7.58 20 12C20 16.42 16.42 20 12 20H5.5C4.67 20 4 19.33 4 18.5V12Z" fill="currentColor" fill-opacity="0.16" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round"/>
              <path d="M12 8L13.1 10.9L16 12L13.1 13.1L12 16L10.9 13.1L8 12L10.9 10.9L12 8Z" fill="#E65642" stroke="#E65642" stroke-width="1.1" stroke-linejoin="round"/>
            </svg>
          </span>
          <div class="chat-bubble">
            <p>¡Hola! Soy <strong>FimeBot</strong>. Te oriento sobre la FIME de la Universidad de Colima: carreras, admisión, becas, trámites y ubicación.</p>
            <p>Mis respuestas incluyen fuentes oficiales verificadas.</p>
          </div>
        </li>
      </ul>
    </div>

    <!-- Preguntas Frecuentes / Chips -->
    <div class="chat-suggestions" aria-label="Consultas frecuentes">
      <button type="button" data-question="¿Qué carreras ofrece la FIME?">Carreras</button>
      <button type="button" data-question="¿Cómo ingreso a la FIME?">Admisión</button>
      <button type="button" data-question="¿Qué becas puedo solicitar?">Becas</button>
      <button type="button" data-question="¿Dónde está la FIME y cómo contacto a la facultad?">Ubicación y contacto</button>
    </div>

    <!-- Entrada de Texto con envío Fitts-compliant -->
    <div class="chat-input">
      <textarea
        placeholder="Pregunta sobre carreras, trámites o servicios…"
        aria-label="Mensaje para FimeBot"
        aria-describedby="chat-scope"
        maxlength="1200"
        rows="1"
        id="chat-textarea"
      ></textarea>
      <button class="btn-send" id="send-btn" aria-label="Enviar mensaje a FimeBot">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="22" y1="2" x2="11" y2="13"></line>
          <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
        </svg>
      </button>
    </div>
    <p class="chat-scope" id="chat-scope">Solo orientación de la FIME · Respuestas fundamentadas en fuentes de UCOL.</p>
  </section>
</div>

<script>
  function setupTransformContainer() {
    const container = document.getElementById("transform-container");
    if (!container) return;

    // 1. Lógica del Carrusel
    const carouselSection = container.querySelector(".carousel-section") as HTMLElement | null;
    const track = container.querySelector(".carousel") as HTMLElement | null;
    const slides = Array.from(container.querySelectorAll(".slide")) as HTMLElement[];
    const prevBtn = container.querySelector("#prev-slide") as HTMLButtonElement | null;
    const nextBtn = container.querySelector("#next-slide") as HTMLButtonElement | null;
    const playbackBtn = container.querySelector("#toggle-carousel") as HTMLButtonElement | null;
    const statusElem = container.querySelector(".carousel-status") as HTMLElement | null;

    let currentIndex = 0;
    const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    let isPlaying = !prefersReducedMotion && slides.length > 1;
    let timer: number | null = null;

    function showSlide(index: number) {
      if (!track || !slides.length) return;
      currentIndex = (index + slides.length) % slides.length;
      track.style.transform = `translateX(-${currentIndex * 100}%)`;
      slides.forEach((slide, i) => {
        const inactive = i !== currentIndex;
        slide.setAttribute("aria-hidden", String(inactive));
        slide.toggleAttribute("inert", inactive);
      });
      if (statusElem) {
        const countSpan = statusElem.querySelector("[data-carousel-count]");
        if (countSpan) countSpan.textContent = `${currentIndex + 1} de ${slides.length}`;
      }
    }

    function syncRotation() {
      if (timer !== null) {
        clearInterval(timer);
        timer = null;
      }
      if (playbackBtn) {
        playbackBtn.textContent = isPlaying ? "Pausar imágenes" : "Reproducir imágenes";
      }
      if (isPlaying && !document.hidden) {
        timer = window.setInterval(() => showSlide(currentIndex + 1), 5000);
      }
    }

    if (slides.length > 1) {
      if (prevBtn) prevBtn.hidden = false;
      if (nextBtn) nextBtn.hidden = false;
      if (playbackBtn) playbackBtn.hidden = false;
      if (statusElem) statusElem.hidden = false;

      prevBtn?.addEventListener("click", () => {
        isPlaying = false;
        syncRotation();
        showSlide(currentIndex - 1);
      });
      nextBtn?.addEventListener("click", () => {
        isPlaying = false;
        syncRotation();
        showSlide(currentIndex + 1);
      });
      playbackBtn?.addEventListener("click", () => {
        isPlaying = !isPlaying;
        syncRotation();
      });
      syncRotation();
    }

    // 2. Lógica del Chatbot FimeBot (Animación + Streaming SSE + Markdown)
    const closeBtn = document.getElementById("close-chat-btn");
    const toggleHeaderBtn = document.getElementById("toggle-chat-btn");
    const heroChatTrigger = document.getElementById("hero-chat-trigger");
    const chatInput = document.getElementById("chat-textarea") as HTMLTextAreaElement | null;
    const sendBtn = document.getElementById("send-btn") as HTMLButtonElement | null;
    const chatbox = container.querySelector(".chatbox") as HTMLElement | null;
    const scrollContainer = container.querySelector(".chat-content") as HTMLElement | null;

    const chatHistory: { role: string; content: string }[] = [];
    let isSending = false;

    function toggleChat(forceOpen?: boolean) {
      const willOpen = typeof forceOpen === "boolean" ? forceOpen : !container?.classList.contains("show-chat");
      if (willOpen) {
        container?.classList.add("show-chat");
      } else {
        container?.classList.remove("show-chat");
      }

      if (toggleHeaderBtn) {
        toggleHeaderBtn.setAttribute("aria-expanded", String(willOpen));
        toggleHeaderBtn.setAttribute("aria-label", `${willOpen ? "Cerrar" : "Abrir"} asistente virtual FimeBot`);
      }
      if (willOpen && chatInput) {
        // En móvil hacer scroll suave hacia el contenedor si se abrió desde el hero
        if (window.innerWidth <= 900) {
          container?.scrollIntoView({ behavior: "smooth", block: "start" });
        }
      }
    }

    // En pantallas pequeñas inicializar con el carrusel visible (a menos que traiga hash de chat)
    if (window.innerWidth <= 900) {
      if (window.location.hash === "#fimebot-chat") {
        container.classList.add("show-chat");
      } else {
        container.classList.remove("show-chat");
      }
    }

    closeBtn?.addEventListener("click", () => toggleChat(false));
    toggleHeaderBtn?.addEventListener("click", () => toggleChat());
    heroChatTrigger?.addEventListener("click", (e) => {
      e.preventDefault();
      toggleChat(true);
      if (chatInput) {
        setTimeout(() => chatInput.focus(), 350);
      }
    });

    function scrollChat() {
      if (scrollContainer) {
        scrollContainer.scrollTop = scrollContainer.scrollHeight;
      }
    }

    // Renderizar Markdown seguro (enlaces a ucol.mx y rutas relativas)
    function appendInline(parent: HTMLElement, text: string) {
      const pattern = /\[([^\]]+)\]\(([^\s)]+)\)|\*\*([^*]+)\*\*/g;
      let cursor = 0;
      for (const match of text.matchAll(pattern)) {
        parent.append(document.createTextNode(text.slice(cursor, match.index)));
        if (match[3]) {
          const strong = document.createElement("strong");
          strong.textContent = match[3];
          parent.append(strong);
        } else if (match[1] && match[2]) {
          let safe = false;
          try {
            const url = new URL(match[2], window.location.origin);
            safe = (url.origin === window.location.origin && match[2].startsWith("/")) ||
                   (url.protocol === "https:" && (url.hostname === "ucol.mx" || url.hostname.endsWith(".ucol.mx")));
          } catch {
            safe = false;
          }
          if (safe) {
            const link = document.createElement("a");
            link.textContent = match[1];
            link.href = match[2];
            link.target = "_blank";
            link.rel = "noopener noreferrer";
            parent.append(link);
          } else {
            parent.append(document.createTextNode(match[1]));
          }
        }
        cursor = match.index + match[0].length;
      }
      parent.append(document.createTextNode(text.slice(cursor)));
    }

    function renderMarkdown(element: HTMLElement, text: string) {
      const fragment = document.createDocumentFragment();
      let list: HTMLUListElement | null = null;
      for (const line of text.split("\n")) {
        const item = line.match(/^\s*(?:[-*]|\d+\.)\s+(.+)$/);
        if (item) {
          if (!list) {
            list = document.createElement("ul");
            fragment.append(list);
          }
          const li = document.createElement("li");
          appendInline(li, item[1]);
          list.append(li);
        } else {
          list = null;
          if (!line.trim()) continue;
          const p = document.createElement("p");
          appendInline(p, line.replace(/^#{1,6}\s+/, ""));
          fragment.append(p);
        }
      }
      element.replaceChildren(fragment);
    }

    function createChatLi(message: string, className: "incoming" | "outgoing") {
      const li = document.createElement("li");
      li.className = `chat ${className}`;
      if (className === "incoming") {
        const icon = document.createElement("span");
        icon.className = "chat-avatar";
        icon.setAttribute("aria-hidden", "true");
        icon.innerHTML = `<svg viewBox="0 0 24 24" width="18" height="18" fill="none"><path d="M4 12C4 7.58 7.58 4 12 4C16.42 4 20 7.58 20 12C20 16.42 16.42 20 12 20H5.5C4.67 20 4 19.33 4 18.5V12Z" fill="currentColor" fill-opacity="0.16" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round"/><path d="M12 8L13.1 10.9L16 12L13.1 13.1L12 16L10.9 13.1L8 12L10.9 10.9L12 8Z" fill="#E65642" stroke="#E65642" stroke-width="1.1" stroke-linejoin="round"/></svg>`;
        li.appendChild(icon);
      }

      const bubble = document.createElement("div");
      bubble.className = "chat-bubble";
      if (message === "Pensando...") {
        bubble.classList.add("thinking-animation");
        bubble.textContent = message;
      } else if (className === "incoming") {
        renderMarkdown(bubble, message);
      } else {
        bubble.textContent = message;
      }
      li.appendChild(bubble);
      return li;
    }

    async function handleSend(userMessage: string) {
      if (!userMessage.trim() || isSending || !chatbox) return;
      isSending = true;
      if (chatInput) chatInput.value = "";
      if (sendBtn) sendBtn.disabled = true;

      chatbox.appendChild(createChatLi(userMessage, "outgoing"));
      chatHistory.push({ role: "user", content: userMessage });
      scrollChat();

      const thinkingLi = createChatLi("Pensando...", "incoming");
      chatbox.appendChild(thinkingLi);
      scrollChat();
      const bubble = thinkingLi.querySelector(".chat-bubble") as HTMLElement;

      const controller = new AbortController();
      const timeoutId = setTimeout(() => controller.abort(), 20000);

      try {
        const res = await fetch("/api/chat", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          signal: controller.signal,
          body: JSON.stringify({
            messages: chatHistory.slice(-13).map((m) => ({
              role: m.role,
              content: m.content.slice(0, m.role === "user" ? 1200 : 3000),
            })),
            stream: true,
            think: false,
          }),
        });

        if (!res.ok) {
          throw new Error(
            res.status === 429
              ? "Has enviado varias consultas seguidas. Espera un momento y vuelve a intentar."
              : "No pude completar la consulta en este momento. Intenta de nuevo."
          );
        }

        bubble.classList.remove("thinking-animation");
        bubble.textContent = "";

        const contentType = res.headers.get("content-type") || "";
        let botMessage = "";

        if (contentType.includes("text/event-stream") && res.body) {
          const reader = res.body.getReader();
          const decoder = new TextDecoder("utf-8");
          let buffer = "";

          while (true) {
            const { done, value } = await reader.read();
            if (done) break;
            buffer += decoder.decode(value, { stream: true });
            const lines = buffer.split("\n");
            buffer = lines.pop() || "";

            for (const line of lines) {
              const trimmed = line.trim();
              if (!trimmed || !trimmed.startsWith("data:")) continue;
              const dataStr = trimmed.slice(5).trim();
              if (dataStr === "[DONE]") continue;

              try {
                const parsed = JSON.parse(dataStr);
                const delta = parsed.choices?.[0]?.delta?.content || "";
                if (delta) {
                  botMessage += delta;
                  renderMarkdown(bubble, botMessage);
                  scrollChat();
                }
              } catch {
                // Fragmento incompleto
              }
            }
          }

          if (!botMessage.trim()) throw new Error("No recibí una respuesta. Intenta de nuevo.");
        } else {
          const data = await res.json();
          botMessage = data?.message?.content || "No hay una respuesta disponible.";
          renderMarkdown(bubble, botMessage);
        }

        chatHistory.push({ role: "assistant", content: botMessage });
      } catch (err: any) {
        bubble.classList.remove("thinking-animation");
        bubble.textContent =
          err.name === "AbortError"
            ? "La consulta tardó demasiado tiempo. Intenta de nuevo."
            : (err.message || "Error al conectar con FimeBot.");
        bubble.classList.add("error");
      } finally {
        clearTimeout(timeoutId);
        isSending = false;
        if (sendBtn) sendBtn.disabled = false;
        scrollChat();
      }
    }

    sendBtn?.addEventListener("click", () => {
      if (chatInput) handleSend(chatInput.value);
    });

    chatInput?.addEventListener("keydown", (e) => {
      if (e.key === "Enter" && !e.shiftKey) {
        e.preventDefault();
        handleSend(chatInput.value);
      }
    });

    container.querySelectorAll(".chat-suggestions button").forEach((btn) => {
      btn.addEventListener("click", () => {
        const question = btn.getAttribute("data-question");
        if (question) handleSend(question);
      });
    });
  }

  setupTransformContainer();
  document.addEventListener("astro:page-load", setupTransformContainer);
</script>

<style>
  /* ════════════════════════════════════════════════════
     CONTENEDOR TRANSFORMABLE GLASS OS (CARRUSEL + CHAT)
     ════════════════════════════════════════════════════ */
  .transform-container {
    background: var(--sara-glass-strong, rgba(255, 255, 255, 0.88));
    backdrop-filter: blur(25px) saturate(160%);
    -webkit-backdrop-filter: blur(25px) saturate(160%);
    border: 1px solid var(--sara-border-glass, rgba(26, 54, 122, 0.12));
    border-radius: var(--sara-radius-lg, 16px);
    box-shadow:
      inset 0 1px 1px 0 var(--sara-rim-specular, rgba(255, 255, 255, 0.9)),
      var(--sara-shadow-glass-lg, 0 20px 45px -8px rgba(10, 19, 41, 0.12));
    position: relative;
    overflow: hidden;
    transition: all 350ms cubic-bezier(0.4, 0, 0.2, 1);
    aspect-ratio: 16 / 9;
    width: 100%;

    display: grid;
    grid-template-columns: 1fr;
    grid-template-rows: 1fr;
  }

  .transform-container.show-chat {
    aspect-ratio: 16 / 9;
    grid-template-columns: 3fr 2fr;
  }

  /* ════════════════════════════════════════════════════
     SECCIÓN DEL CARRUSEL (Aspect Ratio 16:9 y Fotorrealismo)
     ════════════════════════════════════════════════════ */
  .carousel-section {
    grid-column: 1 / 2;
    grid-row: 1 / 2;
    width: 100%;
    height: 100%;
    position: relative;
    overflow: hidden;
    display: block;
  }

  .carousel {
    display: flex;
    width: 100%;
    height: 100%;
    transition: transform 350ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .slide {
    min-width: 100%;
    height: 100%;
    position: relative;
  }

  .slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  /* Tarjeta de Lectura: Cristal por fuera, papel por dentro */
  .slide-text {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: rgba(255, 255, 255, 0.94);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-top: 2px solid var(--sara-cyan-500, #159AB3);
    padding: 14px 22px;
    color: var(--color-ink, #141824);
  }

  .slide-overline {
    display: inline-block;
    font-family: var(--font-mono, "JetBrains Mono", monospace);
    font-size: 0.625rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    color: var(--sara-cyan-700, #0E7B91);
    text-transform: uppercase;
    margin-bottom: 2px;
  }

  .slide-text h3 {
    font-family: var(--font-display, "Manrope", sans-serif);
    font-size: 1.125rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--sara-sapphire-950, #0A1329);
    margin: 2px 0 4px 0;
    line-height: 1.25;
  }

  .slide-text p {
    font-size: 0.84375rem;
    color: var(--sara-text-secondary, #475569);
    line-height: 1.45;
    margin: 0;
  }

  /* Controles Glass del Carrusel */
  .carousel-control {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: var(--sara-glass-strong, rgba(255, 255, 255, 0.88));
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    color: var(--sara-sapphire-700, #1A367A);
    border: 1px solid var(--sara-border-glass, rgba(26, 54, 122, 0.12));
    box-shadow: inset 0 1px 1px 0 var(--sara-rim-specular), var(--sara-shadow-glass-sm);
    border-radius: var(--sara-radius-pill, 9999px);
