---
// FimeBotChat.astro — Componente oficial de asistencia virtual FimeBot con soporte SSE y Glass OS
---

<div class="fimebot-wrapper" id="fimebot-chat" tabindex="-1">
  <div class="chat-card" id="chat-card">
    <!-- Header del Asistente -->
    <header class="chat-header">
      <div class="chat-header__info">
        <div class="chat-header__avatar" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none">
            <path d="M4 12C4 7.58 7.58 4 12 4C16.42 4 20 7.58 20 12C20 16.42 16.42 20 12 20H5.5C4.67 20 4 19.33 4 18.5V12Z" fill="currentColor" fill-opacity="0.16" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round"/>
            <path d="M12 8L13.1 10.9L16 12L13.1 13.1L12 16L10.9 13.1L8 12L10.9 10.9L12 8Z" fill="#E65642" stroke="#E65642" stroke-width="1.1" stroke-linejoin="round"/>
          </svg>
        </div>
        <div>
          <span class="chat-header__overline">ASISTENTE OFICIAL FIME</span>
          <h2 class="chat-header__title">FimeBot</h2>
        </div>
      </div>
      <div class="chat-header__actions">
        <span class="status-indicator" title="Servicio activo">
          <span class="status-dot"></span> En línea
        </span>
        <button type="button" id="close-chat-btn" class="btn-close-chat" aria-label="Minimizar asistente FimeBot">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>
    </header>

    <!-- Caja de Conversación -->
    <div class="chat-content">
      <ul class="chatbox" role="log" aria-live="polite" aria-busy="false">
        <li class="chat incoming">
          <span class="chat-avatar" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none">
              <path d="M4 12C4 7.58 7.58 4 12 4C16.42 4 20 7.58 20 12C20 16.42 16.42 20 12 20H5.5C4.67 20 4 19.33 4 18.5V12Z" fill="currentColor" fill-opacity="0.16" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round"/>
              <path d="M12 8L13.1 10.9L16 12L13.1 13.1L12 16L10.9 13.1L8 12L10.9 10.9L12 8Z" fill="#E65642" stroke="#E65642" stroke-width="1.1" stroke-linejoin="round"/>
            </svg>
          </span>
          <div class="chat-bubble">
            <p>¡Hola! Soy <strong>FimeBot</strong>. Te oriento sobre la FIME de la Universidad de Colima: carreras de ingeniería, admisión, becas, trámites y ubicación.</p>
            <p>Mis respuestas incluyen fuentes oficiales y enlaces verificados.</p>
          </div>
        </li>
      </ul>
    </div>

    <!-- Preguntas Frecuentes / Chips -->
    <div class="chat-suggestions" aria-label="Consultas frecuentes">
      <button type="button" class="chip" data-question="¿Qué carreras ofrece la FIME?">Carreras</button>
      <button type="button" class="chip" data-question="¿Cómo ingreso a la FIME?">Admisión</button>
      <button type="button" class="chip" data-question="¿Qué becas puedo solicitar?">Becas</button>
      <button type="button" class="chip" data-question="¿Dónde está la FIME y cómo contacto a la facultad?">Ubicación</button>
    </div>

    <!-- Entrada de Texto -->
    <div class="chat-input-row">
      <textarea
        placeholder="Pregunta sobre carreras, trámites o servicios…"
        aria-label="Mensaje para FimeBot"
        aria-describedby="chat-scope"
        maxlength="1200"
        rows="1"
        id="fimebot-textarea"
      ></textarea>
      <button type="button" class="btn-send" id="send-btn" aria-label="Enviar mensaje a FimeBot">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="22" y1="2" x2="11" y2="13"></line>
          <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
        </svg>
      </button>
    </div>
    <p class="chat-scope" id="chat-scope">Solo orientación institucional · Respuestas fundamentadas en fuentes de UCOL.</p>
  </div>

  <!-- Botón Colapsado para Móvil (cuando el chat está minimizado) -->
  <button type="button" id="open-chat-card-btn" class="chat-collapsed-trigger" aria-controls="chat-card" aria-label="Abrir asistente virtual FimeBot">
    <div class="collapsed-trigger-content">
      <div class="trigger-avatar" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none">
          <path d="M4 12C4 7.58 7.58 4 12 4C16.42 4 20 7.58 20 12C20 16.42 16.42 20 12 20H5.5C4.67 20 4 19.33 4 18.5V12Z" fill="currentColor" fill-opacity="0.16" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round"/>
          <path d="M12 8L13.1 10.9L16 12L13.1 13.1L12 16L10.9 13.1L8 12L10.9 10.9L12 8Z" fill="#E65642" stroke="#E65642" stroke-width="1.1" stroke-linejoin="round"/>
        </svg>
      </div>
      <div class="trigger-text">
        <strong>¿Tienes dudas sobre la FIME?</strong>
        <span>Pregunta a FimeBot sobre carreras, admisión y trámites</span>
      </div>
    </div>
    <span class="trigger-action">Abrir chat &rarr;</span>
  </button>
</div>

<script>
  function initFimeBot() {
    const card = document.getElementById("chat-card");
    const openCardBtn = document.getElementById("open-chat-card-btn");
    const closeChatBtn = document.getElementById("close-chat-btn");
    const toggleHeaderBtn = document.getElementById("toggle-chat-btn");
    const chatInput = document.getElementById("fimebot-textarea") as HTMLTextAreaElement;
    const sendBtn = document.getElementById("send-btn") as HTMLButtonElement;
    const chatbox = document.querySelector(".chatbox") as HTMLElement;
    const scrollContainer = document.querySelector(".chat-content") as HTMLElement;

    if (!card || !chatInput || !sendBtn || !chatbox || !scrollContainer) return;

    let isSending = false;
    const chatHistory: { role: string; content: string }[] = [];
    const inputInitHeight = 44;

    function setOpen(open: boolean, shouldFocus = false) {
      if (open) {
        card.classList.add("is-open");
        if (openCardBtn) openCardBtn.style.display = "none";
        if (shouldFocus) {
          setTimeout(() => chatInput.focus(), 150);
        }
      } else {
        card.classList.remove("is-open");
        if (openCardBtn && window.innerWidth <= 960) openCardBtn.style.display = "flex";
      }
    }

    // Configurar estado inicial según ancho de pantalla (sin autofocus involuntario)
    if (window.innerWidth <= 960) {
      if (window.location.hash === "#fimebot-chat") {
        setOpen(true, false);
      } else {
        setOpen(false, false);
      }
    } else {
      setOpen(true, false);
    }

    window.addEventListener("resize", () => {
      if (window.innerWidth > 960) {
        card.classList.add("is-open");
        if (openCardBtn) openCardBtn.style.display = "none";
      } else {
        if (!card.classList.contains("is-open") && openCardBtn) {
          openCardBtn.style.display = "flex";
        }
      }
    });

    if (openCardBtn) {
      openCardBtn.addEventListener("click", () => setOpen(true, true));
    }

    if (closeChatBtn) {
      closeChatBtn.addEventListener("click", () => setOpen(false));
    }

    if (toggleHeaderBtn) {
      toggleHeaderBtn.addEventListener("click", () => {
        const currentlyOpen = card.classList.contains("is-open");
        setOpen(!currentlyOpen);
        if (!currentlyOpen) {
          card.scrollIntoView({ behavior: "smooth", block: "center" });
        }
      });
    }

    // Escuchar hash navigation
    window.addEventListener("hashchange", () => {
      if (window.location.hash === "#fimebot-chat") {
        setOpen(true);
        card.scrollIntoView({ behavior: "smooth", block: "center" });
      }
    });

    function setSending(sending: boolean) {
      isSending = sending;
      chatInput.disabled = sending;
      sendBtn.disabled = sending;
      chatbox.setAttribute("aria-busy", String(sending));
      document.querySelectorAll("[data-question]").forEach((btn) => {
        (btn as HTMLButtonElement).disabled = sending;
      });
    }

    function appendInline(parent: HTMLElement, text: string) {
      const pattern = /\[([^\]]+)\]\(([^\s)]+)\)|\*\*([^*]+)\*\*/g;
      let cursor = 0;
      for (const match of text.matchAll(pattern)) {
        parent.append(document.createTextNode(text.slice(cursor, match.index)));
        if (match[3]) {
          const strong = document.createElement("strong");
          strong.textContent = match[3];
          parent.append(strong);
        } else if (match[1] && match[2]) {
          let safe = false;
          try {
            const url = new URL(match[2], window.location.origin);
            safe = (url.origin === window.location.origin && match[2].startsWith("/")) ||
              (url.protocol === "https:" && (url.hostname === "ucol.mx" || url.hostname.endsWith(".ucol.mx")));
          } catch { /* Ignorar URLs malformadas */ }

          if (safe) {
            const link = document.createElement("a");
            link.textContent = match[1];
            link.href = match[2];
            link.target = "_blank";
            link.rel = "noopener noreferrer";
            parent.append(link);
          } else {
            parent.append(document.createTextNode(match[1]));
          }
        }
        cursor = (match.index || 0) + match[0].length;
      }
      parent.append(document.createTextNode(text.slice(cursor)));
    }

    function renderMarkdown(element: HTMLElement, text: string) {
      const fragment = document.createDocumentFragment();
      let list: HTMLUListElement | null = null;
      for (const line of text.split("\n")) {
        const item = line.match(/^\s*(?:[-*]|\d+\.)\s+(.+)$/);
        if (item) {
          if (!list) {
            list = document.createElement("ul");
            fragment.append(list);
          }
          const li = document.createElement("li");
          appendInline(li, item[1]);
          list.append(li);
        } else {
          list = null;
          if (!line.trim()) continue;
          const paragraph = document.createElement("p");
          appendInline(paragraph, line.replace(/^#{1,6}\s+/, ""));
          fragment.append(paragraph);
        }
      }
      element.replaceChildren(fragment);
    }

    function createChatLi(message: string, className: string): HTMLLIElement {
      const li = document.createElement("li");
      li.classList.add("chat", className);

      if (className === "incoming") {
        const avatar = document.createElement("span");
        avatar.classList.add("chat-avatar");
        avatar.setAttribute("aria-hidden", "true");
        avatar.innerHTML = `<svg viewBox="0 0 24 24" width="18" height="18" fill="none"><path d="M4 12C4 7.58 7.58 4 12 4C16.42 4 20 7.58 20 12C20 16.42 16.42 20 12 20H5.5C4.67 20 4 19.33 4 18.5V12Z" fill="currentColor" fill-opacity="0.16" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round"/><path d="M12 8L13.1 10.9L16 12L13.1 13.1L12 16L10.9 13.1L8 12L10.9 10.9L12 8Z" fill="#E65642" stroke="#E65642" stroke-width="1.1" stroke-linejoin="round"/></svg>`;
        li.appendChild(avatar);
      }

      const bubble = document.createElement("div");
      bubble.classList.add("chat-bubble");
      if (message === "Pensando...") {
        bubble.classList.add("thinking-animation");
        bubble.textContent = message;
      } else {
        renderMarkdown(bubble, message);
      }
      li.appendChild(bubble);
      return li;
    }

    function scrollChat() {
      scrollContainer.scrollTop = scrollContainer.scrollHeight;
    }

    async function generateResponse(incomingLi: HTMLLIElement) {
      const bubble = incomingLi.querySelector(".chat-bubble") as HTMLElement;
      let botMessage = "";
      const controller = new AbortController();
      const timeout = setTimeout(() => controller.abort(), 20000);

      try {
        const res = await fetch("/api/chat", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ messages: chatHistory }),
          signal: controller.signal,
        });

        if (!res.ok) {
          throw new Error(
            res.status === 429
              ? "Has enviado demasiadas consultas. Espera un minuto e intenta de nuevo."
              : `Error del servidor (${res.status}). Intenta de nuevo más tarde.`
          );
        }

        bubble.classList.remove("thinking-animation");
        bubble.textContent = "";

        const contentType = res.headers.get("content-type") || "";
        if (contentType.includes("text/event-stream") && res.body) {
          const reader = res.body.getReader();
          const decoder = new TextDecoder("utf-8");
          let buffer = "";

          while (true) {
            const { done, value } = await reader.read();
            if (done) break;
            buffer += decoder.decode(value, { stream: true });
            const lines = buffer.split("\n");
            buffer = lines.pop() || "";

            for (const line of lines) {
              const trimmed = line.trim();
              if (!trimmed || !trimmed.startsWith("data:")) continue;
              const dataStr = trimmed.replace(/^data:\s*/, "");
              if (dataStr === "[DONE]") break;
              try {
                const parsed = JSON.parse(dataStr);
                const delta = parsed?.choices?.[0]?.delta?.content || "";
                if (delta) {
                  botMessage += delta;
                  renderMarkdown(bubble, botMessage);
                  scrollChat();
                }
              } catch { /* Ignorar trozos parciales */ }
            }
          }
        } else {
          const data = await res.json();
          botMessage = data?.message?.content || "No hay una respuesta disponible.";
          renderMarkdown(bubble, botMessage);
        }

        chatHistory.push({ role: "assistant", content: botMessage });
        if (chatHistory.length > 12) chatHistory.splice(0, chatHistory.length - 12);
      } catch (err: any) {
        if (chatHistory.at(-1)?.role === "user") chatHistory.pop();
        bubble.classList.remove("thinking-animation");
        bubble.textContent =
          err.name === "AbortError"
            ? "La consulta tardó demasiado. Intenta de nuevo."
            : err instanceof TypeError
            ? "No hay conexión con el servidor de FimeBot. Revisa tu conexión e intenta de nuevo."
            : err.message;
        bubble.classList.add("error");
      } finally {
        clearTimeout(timeout);
        setSending(false);
        chatInput.focus();
        scrollChat();
      }
    }

    function handleChat() {
      if (isSending) return;
      const userMessage = chatInput.value.trim().slice(0, 1200);
      if (!userMessage) return;

      setSending(true);
      chatInput.value = "";
      chatInput.style.height = `${inputInitHeight}px`;

      chatHistory.push({ role: "user", content: userMessage });
      const outgoingLi = createChatLi(userMessage, "outgoing");
      chatbox.appendChild(outgoingLi);
      scrollChat();

      setTimeout(() => {
        const incomingLi = createChatLi("Pensando...", "incoming");
        chatbox.appendChild(incomingLi);
        scrollChat();
        generateResponse(incomingLi);
      }, 100);
    }

    chatInput.addEventListener("input", () => {
      chatInput.style.height = `${inputInitHeight}px`;
      chatInput.style.height = `${Math.min(chatInput.scrollHeight, 120)}px`;
    });

    chatInput.addEventListener("keydown", (e) => {
      if (e.key === "Enter" && !e.shiftKey && window.innerWidth > 768) {
        e.preventDefault();
        handleChat();
      }
    });

    sendBtn.addEventListener("click", handleChat);

    document.querySelectorAll("[data-question]").forEach((button) => {
      button.addEventListener("click", () => {
        if (isSending) return;
        const q = (button as HTMLElement).dataset.question;
        if (q) {
          chatInput.value = q;
          handleChat();
        }
      });
    });
  }

  initFimeBot();
  document.addEventListener("astro:page-load", initFimeBot);
</script>

<style>
  .fimebot-wrapper {
    position: relative;
    width: 100%;
    outline: none;
  }

  .chat-card {
    border-radius: var(--sara-radius-lg, 16px);
    background: var(--sara-glass-strong, rgba(255, 255, 255, 0.92));
    backdrop-filter: blur(25px);
    -webkit-backdrop-filter: blur(25px);
    border: 1px solid var(--sara-border-glass, rgba(26, 54, 122, 0.12));
    box-shadow: inset 0 1px 1px 0 var(--sara-rim-specular, rgba(255, 255, 255, 0.8)), var(--sara-shadow-glass-md, 0 8px 32px rgba(10, 19, 41, 0.08));
    display: flex;
    flex-direction: column;
    height: 100%;
    min-height: 480px;
    max-height: 600px;
    overflow: hidden;
  }

  .chat-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16px 20px;
    border-bottom: 1px solid var(--sara-border-subtle, rgba(26, 54, 122, 0.08));
    background: var(--sara-glass-dock, rgba(255, 255, 255, 0.7));
  }

  .chat-header__info {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .chat-header__avatar {
    width: 38px;
    height: 38px;
    border-radius: var(--sara-radius-md, 12px);
    background: var(--sara-sapphire-100, #E0EBFF);
    display: grid;
    place-items: center;
    color: var(--sara-sapphire-700, #1A367A);
    border: 1px solid var(--sara-border-glass, rgba(26, 54, 122, 0.1));
  }

  .chat-header__overline {
    font-family: var(--font-mono, monospace);
    font-size: 0.5625rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    color: var(--sara-sapphire-600, #224FA8);
    display: block;
  }

  .chat-header__title {
    font-family: var(--font-display, "Manrope", sans-serif);
    font-size: 1.125rem;
    font-weight: 800;
    color: var(--sara-sapphire-950, #0A1329);
    margin: 0;
    line-height: 1.1;
  }

  .chat-header__actions {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .status-indicator {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.6875rem;
    font-weight: 700;
    color: var(--sara-udec-green, #0E6B47);
    background: rgba(14, 107, 71, 0.08);
    border-radius: var(--sara-radius-pill, 9999px);
    padding: 3px 8px;
  }

  .status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--sara-udec-green, #0E6B47);
    box-shadow: 0 0 0 2px rgba(14, 107, 71, 0.2);
  }

  .btn-close-chat {
    display: none;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--sara-sapphire-50, #F2F6FF);
    border: 1px solid var(--sara-border-glass);
    color: var(--sara-text-secondary);
    cursor: pointer;
    place-items: center;
  }

  .btn-close-chat:hover {
    color: var(--sara-coral-600, #E65642);
    background: #FFFFFF;
  }

  .chat-content {
    flex: 1;
    overflow-y: auto;
    padding: 16px 20px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    background: rgba(255, 255, 255, 0.4);
  }

  .chatbox {
    display: flex;
    flex-direction: column;
    gap: 14px;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  :global(.chat) {
    display: flex;
    gap: 10px;
    max-width: 88%;
  }

  :global(.chat.incoming) {
    align-self: flex-start;
  }

  :global(.chat.outgoing) {
    align-self: flex-end;
    flex-direction: row-reverse;
  }

  :global(.chat-avatar) {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--sara-sapphire-50, #F2F6FF);
    display: grid;
    place-items: center;
    flex-shrink: 0;
    border: 1px solid var(--sara-border-glass);
    color: var(--sara-sapphire-600);
  }

  :global(.chat-bubble) {
    padding: 12px 16px;
    border-radius: 14px;
    font-size: 0.875rem;
    line-height: 1.5;
  }

  :global(.chat.incoming .chat-bubble) {
    background: #FFFFFF;
    color: var(--sara-text-primary, #141824);
    border: 1px solid var(--sara-border-glass, rgba(26, 54, 122, 0.1));
    border-top-left-radius: 4px;
    box-shadow: 0 2px 8px rgba(10, 19, 41, 0.04);
  }

  :global(.chat.incoming .chat-bubble strong) {
    color: var(--sara-sapphire-700, #1A367A);
  }

  :global(.chat.incoming .chat-bubble a) {
    color: var(--sara-sapphire-600, #224FA8);
    text-decoration: underline;
    font-weight: 600;
  }

  :global(.chat.outgoing .chat-bubble) {
    background: linear-gradient(135deg, var(--sara-sapphire-700, #1A367A) 0%, var(--sara-sapphire-600, #224FA8) 100%);
    color: #FFFFFF;
    border-top-right-radius: 4px;
    box-shadow: 0 4px 12px rgba(26, 54, 122, 0.2);
  }

  :global(.chat-bubble.thinking-animation) {
    color: var(--sara-text-secondary);
    font-style: italic;
  }

  :global(.chat-bubble.error) {
    background: #FFF1F2;
    border-color: #FECDD3;
    color: #9F1239;
  }

  .chat-suggestions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding: 10px 20px;
    border-top: 1px solid var(--sara-border-subtle);
    background: var(--sara-glass-base);
  }

  .chip {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--sara-sapphire-700, #1A367A);
    background: var(--color-surface, #FFFFFF);
    border: 1px solid var(--sara-border-glass, rgba(26, 54, 122, 0.12));
    border-radius: var(--sara-radius-pill, 9999px);
    padding: 5px 12px;
    cursor: pointer;
    transition: all 150ms ease;
  }

  .chip:hover {
    background: var(--sara-cyan-50, #E8F8FA);
    border-color: var(--sara-cyan-400, #3EDBF0);
    color: var(--sara-cyan-700, #0E778B);
  }

  .chat-input-row {
    display: flex;
    align-items: flex-end;
    gap: 10px;
    padding: 12px 20px;
    border-top: 1px solid var(--sara-border-subtle);
    background: var(--color-surface, #FFFFFF);
  }

  #fimebot-textarea {
    flex: 1;
    border: 1px solid var(--sara-border-glass, rgba(26, 54, 122, 0.15));
    border-radius: var(--sara-radius-md, 12px);
    padding: 10px 14px;
    font-family: inherit;
    font-size: 0.875rem;
    resize: none;
    line-height: 1.4;
    outline: none;
    background: var(--sara-sapphire-50, #F8FAFF);
    color: var(--sara-text-primary);
    transition: border-color 150ms ease, background 150ms ease;
    min-height: 44px;
  }

  #fimebot-textarea:focus {
    border-color: var(--sara-cyan-500, #1CB3CF);
    background: #FFFFFF;
    box-shadow: 0 0 0 3px rgba(21, 154, 179, 0.12);
  }

  .btn-send {
    width: 44px;
    height: 44px;
